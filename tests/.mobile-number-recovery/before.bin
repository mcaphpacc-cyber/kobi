:{s:2:"id";i:1355;s:10:"disease_id";i:309;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:31:"Through psychiatric evaluation.";s:11:"question_hi";s:49:"निदान कैसे होता है?";s:9:"answer_hi";s:89:"मनोचिकित्सकीय मूल्यांकन द्वारा।";s:10:"sort_order";i:5;}i:1355;a:7:{s:2:"id";i:1356;s:10:"disease_id";i:310;s:11:"question_en";s:30:"What is acute stress disorder?";s:9:"answer_en";s:32:"A short-term reaction to trauma.";s:11:"question_hi";s:86:"एक्यूट स्ट्रेस डिसऑर्डर क्या है?";s:9:"answer_hi";s:120:"आघात के बाद होने वाली अल्पकालिक प्रतिक्रिया।";s:10:"sort_order";i:1;}i:1356;a:7:{s:2:"id";i:1357;s:10:"disease_id";i:310;s:11:"question_en";s:15:"What causes it?";s:9:"answer_en";s:30:"Exposure to a traumatic event.";s:11:"question_hi";s:43:"यह क्यों होता है?";s:9:"answer_hi";s:63:"आघातपूर्ण घटना के कारण।";s:10:"sort_order";i:2;}i:1357;a:7:{s:2:"id";i:1358;s:10:"disease_id";i:310;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:42:"Anxiety, distress, and emotional numbness.";s:11:"question_hi";s:61:"सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:89:"चिंता, तनाव और भावनात्मक सुन्नता।";s:10:"sort_order";i:3;}i:1358;a:7:{s:2:"id";i:1359;s:10:"disease_id";i:310;s:11:"question_en";s:20:"Can it lead to PTSD?";s:9:"answer_en";s:32:"Some cases may progress to PTSD.";s:11:"question_hi";s:52:"क्या यह PTSD बन सकता है?";s:9:"answer_hi";s:92:"कुछ मामलों में PTSD विकसित हो सकता है।";s:10:"sort_order";i:4;}i:1359;a:7:{s:2:"id";i:1360;s:10:"disease_id";i:310;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:28:"Through clinical assessment.";s:11:"question_hi";s:49:"निदान कैसे होता है?";s:9:"answer_hi";s:80:"चिकित्सकीय मूल्यांकन द्वारा।";s:10:"sort_order";i:5;}i:1360;a:7:{s:2:"id";i:1361;s:10:"disease_id";i:311;s:11:"question_en";s:25:"What is bipolar disorder?";s:9:"answer_en";s:60:"A disorder causing mood swings between depression and mania.";s:11:"question_hi";s:67:"बाइपोलर डिसऑर्डर क्या है?";s:9:"answer_hi";s:116:"अवसाद और उन्माद के बीच मूड ब