) ENGINE=InnoDB AUTO_INCREMENT=2131 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci";s:7:"columns";a:7:{i:0;a:9:{s:5:"Field";s:2:"id";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:3:"PRI";s:7:"Default";N;s:5:"Extra";s:14:"auto_increment";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:1;a:9:{s:5:"Field";s:10:"disease_id";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:3:"MUL";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:2;a:9:{s:5:"Field";s:11:"question_en";s:4:"Type";s:12:"varchar(500)";s:9:"Collation";s:18:"utf8mb4_general_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:3;a:9:{s:5:"Field";s:9:"answer_en";s:4:"Type";s:4:"text";s:9:"Collation";s:18:"utf8mb4_general_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:4;a:9:{s:5:"Field";s:11:"question_hi";s:4:"Type";s:12:"varchar(500)";s:9:"Collation";s:18:"utf8mb4_general_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:5;a:9:{s:5:"Field";s:9:"answer_hi";s:4:"Type";s:4:"text";s:9:"Collation";s:18:"utf8mb4_general_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:6;a:9:{s:5:"Field";s:10:"sort_order";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";s:1:"0";s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}}s:4:"rows";a:2130:{i:0;a:7:{s:2:"id";i:1;s:10:"disease_id";i:362;s:11:"question_en";s:32:"Can Type 2 Diabetes be reversed?";s:9:"answer_en";s:136:"Some individuals may achieve remission through significant weight loss, dietary changes, and regular exercise under medical supervision.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:1;a:7:{s:2:"id";i:2;s:10:"disease_id";i:362;s:11:"question_en";s:37:"Is insulin required for all patients?";s:9:"answer_en";s:129:"No. Many people manage Type 2 Diabetes with lifestyle changes and oral medications, although some may eventually require insulin.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:2;a:7:{s:2:"id";i:3;s:10:"disease_id";i:362;s:11:"question_en";s:31:"What is the normal HbA1c level?";s:9:"answer_en";s:102:"For most people without diabetes, HbA1c is below 5.7 percent. Your doctor can advise specific targets.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:3;a:7:{s:2:"id";i:4;s:10:"disease_id";i:362;s:11:"question_en";s:32:"Can diabetes damage the kidneys?";s:9:"answer_en";s:96:"Yes. Poorly controlled diabetes can lead to diabetic kidney disease and eventual kidney failure.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:4;a:7:{s:2:"id";i:5;s:10:"disease_id";i:362;s:11:"question_en";s:30:"Which foods should be avoided?";s:9:"answer_en";s:112:"Sugary drinks, excessive sweets, refined carbohydrates, and heavily processed foods should generally be limited.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:5;a:7:{s:2:"id";i:6;s:10:"disease_id";i:81;s:11:"question_en";s:41:"What is considered normal blood pressure?";s:9:"answer_en";s:81:"For most adults, blood pressure below 120/80 mmHg is generally considered normal.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:6;a:7:{s:2:"id";i:7;s:10:"disease_id";i:81;s:11:"question_en";s:38:"Can hypertension be cured permanently?";s:9:"answer_en";s:136:"Many people can successfully control blood pressure through lifestyle changes and medications, but ongoing monitoring is often required.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:7;a:7:{s:2:"id";i:8;s:10:"disease_id";i:81;s:11:"question_en";s:40:"Does high blood pressure cause symptoms?";s:9:"answer_en";s:97:"Often it causes no symptoms. Some people may experience headaches, dizziness, or vision problems.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:8;a:7:{s:2:"id";i:9;s:10:"disease_id";i:81;s:11:"question_en";s:45:"Why is hypertension called the silent killer?";s:9:"answer_en";s:75:"Because it can damage organs for years without causing noticeable symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:9;a:7:{s:2:"id";i:10;s:10:"disease_id";i:81;s:11:"question_en";s:39:"Can exercise help lower blood pressure?";s:9:"answer_en";s:102:"Yes. Regular physical activity is one of the most effective non-drug methods to reduce blood pressure.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:10;a:7:{s:2:"id";i:11;s:10:"disease_id";i:181;s:11:"question_en";s:30:"Can PCOS be cured permanently?";s:9:"answer_en";s:133:"PCOS is usually a long-term condition, but symptoms can often be effectively managed through lifestyle changes and medical treatment.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:11;a:7:{s:2:"id";i:12;s:10:"disease_id";i:181;s:11:"question_en";s:27:"Can PCOS cause infertility?";s:9:"answer_en";s:110:"Yes. PCOS can affect ovulation and fertility, but many women successfully conceive with appropriate treatment.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:12;a:7:{s:2:"id";i:13;s:10:"disease_id";i:181;s:11:"question_en";s:30:"Is weight gain common in PCOS?";s:9:"answer_en";s:98:"Yes. Many women with PCOS experience weight gain due to insulin resistance and hormonal imbalance.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:13;a:7:{s:2:"id";i:14;s:10:"disease_id";i:181;s:11:"question_en";s:23:"Can exercise help PCOS?";s:9:"answer_en";s:112:"Regular exercise can improve insulin sensitivity, support weight management, and help regulate menstrual cycles.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:14;a:7:{s:2:"id";i:15;s:10:"disease_id";i:181;s:11:"question_en";s:46:"Does every woman with PCOS have ovarian cysts?";s:9:"answer_en";s:123:"No. Some women may have PCOS without visible ovarian cysts, while others may have cysts without meeting full PCOS criteria.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:15;a:7:{s:2:"id";i:16;s:10:"disease_id";i:106;s:11:"question_en";s:28:"Can fatty liver be reversed?";s:9:"answer_en";s:137:"In many cases, especially in early stages, fatty liver can improve significantly through weight loss, healthy diet, and regular exercise.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:16;a:7:{s:2:"id";i:17;s:10:"disease_id";i:106;s:11:"question_en";s:25:"Is fatty liver dangerous?";s:9:"answer_en";s:94:"It can become serious if it progresses to inflammation, fibrosis, cirrhosis, or liver failure.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:17;a:7:{s:2:"id";i:18;s:10:"disease_id";i:106;s:11:"question_en";s:38:"Can fatty liver occur without alcohol?";s:9:"answer_en";s:108:"Yes. NAFLD occurs in people who consume little or no alcohol and is strongly linked to obesity and diabetes.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:18;a:7:{s:2:"id";i:19;s:10:"disease_id";i:106;s:11:"question_en";s:30:"Which foods should be avoided?";s:9:"answer_en";s:119:"Sugary beverages, processed foods, excessive sweets, alcohol, and foods high in trans fats should generally be limited.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:19;a:7:{s:2:"id";i:20;s:10:"disease_id";i:106;s:11:"question_en";s:35:"How much weight loss is beneficial?";s:9:"answer_en";s:106:"Even a 5-10 percent reduction in body weight may significantly improve liver fat and overall liver health.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:20;a:7:{s:2:"id";i:21;s:10:"disease_id";i:142;s:11:"question_en";s:33:"Can kidney stones pass naturally?";s:9:"answer_en";s:109:"Small stones often pass naturally with adequate hydration, while larger stones may require medical treatment.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:21;a:7:{s:2:"id";i:22;s:10:"disease_id";i:142;s:11:"question_en";s:30:"How much water should I drink?";s:9:"answer_en";s:127:"Many patients are advised to drink enough fluids to produce at least 2 to 2.5 liters of urine daily, but individual needs vary.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:22;a:7:{s:2:"id";i:23;s:10:"disease_id";i:142;s:11:"question_en";s:26:"Are kidney stones painful?";s:9:"answer_en";s:91:"Yes. Kidney stones can cause severe pain, especially when moving through the urinary tract.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:23;a:7:{s:2:"id";i:24;s:10:"disease_id";i:142;s:11:"question_en";s:28:"Can kidney stones come back?";s:9:"answer_en";s:79:"Yes. Recurrence is common, which is why prevention and follow-up are important.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:24;a:7:{s:2:"id";i:25;s:10:"disease_id";i:142;s:11:"question_en";s:32:"Which foods increase stone risk?";s:9:"answer_en";s:107:"Excessive salt, sugary drinks, and certain high-oxalate foods may increase risk in susceptible individuals.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:25;a:7:{s:2:"id";i:26;s:10:"disease_id";i:1;s:11:"question_en";s:64:"What is the difference between a migraine and a normal headache?";s:9:"answer_en";s:124:"Migraines are usually more severe and often involve symptoms such as nausea, sensitivity to light, and sensitivity to sound.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:26;a:7:{s:2:"id";i:27;s:10:"disease_id";i:1;s:11:"question_en";s:34:"Can migraine be cured permanently?";s:9:"answer_en";s:126:"There is no guaranteed permanent cure, but many people successfully control migraines through treatment and lifestyle changes.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:27;a:7:{s:2:"id";i:28;s:10:"disease_id";i:1;s:11:"question_en";s:34:"What are common migraine triggers?";s:9:"answer_en";s:116:"Stress, lack of sleep, dehydration, hormonal changes, alcohol, bright lights, and certain foods are common triggers.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:28;a:7:{s:2:"id";i:29;s:10:"disease_id";i:1;s:11:"question_en";s:23:"Is migraine hereditary?";s:9:"answer_en";s:101:"Yes. A family history of migraine significantly increases the likelihood of developing the condition.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:29;a:7:{s:2:"id";i:30;s:10:"disease_id";i:1;s:11:"question_en";s:44:"When should I seek urgent medical attention?";s:9:"answer_en";s:128:"Seek immediate medical attention for sudden severe headache, weakness, confusion, vision loss, or symptoms suggestive of stroke.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:30;a:7:{s:2:"id";i:31;s:10:"disease_id";i:67;s:11:"question_en";s:32:"Can asthma be cured permanently?";s:9:"answer_en";s:133:"Asthma is usually a chronic condition, but symptoms can often be controlled effectively with proper treatment and trigger management.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:31;a:7:{s:2:"id";i:32;s:10:"disease_id";i:67;s:11:"question_en";s:29:"What triggers asthma attacks?";s:9:"answer_en";s:118:"Common triggers include dust, pollen, smoke, respiratory infections, cold air, exercise, and environmental pollutants.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:32;a:7:{s:2:"id";i:33;s:10:"disease_id";i:67;s:11:"question_en";s:36:"Are inhalers safe for long-term use?";s:9:"answer_en";s:93:"When used as prescribed, inhalers are generally safe and are a key part of asthma management.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:33;a:7:{s:2:"id";i:34;s:10:"disease_id";i:67;s:11:"question_en";s:27:"Can exercise worsen asthma?";s:9:"answer_en";s:133:"Exercise can trigger symptoms in some people, but with proper treatment many individuals can safely participate in physical activity.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:34;a:7:{s:2:"id";i:35;s:10:"disease_id";i:67;s:11:"question_en";s:45:"When should emergency medical help be sought?";s:9:"answer_en";s:144:"Seek immediate medical attention for severe breathing difficulty, inability to speak normally, blue lips, or poor response to rescue medication.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:35;a:7:{s:2:"id";i:36;s:10:"disease_id";i:101;s:11:"question_en";s:40:"What is the most common symptom of GERD?";s:9:"answer_en";s:68:"Heartburn and acid regurgitation are among the most common symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:36;a:7:{s:2:"id";i:37;s:10:"disease_id";i:101;s:11:"question_en";s:30:"Can GERD damage the esophagus?";s:9:"answer_en";s:95:"Yes. Chronic acid exposure can cause inflammation, ulcers, strictures, and Barrett's esophagus.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:37;a:7:{s:2:"id";i:38;s:10:"disease_id";i:101;s:11:"question_en";s:32:"Does obesity increase GERD risk?";s:9:"answer_en";s:83:"Yes. Excess abdominal weight increases pressure on the stomach and promotes reflux.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:38;a:7:{s:2:"id";i:39;s:10:"disease_id";i:101;s:11:"question_en";s:27:"Should I avoid spicy foods?";s:9:"answer_en";s:86:"Many people find that spicy foods worsen symptoms, though triggers vary by individual.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:39;a:7:{s:2:"id";i:40;s:10:"disease_id";i:101;s:11:"question_en";s:34:"When should I seek medical advice?";s:9:"answer_en";s:127:"Seek medical evaluation for persistent symptoms, difficulty swallowing, unexplained weight loss, or recurrent chest discomfort.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:40;a:7:{s:2:"id";i:41;s:10:"disease_id";i:236;s:11:"question_en";s:39:"Can osteoarthritis be cured completely?";s:9:"answer_en";s:120:"There is currently no complete cure, but symptoms can often be managed effectively with treatment and lifestyle changes.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:41;a:7:{s:2:"id";i:42;s:10:"disease_id";i:236;s:11:"question_en";s:40:"Which joints are most commonly affected?";s:9:"answer_en";s:84:"The knees, hips, hands, feet, and spine are among the most commonly affected joints.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:42;a:7:{s:2:"id";i:43;s:10:"disease_id";i:236;s:11:"question_en";s:37:"Does weight loss help osteoarthritis?";s:9:"answer_en";s:99:"Yes. Reducing excess body weight can decrease stress on weight-bearing joints and improve symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:43;a:7:{s:2:"id";i:44;s:10:"disease_id";i:236;s:11:"question_en";s:36:"Is exercise safe for osteoarthritis?";s:9:"answer_en";s:98:"Appropriate exercise is generally recommended and may improve flexibility, strength, and function.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:44;a:7:{s:2:"id";i:45;s:10:"disease_id";i:236;s:11:"question_en";s:27:"When is surgery considered?";s:9:"answer_en";s:96:"Surgery may be considered when pain and disability remain severe despite conservative treatment.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:45;a:7:{s:2:"id";i:46;s:10:"disease_id";i:301;s:11:"question_en";s:39:"What are common symptoms of depression?";s:9:"answer_en";s:156:"Persistent sadness, loss of interest, fatigue, sleep problems, appetite changes, feelings of hopelessness, and difficulty concentrating are common symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:46;a:7:{s:2:"id";i:47;s:10:"disease_id";i:301;s:11:"question_en";s:39:"Can depression be treated successfully?";s:9:"answer_en";s:115:"Yes. Many people improve significantly with appropriate therapy, medication, lifestyle changes, and social support.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:47;a:7:{s:2:"id";i:48;s:10:"disease_id";i:301;s:11:"question_en";s:41:"Is depression the same as normal sadness?";s:9:"answer_en";s:127:"No. Depression is a medical condition that is typically more severe, longer lasting, and more disruptive than ordinary sadness.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:48;a:7:{s:2:"id";i:49;s:10:"disease_id";i:301;s:11:"question_en";s:29:"Can exercise help depression?";s:9:"answer_en";s:110:"Regular physical activity may improve mood and is often recommended as part of a comprehensive treatment plan.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:49;a:7:{s:2:"id";i:50;s:10:"disease_id";i:301;s:11:"question_en";s:40:"When should professional help be sought?";s:9:"answer_en";s:134:"Professional help should be sought when symptoms persist, interfere with daily life, or if there are thoughts of self-harm or suicide.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:50;a:7:{s:2:"id";i:51;s:10:"disease_id";i:91;s:11:"question_en";s:15:"What is anemia?";s:9:"answer_en";s:91:"Anemia is a condition in which the body lacks enough healthy red blood cells or hemoglobin.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:51;a:7:{s:2:"id";i:52;s:10:"disease_id";i:91;s:11:"question_en";s:40:"What is the most common cause of anemia?";s:9:"answer_en";s:59:"Iron deficiency is one of the most common causes worldwide.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:52;a:7:{s:2:"id";i:53;s:10:"disease_id";i:91;s:11:"question_en";s:27:"Can anemia cause dizziness?";s:9:"answer_en";s:75:"Yes. Reduced oxygen delivery to tissues can lead to dizziness and weakness.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:53;a:7:{s:2:"id";i:54;s:10:"disease_id";i:91;s:11:"question_en";s:20:"Can anemia be cured?";s:9:"answer_en";s:89:"Many forms of anemia can be successfully treated when the underlying cause is identified.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:54;a:7:{s:2:"id";i:55;s:10:"disease_id";i:91;s:11:"question_en";s:24:"Which foods help anemia?";s:9:"answer_en";s:96:"Iron-rich foods, leafy vegetables, legumes, meat, fish, eggs, and vitamin C rich foods may help.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:55;a:7:{s:2:"id";i:56;s:10:"disease_id";i:92;s:11:"question_en";s:31:"What is iron deficiency anemia?";s:9:"answer_en";s:74:"It is anemia caused by insufficient iron needed for hemoglobin production.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:56;a:7:{s:2:"id";i:57;s:10:"disease_id";i:92;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:96:"Fatigue, weakness, pale skin, dizziness, headaches, and shortness of breath are common symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:57;a:7:{s:2:"id";i:58;s:10:"disease_id";i:92;s:11:"question_en";s:36:"Can iron deficiency anemia be cured?";s:9:"answer_en";s:86:"Most cases improve when iron deficiency and its underlying cause are properly treated.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:58;a:7:{s:2:"id";i:59;s:10:"disease_id";i:92;s:11:"question_en";s:29:"Which foods are rich in iron?";s:9:"answer_en";s:89:"Red meat, liver, beans, lentils, spinach, and fortified cereals are rich sources of iron.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:59;a:7:{s:2:"id";i:60;s:10:"disease_id";i:92;s:11:"question_en";s:27:"Why is vitamin C important?";s:9:"answer_en";s:66:"Vitamin C helps improve iron absorption from food and supplements.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:60;a:7:{s:2:"id";i:61;s:10:"disease_id";i:117;s:11:"question_en";s:12:"What is IBS?";s:9:"answer_en";s:84:"IBS is a functional digestive disorder affecting bowel habits and abdominal comfort.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:61;a:7:{s:2:"id";i:62;s:10:"disease_id";i:117;s:11:"question_en";s:17:"Is IBS dangerous?";s:9:"answer_en";s:81:"IBS is generally not life-threatening and does not usually damage the intestines.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:62;a:7:{s:2:"id";i:63;s:10:"disease_id";i:117;s:11:"question_en";s:22:"Can stress worsen IBS?";s:9:"answer_en";s:63:"Yes. Stress is one of the most common triggers of IBS symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:63;a:7:{s:2:"id";i:64;s:10:"disease_id";i:117;s:11:"question_en";s:23:"What foods trigger IBS?";s:9:"answer_en";s:109:"Trigger foods vary but may include fatty foods, spicy foods, caffeine, and certain fermentable carbohydrates.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:64;a:7:{s:2:"id";i:65;s:10:"disease_id";i:117;s:11:"question_en";s:17:"Can IBS be cured?";s:9:"answer_en";s:77:"There is no permanent cure, but symptoms can often be controlled effectively.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:65;a:7:{s:2:"id";i:66;s:10:"disease_id";i:143;s:11:"question_en";s:31:"What is Chronic Kidney Disease?";s:9:"answer_en";s:70:"CKD is a condition where kidney function gradually declines over time.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:66;a:7:{s:2:"id";i:67;s:10:"disease_id";i:143;s:11:"question_en";s:17:"Can CKD be cured?";s:9:"answer_en";s:75:"Kidney damage is often permanent, but progression can frequently be slowed.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:67;a:7:{s:2:"id";i:68;s:10:"disease_id";i:143;s:11:"question_en";s:31:"What are early symptoms of CKD?";s:9:"answer_en";s:102:"Many patients have no symptoms initially. Fatigue, swelling, and changes in urination may occur later.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:68;a:7:{s:2:"id";i:69;s:10:"disease_id";i:143;s:11:"question_en";s:23:"Can diabetes cause CKD?";s:9:"answer_en";s:79:"Yes. Diabetes is one of the leading causes of chronic kidney disease worldwide.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:69;a:7:{s:2:"id";i:70;s:10:"disease_id";i:143;s:11:"question_en";s:24:"When is dialysis needed?";s:9:"answer_en";s:71:"Dialysis may be required when kidney function becomes severely reduced.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:70;a:7:{s:2:"id";i:71;s:10:"disease_id";i:200;s:11:"question_en";s:22:"What is breast cancer?";s:9:"answer_en";s:76:"Breast cancer is the uncontrolled growth of abnormal cells in breast tissue.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:71;a:7:{s:2:"id";i:72;s:10:"disease_id";i:200;s:11:"question_en";s:26:"Can men get breast cancer?";s:9:"answer_en";s:63:"Yes. Although much less common, breast cancer can occur in men.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:72;a:7:{s:2:"id";i:73;s:10:"disease_id";i:200;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:90:"A breast lump, nipple changes, breast pain, skin changes, or abnormal discharge may occur.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:73;a:7:{s:2:"id";i:74;s:10:"disease_id";i:200;s:11:"question_en";s:31:"How is breast cancer diagnosed?";s:9:"answer_en";s:55:"Diagnosis commonly involves imaging tests and a biopsy.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:74;a:7:{s:2:"id";i:75;s:10:"disease_id";i:200;s:11:"question_en";s:42:"Can breast cancer be treated successfully?";s:9:"answer_en";s:69:"Many patients achieve good outcomes when diagnosed and treated early.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:75;a:7:{s:2:"id";i:76;s:10:"disease_id";i:200;s:11:"question_en";s:22:"What is breast cancer?";s:9:"answer_en";s:76:"Breast cancer is the uncontrolled growth of abnormal cells in breast tissue.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:76;a:7:{s:2:"id";i:77;s:10:"disease_id";i:200;s:11:"question_en";s:26:"Can men get breast cancer?";s:9:"answer_en";s:63:"Yes. Although much less common, breast cancer can occur in men.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:77;a:7:{s:2:"id";i:78;s:10:"disease_id";i:200;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:90:"A breast lump, nipple changes, breast pain, skin changes, or abnormal discharge may occur.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:78;a:7:{s:2:"id";i:79;s:10:"disease_id";i:200;s:11:"question_en";s:31:"How is breast cancer diagnosed?";s:9:"answer_en";s:55:"Diagnosis commonly involves imaging tests and a biopsy.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:79;a:7:{s:2:"id";i:80;s:10:"disease_id";i:200;s:11:"question_en";s:42:"Can breast cancer be treated successfully?";s:9:"answer_en";s:69:"Many patients achieve good outcomes when diagnosed and treated early.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:80;a:7:{s:2:"id";i:81;s:10:"disease_id";i:304;s:11:"question_en";s:37:"What is Generalized Anxiety Disorder?";s:9:"answer_en";s:86:"GAD is a condition involving excessive and persistent worry about everyday situations.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:81;a:7:{s:2:"id";i:82;s:10:"disease_id";i:304;s:11:"question_en";s:32:"What are common symptoms of GAD?";s:9:"answer_en";s:114:"Symptoms may include excessive worry, restlessness, fatigue, irritability, poor concentration, and sleep problems.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:82;a:7:{s:2:"id";i:83;s:10:"disease_id";i:304;s:11:"question_en";s:19:"Can GAD be treated?";s:9:"answer_en";s:84:"Yes. Therapy, lifestyle changes, and medications can significantly improve symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:83;a:7:{s:2:"id";i:84;s:10:"disease_id";i:304;s:11:"question_en";s:28:"Is GAD a lifelong condition?";s:9:"answer_en";s:82:"Some people experience long-term symptoms, but many improve with proper treatment.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:84;a:7:{s:2:"id";i:85;s:10:"disease_id";i:304;s:11:"question_en";s:22:"Can stress worsen GAD?";s:9:"answer_en";s:78:"Yes. Stress is one of the most common triggers for worsening anxiety symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:85;a:7:{s:2:"id";i:86;s:10:"disease_id";i:361;s:11:"question_en";s:24:"What is Type 1 Diabetes?";s:9:"answer_en";s:90:"Type 1 Diabetes is an autoimmune disease where the pancreas produces little or no insulin.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:86;a:7:{s:2:"id";i:87;s:10:"disease_id";i:361;s:11:"question_en";s:29:"Can Type 1 Diabetes be cured?";s:9:"answer_en";s:83:"Currently there is no cure, but it can be effectively managed with insulin therapy.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:87;a:7:{s:2:"id";i:88;s:10:"disease_id";i:361;s:11:"question_en";s:29:"Is insulin required for life?";s:9:"answer_en";s:73:"Yes. Most people with Type 1 Diabetes require lifelong insulin treatment.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:88;a:7:{s:2:"id";i:89;s:10:"disease_id";i:361;s:11:"question_en";s:37:"Can children develop Type 1 Diabetes?";s:9:"answer_en";s:59:"Yes. It commonly develops during childhood and adolescence.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:89;a:7:{s:2:"id";i:90;s:10:"disease_id";i:361;s:11:"question_en";s:29:"What complications can occur?";s:9:"answer_en";s:113:"Complications may affect the eyes, kidneys, nerves, heart, and blood vessels if blood sugar is poorly controlled.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:90;a:7:{s:2:"id";i:91;s:10:"disease_id";i:59;s:11:"question_en";s:23:"What is hypothyroidism?";s:9:"answer_en";s:81:"It is a condition where the thyroid gland produces insufficient thyroid hormones.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:91;a:7:{s:2:"id";i:92;s:10:"disease_id";i:59;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:87:"Fatigue, weight gain, constipation, dry skin, and cold intolerance are common symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:92;a:7:{s:2:"id";i:93;s:10:"disease_id";i:59;s:11:"question_en";s:28:"Can hypothyroidism be cured?";s:9:"answer_en";s:89:"Many cases require lifelong treatment but symptoms can usually be controlled effectively.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:93;a:7:{s:2:"id";i:94;s:10:"disease_id";i:59;s:11:"question_en";s:32:"How is hypothyroidism diagnosed?";s:9:"answer_en";s:56:"Blood tests including TSH and Free T4 are commonly used.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:94;a:7:{s:2:"id";i:95;s:10:"disease_id";i:59;s:11:"question_en";s:31:"What is the standard treatment?";s:9:"answer_en";s:62:"Thyroid hormone replacement therapy is the standard treatment.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:95;a:7:{s:2:"id";i:96;s:10:"disease_id";i:60;s:11:"question_en";s:24:"What is hyperthyroidism?";s:9:"answer_en";s:82:"Hyperthyroidism occurs when the thyroid gland produces excessive thyroid hormones.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:96;a:7:{s:2:"id";i:97;s:10:"disease_id";i:60;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:99:"Weight loss, rapid heartbeat, sweating, tremors, anxiety, and heat intolerance are common symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:97;a:7:{s:2:"id";i:98;s:10:"disease_id";i:60;s:11:"question_en";s:28:"What causes hyperthyroidism?";s:9:"answer_en";s:48:"Graves disease is one of the most common causes.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:98;a:7:{s:2:"id";i:99;s:10:"disease_id";i:60;s:11:"question_en";s:31:"Can hyperthyroidism be treated?";s:9:"answer_en";s:87:"Yes. Medications, radioactive iodine therapy, and surgery are commonly used treatments.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:99;a:7:{s:2:"id";i:100;s:10:"disease_id";i:60;s:11:"question_en";s:37:"Can hyperthyroidism affect the heart?";s:9:"answer_en";s:70:"Yes. Untreated disease may increase the risk of heart rhythm problems.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:100;a:7:{s:2:"id";i:101;s:10:"disease_id";i:83;s:11:"question_en";s:45:"What are the warning signs of a heart attack?";s:9:"answer_en";s:116:"Chest pain, shortness of breath, sweating, nausea, dizziness, and pain radiating to the arm, jaw, or back may occur.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:101;a:7:{s:2:"id";i:102;s:10:"disease_id";i:83;s:11:"question_en";s:38:"Is a heart attack a medical emergency?";s:9:"answer_en";s:75:"Yes. Immediate medical attention is critical to reduce heart muscle damage.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:102;a:7:{s:2:"id";i:103;s:10:"disease_id";i:83;s:11:"question_en";s:35:"Can young people get heart attacks?";s:9:"answer_en";s:77:"Yes. Although more common with age, younger individuals can also be affected.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:103;a:7:{s:2:"id";i:104;s:10:"disease_id";i:83;s:11:"question_en";s:32:"How is a heart attack diagnosed?";s:9:"answer_en";s:73:"ECG, blood tests such as troponin, and cardiac imaging are commonly used.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:104;a:7:{s:2:"id";i:105;s:10:"disease_id";i:83;s:11:"question_en";s:31:"Can heart attacks be prevented?";s:9:"answer_en";s:90:"Many risk factors can be reduced through healthy lifestyle choices and medical management.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:105;a:7:{s:2:"id";i:106;s:10:"disease_id";i:61;s:11:"question_en";s:21:"What is hypertension?";s:9:"answer_en";s:53:"Hypertension is persistently elevated blood pressure.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:106;a:7:{s:2:"id";i:107;s:10:"disease_id";i:61;s:11:"question_en";s:30:"Why is hypertension dangerous?";s:9:"answer_en";s:66:"It increases the risk of heart disease, stroke, and kidney damage.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:107;a:7:{s:2:"id";i:108;s:10:"disease_id";i:61;s:11:"question_en";s:31:"Can hypertension be controlled?";s:9:"answer_en";s:76:"Yes. Lifestyle changes and medicines can effectively control blood pressure.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:108;a:7:{s:2:"id";i:109;s:10:"disease_id";i:61;s:11:"question_en";s:32:"What is a normal blood pressure?";s:9:"answer_en";s:56:"Around 120/80 mmHg is considered normal for many adults.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:109;a:7:{s:2:"id";i:110;s:10:"disease_id";i:61;s:11:"question_en";s:33:"Does hypertension cause symptoms?";s:9:"answer_en";s:57:"Many people have no symptoms until complications develop.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:110;a:7:{s:2:"id";i:111;s:10:"disease_id";i:62;s:11:"question_en";s:17:"What is a stroke?";s:9:"answer_en";s:66:"Stroke occurs when blood flow to part of the brain is interrupted.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:111;a:7:{s:2:"id";i:112;s:10:"disease_id";i:62;s:11:"question_en";s:30:"What are stroke warning signs?";s:9:"answer_en";s:73:"Sudden weakness, speech difficulty, facial drooping, and vision problems.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:112;a:7:{s:2:"id";i:113;s:10:"disease_id";i:62;s:11:"question_en";s:23:"Is stroke an emergency?";s:9:"answer_en";s:37:"Yes. Immediate treatment is critical.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:113;a:7:{s:2:"id";i:114;s:10:"disease_id";i:62;s:11:"question_en";s:24:"Can stroke be prevented?";s:9:"answer_en";s:52:"Controlling risk factors significantly reduces risk.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:114;a:7:{s:2:"id";i:115;s:10:"disease_id";i:62;s:11:"question_en";s:26:"Can stroke recovery occur?";s:9:"answer_en";s:42:"Many patients improve with rehabilitation.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:115;a:7:{s:2:"id";i:116;s:10:"disease_id";i:63;s:11:"question_en";s:15:"What is asthma?";s:9:"answer_en";s:56:"Asthma is a chronic inflammatory disease of the airways.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:116;a:7:{s:2:"id";i:117;s:10:"disease_id";i:63;s:11:"question_en";s:29:"What triggers asthma attacks?";s:9:"answer_en";s:54:"Allergens, smoke, infections, exercise, and pollution.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:117;a:7:{s:2:"id";i:118;s:10:"disease_id";i:63;s:11:"question_en";s:20:"Can asthma be cured?";s:9:"answer_en";s:57:"There is no cure, but symptoms can usually be controlled.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:118;a:7:{s:2:"id";i:119;s:10:"disease_id";i:63;s:11:"question_en";s:18:"Are inhalers safe?";s:9:"answer_en";s:68:"When prescribed properly, inhalers are generally safe and effective.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:119;a:7:{s:2:"id";i:120;s:10:"disease_id";i:63;s:11:"question_en";s:25:"Can children have asthma?";s:9:"answer_en";s:38:"Yes. Asthma commonly affects children.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:120;a:7:{s:2:"id";i:121;s:10:"disease_id";i:64;s:11:"question_en";s:13:"What is COPD?";s:9:"answer_en";s:64:"COPD is a progressive lung disease causing breathing difficulty.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:121;a:7:{s:2:"id";i:122;s:10:"disease_id";i:64;s:11:"question_en";s:31:"What is the main cause of COPD?";s:9:"answer_en";s:39:"Long-term smoking is the leading cause.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:122;a:7:{s:2:"id";i:123;s:10:"disease_id";i:64;s:11:"question_en";s:18:"Can COPD be cured?";s:9:"answer_en";s:59:"No, but treatment can improve symptoms and quality of life.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:123;a:7:{s:2:"id";i:124;s:10:"disease_id";i:64;s:11:"question_en";s:26:"Can quitting smoking help?";s:9:"answer_en";s:58:"Yes. It is the most important step in slowing progression.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:124;a:7:{s:2:"id";i:125;s:10:"disease_id";i:64;s:11:"question_en";s:30:"Is COPD different from asthma?";s:9:"answer_en";s:63:"Yes. They are different diseases although symptoms may overlap.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:125;a:7:{s:2:"id";i:126;s:10:"disease_id";i:65;s:11:"question_en";s:18:"What is pneumonia?";s:9:"answer_en";s:39:"Pneumonia is an infection of the lungs.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:126;a:7:{s:2:"id";i:127;s:10:"disease_id";i:65;s:11:"question_en";s:22:"What causes pneumonia?";s:9:"answer_en";s:49:"Bacteria, viruses, and fungi can cause pneumonia.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:127;a:7:{s:2:"id";i:128;s:10:"disease_id";i:65;s:11:"question_en";s:15:"Who is at risk?";s:9:"answer_en";s:63:"Older adults, children, smokers, and people with weak immunity.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:128;a:7:{s:2:"id";i:129;s:10:"disease_id";i:65;s:11:"question_en";s:25:"Can pneumonia be serious?";s:9:"answer_en";s:46:"Yes. Severe cases may require hospitalization.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:129;a:7:{s:2:"id";i:130;s:10:"disease_id";i:65;s:11:"question_en";s:36:"Can vaccines help prevent pneumonia?";s:9:"answer_en";s:45:"Yes. Vaccination reduces risk in many people.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:130;a:7:{s:2:"id";i:131;s:10:"disease_id";i:66;s:11:"question_en";s:15:"What causes TB?";s:9:"answer_en";s:52:"TB is caused by Mycobacterium tuberculosis bacteria.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:131;a:7:{s:2:"id";i:132;s:10:"disease_id";i:66;s:11:"question_en";s:17:"Is TB contagious?";s:9:"answer_en";s:42:"Yes. It spreads through airborne droplets.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:132;a:7:{s:2:"id";i:133;s:10:"disease_id";i:66;s:11:"question_en";s:16:"Can TB be cured?";s:9:"answer_en";s:51:"Yes. Most cases can be cured with proper treatment.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:133;a:7:{s:2:"id";i:134;s:10:"disease_id";i:66;s:11:"question_en";s:22:"How long is treatment?";s:9:"answer_en";s:39:"Treatment usually lasts several months.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:134;a:7:{s:2:"id";i:135;s:10:"disease_id";i:66;s:11:"question_en";s:38:"Can TB affect organs other than lungs?";s:9:"answer_en";s:31:"Yes. TB can affect many organs.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:135;a:7:{s:2:"id";i:136;s:10:"disease_id";i:67;s:11:"question_en";s:17:"What is migraine?";s:9:"answer_en";s:64:"Migraine is a neurological disorder causing recurrent headaches.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:136;a:7:{s:2:"id";i:137;s:10:"disease_id";i:67;s:11:"question_en";s:23:"What triggers migraine?";s:9:"answer_en";s:51:"Stress, sleep changes, hormones, and certain foods.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:137;a:7:{s:2:"id";i:138;s:10:"disease_id";i:67;s:11:"question_en";s:26:"Can migraine be prevented?";s:9:"answer_en";s:66:"Many people benefit from trigger avoidance and preventive therapy.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:138;a:7:{s:2:"id";i:139;s:10:"disease_id";i:67;s:11:"question_en";s:27:"Does migraine cause nausea?";s:9:"answer_en";s:37:"Yes. Nausea is common during attacks.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:139;a:7:{s:2:"id";i:140;s:10:"disease_id";i:67;s:11:"question_en";s:27:"Can children get migraines?";s:9:"answer_en";s:36:"Yes. Migraines can occur at any age.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:140;a:7:{s:2:"id";i:141;s:10:"disease_id";i:68;s:11:"question_en";s:23:"What is osteoarthritis?";s:9:"answer_en";s:49:"A degenerative disease affecting joint cartilage.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:141;a:7:{s:2:"id";i:142;s:10:"disease_id";i:68;s:11:"question_en";s:35:"Which joints are commonly affected?";s:9:"answer_en";s:30:"Knees, hips, hands, and spine.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:142;a:7:{s:2:"id";i:143;s:10:"disease_id";i:68;s:11:"question_en";s:18:"Can exercise help?";s:9:"answer_en";s:50:"Yes. Appropriate exercise often improves symptoms.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:143;a:7:{s:2:"id";i:144;s:10:"disease_id";i:68;s:11:"question_en";s:26:"Is osteoarthritis curable?";s:9:"answer_en";s:32:"No, but symptoms can be managed.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:144;a:7:{s:2:"id";i:145;s:10:"disease_id";i:68;s:11:"question_en";s:22:"Does weight loss help?";s:9:"answer_en";s:29:"Yes. It reduces joint stress.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:145;a:7:{s:2:"id";i:146;s:10:"disease_id";i:69;s:11:"question_en";s:29:"What is rheumatoid arthritis?";s:9:"answer_en";s:39:"An autoimmune disease affecting joints.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:146;a:7:{s:2:"id";i:147;s:10:"disease_id";i:69;s:11:"question_en";s:32:"Is rheumatoid arthritis curable?";s:9:"answer_en";s:43:"No, but effective treatments are available.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:147;a:7:{s:2:"id";i:148;s:10:"disease_id";i:69;s:11:"question_en";s:21:"Can it affect organs?";s:9:"answer_en";s:40:"Yes. It may affect organs beyond joints.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:148;a:7:{s:2:"id";i:149;s:10:"disease_id";i:69;s:11:"question_en";s:33:"Why is early treatment important?";s:9:"answer_en";s:37:"Early treatment reduces joint damage.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:149;a:7:{s:2:"id";i:150;s:10:"disease_id";i:69;s:11:"question_en";s:24:"Does RA run in families?";s:9:"answer_en";s:27:"Genetics can increase risk.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:150;a:7:{s:2:"id";i:151;s:10:"disease_id";i:70;s:11:"question_en";s:18:"What is psoriasis?";s:9:"answer_en";s:34:"A chronic autoimmune skin disease.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:1;}i:151;a:7:{s:2:"id";i:152;s:10:"disease_id";i:70;s:11:"question_en";s:24:"Is psoriasis contagious?";s:9:"answer_en";s:43:"No. Psoriasis cannot spread between people.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:2;}i:152;a:7:{s:2:"id";i:153;s:10:"disease_id";i:70;s:11:"question_en";s:28:"Can stress worsen psoriasis?";s:9:"answer_en";s:40:"Yes. Stress commonly triggers flare-ups.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:3;}i:153;a:7:{s:2:"id";i:154;s:10:"disease_id";i:70;s:11:"question_en";s:28:"Can psoriasis affect joints?";s:9:"answer_en";s:47:"Yes. Some patients develop psoriatic arthritis.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:4;}i:154;a:7:{s:2:"id";i:155;s:10:"disease_id";i:70;s:11:"question_en";s:22:"Is psoriasis lifelong?";s:9:"answer_en";s:58:"Many patients experience long-term disease with flare-ups.";s:11:"question_hi";N;s:9:"answer_hi";N;s:10:"sort_order";i:5;}i:155;a:7:{s:2:"id";i:156;s:10:"disease_id";i:71;s:11:"question_en";s:15:"What is eczema?";s:9:"answer_en";s:78:"Eczema is a chronic skin condition causing itching, redness, and inflammation.";s:11:"question_hi";s:42:"एक्जिमा क्या है?";s:9:"answer_hi";s:206:"एक्जिमा त्वचा की एक दीर्घकालिक बीमारी है जिसमें खुजली, लालिमा और सूजन होती है।";s:10:"sort_order";i:1;}i:156;a:7:{s:2:"id";i:157;s:10:"disease_id";i:71;s:11:"question_en";s:21:"Is eczema contagious?";s:9:"answer_en";s:52:"No, eczema cannot spread from one person to another.";s:11:"question_hi";s:67:"क्या एक्जिमा संक्रामक है?";s:9:"answer_hi";s:151:"नहीं, एक्जिमा एक व्यक्ति से दूसरे व्यक्ति में नहीं फैलता।";s:10:"sort_order";i:2;}i:157;a:7:{s:2:"id";i:158;s:10:"disease_id";i:71;s:11:"question_en";s:31:"What triggers eczema flare-ups?";s:9:"answer_en";s:73:"Stress, allergens, harsh soaps, and weather changes may trigger symptoms.";s:11:"question_hi";s:81:"एक्जिमा बढ़ने के कारण क्या हैं?";s:9:"answer_hi";s:163:"तनाव, एलर्जी, कठोर साबुन और मौसम में बदलाव लक्षण बढ़ा सकते हैं।";s:10:"sort_order";i:3;}i:158;a:7:{s:2:"id";i:159;s:10:"disease_id";i:71;s:11:"question_en";s:20:"Can eczema be cured?";s:9:"answer_en";s:59:"There is no permanent cure, but symptoms can be controlled.";s:11:"question_hi";s:95:"क्या एक्जिमा पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:155:"स्थायी इलाज नहीं है, लेकिन लक्षण नियंत्रित किए जा सकते हैं।";s:10:"sort_order";i:4;}i:159;a:7:{s:2:"id";i:160;s:10:"disease_id";i:71;s:11:"question_en";s:22:"How is eczema treated?";s:9:"answer_en";s:66:"Treatment includes moisturizers, medicines, and avoiding triggers.";s:11:"question_hi";s:91:"एक्जिमा का उपचार कैसे किया जाता है?";s:9:"answer_hi";s:157:"उपचार में मॉइस्चराइज़र, दवाएं और ट्रिगर्स से बचना शामिल है।";s:10:"sort_order";i:5;}i:160;a:7:{s:2:"id";i:161;s:10:"disease_id";i:72;s:11:"question_en";s:28:"What is fatty liver disease?";s:9:"answer_en";s:60:"It is a condition where excess fat accumulates in the liver.";s:11:"question_hi";s:56:"फैटी लिवर रोग क्या है?";s:9:"answer_hi";s:166:"यह एक ऐसी स्थिति है जिसमें यकृत में अतिरिक्त वसा जमा हो जाती है।";s:10:"sort_order";i:1;}i:161;a:7:{s:2:"id";i:162;s:10:"disease_id";i:72;s:11:"question_en";s:28:"Can fatty liver be reversed?";s:9:"answer_en";s:65:"Yes, lifestyle changes can often reverse early-stage fatty liver.";s:11:"question_hi";s:76:"क्या फैटी लिवर ठीक हो सकता है?";s:9:"answer_hi";s:165:"हाँ, शुरुआती अवस्था में जीवनशैली में बदलाव से सुधार हो सकता है।";s:10:"sort_order";i:2;}i:162;a:7:{s:2:"id";i:163;s:10:"disease_id";i:72;s:11:"question_en";s:31:"Does alcohol cause fatty liver?";s:9:"answer_en";s:60:"Alcohol can contribute significantly to fatty liver disease.";s:11:"question_hi";s:92:"क्या शराब फैटी लिवर का कारण बनती है?";s:9:"answer_hi";s:125:"हाँ, शराब फैटी लिवर का एक प्रमुख कारण हो सकती है।";s:10:"sort_order";i:3;}i:163;a:7:{s:2:"id";i:164;s:10:"disease_id";i:72;s:11:"question_en";s:28:"What foods help fatty liver?";s:9:"answer_en";s:67:"Vegetables, fruits, whole grains, and lean proteins are beneficial.";s:11:"question_hi";s:98:"फैटी लिवर में कौन से भोजन लाभकारी हैं?";s:9:"answer_hi";s:156:"सब्जियां, फल, साबुत अनाज और कम वसा वाले प्रोटीन लाभकारी हैं।";s:10:"sort_order";i:4;}i:164;a:7:{s:2:"id";i:165;s:10:"disease_id";i:72;s:11:"question_en";s:36:"Can fatty liver cause complications?";s:9:"answer_en";s:70:"Yes, untreated fatty liver can progress to liver damage and cirrhosis.";s:11:"question_hi";s:104:"क्या फैटी लिवर जटिलताएं पैदा कर सकता है?";s:9:"answer_hi";s:172:"हाँ, अनुपचारित फैटी लिवर सिरोसिस और लिवर क्षति का कारण बन सकता है।";s:10:"sort_order";i:5;}i:165;a:7:{s:2:"id";i:166;s:10:"disease_id";i:73;s:11:"question_en";s:20:"What are gallstones?";s:9:"answer_en";s:66:"Gallstones are hardened deposits that form inside the gallbladder.";s:11:"question_hi";s:65:"पित्ताशय की पथरी क्या है?";s:9:"answer_hi";s:139:"पित्ताशय में बनने वाले कठोर जमाव को पथरी कहा जाता है।";s:10:"sort_order";i:1;}i:166;a:7:{s:2:"id";i:167;s:10:"disease_id";i:73;s:11:"question_en";s:32:"What are symptoms of gallstones?";s:9:"answer_en";s:71:"Pain in the upper abdomen, nausea, and indigestion are common symptoms.";s:11:"question_hi";s:91:"पित्ताशय की पथरी के लक्षण क्या हैं?";s:9:"answer_hi";s:127:"ऊपरी पेट में दर्द, मतली और अपच सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:167;a:7:{s:2:"id";i:168;s:10:"disease_id";i:73;s:11:"question_en";s:34:"Can gallstones dissolve naturally?";s:9:"answer_en";s:66:"Some small stones may remain harmless, but many require treatment.";s:11:"question_hi";s:109:"क्या पित्त की पथरी अपने आप खत्म हो सकती है?";s:9:"answer_hi";s:203:"कुछ छोटी पथरियां समस्या नहीं करतीं, लेकिन कई मामलों में उपचार आवश्यक होता है।";s:10:"sort_order";i:3;}i:168;a:7:{s:2:"id";i:169;s:10:"disease_id";i:73;s:11:"question_en";s:25:"When is surgery required?";s:9:"answer_en";s:65:"Surgery is recommended if gallstones cause pain or complications.";s:11:"question_hi";s:65:"सर्जरी कब आवश्यक होती है?";s:9:"answer_hi";s:175:"यदि पथरी दर्द या जटिलताएं उत्पन्न करे तो सर्जरी की सलाह दी जाती है।";s:10:"sort_order";i:4;}i:169;a:7:{s:2:"id";i:170;s:10:"disease_id";i:73;s:11:"question_en";s:33:"Can diet help prevent gallstones?";s:9:"answer_en";s:56:"Yes, a balanced diet and healthy weight can reduce risk.";s:11:"question_hi";s:105:"क्या आहार पथरी की रोकथाम में मदद करता है?";s:9:"answer_hi";s:137:"हाँ, संतुलित आहार और स्वस्थ वजन जोखिम कम कर सकते हैं।";s:10:"sort_order";i:5;}i:170;a:7:{s:2:"id";i:171;s:10:"disease_id";i:74;s:11:"question_en";s:23:"What are kidney stones?";s:9:"answer_en";s:62:"Kidney stones are hard mineral deposits formed in the kidneys.";s:11:"question_hi";s:59:"गुर्दे की पथरी क्या है?";s:9:"answer_hi";s:142:"गुर्दों में बनने वाले कठोर खनिज जमाव को पथरी कहते हैं।";s:10:"sort_order";i:1;}i:171;a:7:{s:2:"id";i:172;s:10:"disease_id";i:74;s:11:"question_en";s:26:"What causes kidney stones?";s:9:"answer_en";s:68:"Dehydration, excess minerals, and dietary factors are common causes.";s:11:"question_hi";s:75:"गुर्दे की पथरी क्यों बनती है?";s:9:"answer_hi";s:179:"निर्जलीकरण, अतिरिक्त खनिज और आहार संबंधी कारण इसके प्रमुख कारण हैं।";s:10:"sort_order";i:2;}i:172;a:7:{s:2:"id";i:173;s:10:"disease_id";i:74;s:11:"question_en";s:35:"What are symptoms of kidney stones?";s:9:"answer_en";s:66:"Severe flank pain, blood in urine, and nausea are common symptoms.";s:11:"question_hi";s:85:"गुर्दे की पथरी के लक्षण क्या हैं?";s:9:"answer_hi";s:150:"कमर में तेज दर्द, पेशाब में खून और मतली सामान्य लक्षण हैं।";s:10:"sort_order";i:3;}i:173;a:7:{s:2:"id";i:174;s:10:"disease_id";i:74;s:11:"question_en";s:33:"Can kidney stones pass naturally?";s:9:"answer_en";s:56:"Small stones may pass naturally with adequate hydration.";s:11:"question_hi";s:79:"क्या पथरी अपने आप निकल सकती है?";s:9:"answer_hi";s:135:"छोटी पथरी पर्याप्त पानी पीने से स्वयं निकल सकती है।";s:10:"sort_order";i:4;}i:174;a:7:{s:2:"id";i:175;s:10:"disease_id";i:74;s:11:"question_en";s:35:"How can kidney stones be prevented?";s:9:"answer_en";s:52:"Drink plenty of water and reduce excess salt intake.";s:11:"question_hi";s:85:"गुर्दे की पथरी से बचाव कैसे करें?";s:9:"answer_hi";s:98:"अधिक पानी पिएं और नमक का सेवन कम करें।";s:10:"sort_order";i:5;}i:175;a:7:{s:2:"id";i:176;s:10:"disease_id";i:75;s:11:"question_en";s:13:"What is GERD?";s:9:"answer_en";s:69:"GERD is a condition where stomach acid flows back into the esophagus.";s:11:"question_hi";s:42:"जीईआरडी क्या है?";s:9:"answer_hi";s:134:"जीईआरडी में पेट का अम्ल भोजन नली में वापस आ जाता है।";s:10:"sort_order";i:1;}i:176;a:7:{s:2:"id";i:177;s:10:"disease_id";i:75;s:11:"question_en";s:33:"What are common symptoms of GERD?";s:9:"answer_en";s:65:"Heartburn, acid reflux, and chest discomfort are common symptoms.";s:11:"question_hi";s:90:"जीईआरडी के सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:168:"सीने में जलन, अम्लता और छाती में असुविधा इसके सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:177;a:7:{s:2:"id";i:178;s:10:"disease_id";i:75;s:11:"question_en";s:18:"Can GERD be cured?";s:9:"answer_en";s:77:"Many people control GERD effectively through treatment and lifestyle changes.";s:11:"question_hi";s:72:"क्या जीईआरडी ठीक हो सकता है?";s:9:"answer_hi";s:183:"उपचार और जीवनशैली में बदलाव से अधिकांश लोग इसे नियंत्रित कर सकते हैं।";s:10:"sort_order";i:3;}i:178;a:7:{s:2:"id";i:179;s:10:"disease_id";i:75;s:11:"question_en";s:24:"Which foods worsen GERD?";s:9:"answer_en";s:68:"Spicy foods, fatty foods, caffeine, and alcohol may worsen symptoms.";s:11:"question_hi";s:103:"कौन से खाद्य पदार्थ जीईआरडी बढ़ाते हैं?";s:9:"answer_hi";s:168:"मसालेदार भोजन, वसायुक्त भोजन, कैफीन और शराब लक्षण बढ़ा सकते हैं।";s:10:"sort_order";i:4;}i:179;a:7:{s:2:"id";i:180;s:10:"disease_id";i:75;s:11:"question_en";s:31:"Can obesity increase GERD risk?";s:9:"answer_en";s:47:"Yes, excess body weight can worsen acid reflux.";s:11:"question_hi";s:103:"क्या मोटापा जीईआरडी का जोखिम बढ़ाता है?";s:9:"answer_hi";s:120:"हाँ, अधिक वजन अम्लीय रिफ्लक्स को बढ़ा सकता है।";s:10:"sort_order";i:5;}i:180;a:7:{s:2:"id";i:181;s:10:"disease_id";i:76;s:11:"question_en";s:23:"What is a peptic ulcer?";s:9:"answer_en";s:78:"A peptic ulcer is an open sore in the stomach or upper small intestine lining.";s:11:"question_hi";s:58:"पेप्टिक अल्सर क्या है?";s:9:"answer_hi";s:150:"पेप्टिक अल्सर पेट या छोटी आंत की परत में बनने वाला घाव है।";s:10:"sort_order";i:1;}i:181;a:7:{s:2:"id";i:182;s:10:"disease_id";i:76;s:11:"question_en";s:26:"What causes peptic ulcers?";s:9:"answer_en";s:69:"Most ulcers are caused by H. pylori infection or long-term NSAID use.";s:11:"question_hi";s:78:"पेप्टिक अल्सर का कारण क्या है?";s:9:"answer_hi";s:230:"अधिकांश अल्सर एच. पाइलोरी संक्रमण या लंबे समय तक दर्द निवारक दवाओं के उपयोग से होते हैं।";s:10:"sort_order";i:2;}i:182;a:7:{s:2:"id";i:183;s:10:"disease_id";i:76;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:76:"Burning stomach pain, bloating, nausea, and indigestion are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:122:"पेट में जलन, गैस, मतली और अपच सामान्य लक्षण हैं।";s:10:"sort_order";i:3;}i:183;a:7:{s:2:"id";i:184;s:10:"disease_id";i:76;s:11:"question_en";s:23:"Can peptic ulcers heal?";s:9:"answer_en";s:66:"Yes, most ulcers heal with proper treatment and lifestyle changes.";s:11:"question_hi";s:88:"क्या पेप्टिक अल्सर ठीक हो सकता है?";s:9:"answer_hi";s:185:"हाँ, उचित उपचार और जीवनशैली में बदलाव से अधिकांश अल्सर ठीक हो जाते हैं।";s:10:"sort_order";i:4;}i:184;a:7:{s:2:"id";i:185;s:10:"disease_id";i:76;s:11:"question_en";s:27:"When should I see a doctor?";s:9:"answer_en";s:65:"Seek medical attention if symptoms are severe or bleeding occurs.";s:11:"question_hi";s:65:"डॉक्टर से कब मिलना चाहिए?";s:9:"answer_hi";s:183:"यदि लक्षण गंभीर हों या रक्तस्राव हो तो तुरंत चिकित्सक से संपर्क करें।";s:10:"sort_order";i:5;}i:185;a:7:{s:2:"id";i:186;s:10:"disease_id";i:77;s:11:"question_en";s:21:"What is dengue fever?";s:9:"answer_en";s:55:"Dengue is a viral infection spread by Aedes mosquitoes.";s:11:"question_hi";s:52:"डेंगू बुखार क्या है?";s:9:"answer_hi";s:146:"डेंगू एडीज मच्छरों द्वारा फैलने वाला वायरल संक्रमण है।";s:10:"sort_order";i:1;}i:186;a:7:{s:2:"id";i:187;s:10:"disease_id";i:77;s:11:"question_en";s:32:"What are the symptoms of dengue?";s:9:"answer_en";s:72:"High fever, headache, body pain, rash, and weakness are common symptoms.";s:11:"question_hi";s:62:"डेंगू के लक्षण क्या हैं?";s:9:"answer_hi";s:185:"तेज बुखार, सिरदर्द, शरीर दर्द, चकत्ते और कमजोरी इसके सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:187;a:7:{s:2:"id";i:188;s:10:"disease_id";i:77;s:11:"question_en";s:22:"Can dengue be serious?";s:9:"answer_en";s:48:"Yes, severe dengue can cause bleeding and shock.";s:11:"question_hi";s:72:"क्या डेंगू गंभीर हो सकता है?";s:9:"answer_hi";s:127:"हाँ, गंभीर डेंगू में रक्तस्राव और शॉक हो सकता है।";s:10:"sort_order";i:3;}i:188;a:7:{s:2:"id";i:189;s:10:"disease_id";i:77;s:11:"question_en";s:24:"How is dengue diagnosed?";s:9:"answer_en";s:60:"Blood tests such as NS1 antigen and antibody tests are used.";s:11:"question_hi";s:72:"डेंगू का निदान कैसे होता है?";s:9:"answer_hi";s:148:"एनएस1 एंटीजन और एंटीबॉडी जैसे रक्त परीक्षण किए जाते हैं।";s:10:"sort_order";i:4;}i:189;a:7:{s:2:"id";i:190;s:10:"disease_id";i:77;s:11:"question_en";s:28:"How can dengue be prevented?";s:9:"answer_en";s:52:"Prevent mosquito bites and eliminate stagnant water.";s:11:"question_hi";s:62:"डेंगू से बचाव कैसे करें?";s:9:"answer_hi";s:110:"मच्छरों से बचें और रुके हुए पानी को हटाएं।";s:10:"sort_order";i:5;}i:190;a:7:{s:2:"id";i:191;s:10:"disease_id";i:78;s:11:"question_en";s:16:"What is malaria?";s:9:"answer_en";s:61:"Malaria is a parasitic disease spread through mosquito bites.";s:11:"question_hi";s:42:"मलेरिया क्या है?";s:9:"answer_hi";s:141:"मलेरिया मच्छरों के काटने से फैलने वाला परजीवी रोग है।";s:10:"sort_order";i:1;}i:191;a:7:{s:2:"id";i:192;s:10:"disease_id";i:78;s:11:"question_en";s:33:"What are the symptoms of malaria?";s:9:"answer_en";s:67:"Fever, chills, sweating, headache, and fatigue are common symptoms.";s:11:"question_hi";s:68:"मलेरिया के लक्षण क्या हैं?";s:9:"answer_hi";s:163:"बुखार, ठंड लगना, पसीना, सिरदर्द और थकान इसके सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:192;a:7:{s:2:"id";i:193;s:10:"disease_id";i:78;s:11:"question_en";s:19:"Is malaria curable?";s:9:"answer_en";s:59:"Yes, malaria is usually curable with appropriate medicines.";s:11:"question_hi";s:72:"क्या मलेरिया ठीक हो सकता है?";s:9:"answer_hi";s:114:"हाँ, उचित दवाओं से मलेरिया का उपचार संभव है।";s:10:"sort_order";i:3;}i:193;a:7:{s:2:"id";i:194;s:10:"disease_id";i:78;s:11:"question_en";s:25:"How is malaria diagnosed?";s:9:"answer_en";s:57:"Blood smear and rapid diagnostic tests are commonly used.";s:11:"question_hi";s:91:"मलेरिया का निदान कैसे किया जाता है?";s:9:"answer_hi";s:141:"रक्त स्लाइड और रैपिड टेस्ट द्वारा निदान किया जाता है।";s:10:"sort_order";i:4;}i:194;a:7:{s:2:"id";i:195;s:10:"disease_id";i:78;s:11:"question_en";s:29:"How can malaria be prevented?";s:9:"answer_en";s:65:"Use mosquito nets, repellents, and avoid mosquito breeding areas.";s:11:"question_hi";s:68:"मलेरिया से बचाव कैसे करें?";s:9:"answer_hi";s:186:"मच्छरदानी, रिपेलेंट का उपयोग करें और मच्छरों के प्रजनन स्थलों से बचें।";s:10:"sort_order";i:5;}i:195;a:7:{s:2:"id";i:196;s:10:"disease_id";i:79;s:11:"question_en";s:16:"What is typhoid?";s:9:"answer_en";s:60:"Typhoid is a bacterial infection caused by Salmonella Typhi.";s:11:"question_hi";s:42:"टाइफाइड क्या है?";s:9:"answer_hi";s:165:"टाइफाइड साल्मोनेला टाइफी जीवाणु के कारण होने वाला संक्रमण है।";s:10:"sort_order";i:1;}i:196;a:7:{s:2:"id";i:197;s:10:"disease_id";i:79;s:11:"question_en";s:24:"How does typhoid spread?";s:9:"answer_en";s:47:"It spreads through contaminated food and water.";s:11:"question_hi";s:58:"टाइफाइड कैसे फैलता है?";s:9:"answer_hi";s:114:"यह दूषित भोजन और पानी के माध्यम से फैलता है।";s:10:"sort_order";i:2;}i:197;a:7:{s:2:"id";i:198;s:10:"disease_id";i:79;s:11:"question_en";s:33:"What are the symptoms of typhoid?";s:9:"answer_en";s:74:"Fever, weakness, abdominal pain, and loss of appetite are common symptoms.";s:11:"question_hi";s:68:"टाइफाइड के लक्षण क्या हैं?";s:9:"answer_hi";s:147:"बुखार, कमजोरी, पेट दर्द और भूख कम लगना सामान्य लक्षण हैं।";s:10:"sort_order";i:3;}i:198;a:7:{s:2:"id";i:199;s:10:"disease_id";i:79;s:11:"question_en";s:25:"Can typhoid be prevented?";s:9:"answer_en";s:66:"Yes, safe food, clean water, and vaccination help prevent typhoid.";s:11:"question_hi";s:75:"क्या टाइफाइड से बचाव संभव है?";s:9:"answer_hi";s:153:"हाँ, स्वच्छ भोजन, सुरक्षित पानी और टीकाकरण से बचाव संभव है।";s:10:"sort_order";i:4;}i:199;a:7:{s:2:"id";i:200;s:10:"disease_id";i:79;s:11:"question_en";s:23:"How is typhoid treated?";s:9:"answer_en";s:53:"Antibiotics and adequate hydration are commonly used.";s:11:"question_hi";s:91:"टाइफाइड का उपचार कैसे किया जाता है?";s:9:"answer_hi";s:136:"एंटीबायोटिक्स और पर्याप्त तरल पदार्थ दिए जाते हैं।";s:10:"sort_order";i:5;}i:200;a:7:{s:2:"id";i:201;s:10:"disease_id";i:80;s:11:"question_en";s:20:"What is Hepatitis B?";s:9:"answer_en";s:53:"Hepatitis B is a viral infection affecting the liver.";s:11:"question_hi";s:58:"हेपेटाइटिस बी क्या है?";s:9:"answer_hi";s:156:"हेपेटाइटिस बी यकृत को प्रभावित करने वाला वायरल संक्रमण है।";s:10:"sort_order";i:1;}i:201;a:7:{s:2:"id";i:202;s:10:"disease_id";i:80;s:11:"question_en";s:28:"How does Hepatitis B spread?";s:9:"answer_en";s:50:"It spreads through infected blood and body fluids.";s:11:"question_hi";s:74:"हेपेटाइटिस बी कैसे फैलता है?";s:9:"answer_hi";s:151:"यह संक्रमित रक्त और शारीरिक द्रवों के माध्यम से फैलता है।";s:10:"sort_order";i:2;}i:202;a:7:{s:2:"id";i:203;s:10:"disease_id";i:80;s:11:"question_en";s:31:"Can Hepatitis B become chronic?";s:9:"answer_en";s:43:"Yes, some people develop chronic infection.";s:11:"question_hi";s:109:"क्या हेपेटाइटिस बी दीर्घकालिक हो सकता है?";s:9:"answer_hi";s:136:"हाँ, कुछ लोगों में यह दीर्घकालिक संक्रमण बन सकता है।";s:10:"sort_order";i:3;}i:203;a:7:{s:2:"id";i:204;s:10:"disease_id";i:80;s:11:"question_en";s:35:"Is there a vaccine for Hepatitis B?";s:9:"answer_en";s:52:"Yes, vaccination is highly effective for prevention.";s:11:"question_hi";s:97:"क्या हेपेटाइटिस बी का टीका उपलब्ध है?";s:9:"answer_hi";s:139:"हाँ, इसका टीका संक्रमण से बचाव में अत्यंत प्रभावी है।";s:10:"sort_order";i:4;}i:204;a:7:{s:2:"id";i:205;s:10:"disease_id";i:80;s:11:"question_en";s:29:"How is Hepatitis B diagnosed?";s:9:"answer_en";s:66:"Blood tests are used to identify viral markers and liver function.";s:11:"question_hi";s:107:"हेपेटाइटिस बी का निदान कैसे किया जाता है?";s:9:"answer_hi";s:174:"रक्त परीक्षण द्वारा वायरस मार्कर और यकृत कार्य की जांच की जाती है।";s:10:"sort_order";i:5;}i:205;a:7:{s:2:"id";i:206;s:10:"disease_id";i:82;s:11:"question_en";s:32:"What is Coronary Artery Disease?";s:9:"answer_en";s:80:"It is a condition where coronary arteries become narrowed due to plaque buildup.";s:11:"question_hi";s:65:"कोरोनरी धमनी रोग क्या है?";s:9:"answer_hi";s:149:"यह एक स्थिति है जिसमें हृदय की धमनियां संकरी हो जाती हैं।";s:10:"sort_order";i:1;}i:206;a:7:{s:2:"id";i:207;s:10:"disease_id";i:82;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:65:"Chest pain, shortness of breath, and fatigue are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:136:"सीने में दर्द, सांस फूलना और थकान सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:207;a:7:{s:2:"id";i:208;s:10:"disease_id";i:82;s:11:"question_en";s:41:"Can Coronary Artery Disease be prevented?";s:9:"answer_en";s:61:"Yes, healthy lifestyle choices can significantly reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:139:"हाँ, स्वस्थ जीवनशैली अपनाकर जोखिम कम किया जा सकता है।";s:10:"sort_order";i:3;}i:208;a:7:{s:2:"id";i:209;s:10:"disease_id";i:82;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:53:"ECG, stress tests, and angiography are commonly used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:169:"ईसीजी, स्ट्रेस टेस्ट और एंजियोग्राफी द्वारा निदान किया जाता है।";s:10:"sort_order";i:4;}i:209;a:7:{s:2:"id";i:210;s:10:"disease_id";i:82;s:11:"question_en";s:28:"Can it cause a heart attack?";s:9:"answer_en";s:48:"Yes, untreated disease can lead to heart attack.";s:11:"question_hi";s:92:"क्या यह हृदयाघात का कारण बन सकता है?";s:9:"answer_hi";s:122:"हाँ, अनुपचारित स्थिति में हृदयाघात हो सकता है।";s:10:"sort_order";i:5;}i:210;a:7:{s:2:"id";i:211;s:10:"disease_id";i:84;s:11:"question_en";s:22:"What is Heart Failure?";s:9:"answer_en";s:66:"Heart failure occurs when the heart cannot pump blood effectively.";s:11:"question_hi";s:52:"हृदय विफलता क्या है?";s:9:"answer_hi";s:170:"यह स्थिति तब होती है जब हृदय प्रभावी रूप से रक्त पंप नहीं कर पाता।";s:10:"sort_order";i:1;}i:211;a:7:{s:2:"id";i:212;s:10:"disease_id";i:84;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:58:"Breathlessness, swelling, and fatigue are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:113:"सांस फूलना, सूजन और थकान सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:212;a:7:{s:2:"id";i:213;s:10:"disease_id";i:84;s:11:"question_en";s:27:"Can Heart Failure be cured?";s:9:"answer_en";s:51:"It is usually managed rather than completely cured.";s:11:"question_hi";s:105:"क्या हृदय विफलता पूरी तरह ठीक हो सकती है?";s:9:"answer_hi";s:181:"आमतौर पर इसे नियंत्रित किया जाता है, पूर्ण इलाज हमेशा संभव नहीं होता।";s:10:"sort_order";i:3;}i:213;a:7:{s:2:"id";i:214;s:10:"disease_id";i:84;s:11:"question_en";s:31:"How is Heart Failure diagnosed?";s:9:"answer_en";s:58:"Diagnosis includes ECG, echocardiography, and blood tests.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:139:"ईसीजी, इको और रक्त परीक्षण द्वारा निदान किया जाता है।";s:10:"sort_order";i:4;}i:214;a:7:{s:2:"id";i:215;s:10:"disease_id";i:84;s:11:"question_en";s:27:"Can lifestyle changes help?";s:9:"answer_en";s:60:"Yes, diet, exercise, and medication adherence are important.";s:11:"question_hi";s:93:"क्या जीवनशैली में बदलाव लाभकारी है?";s:9:"answer_hi";s:130:"हाँ, आहार, व्यायाम और दवाओं का पालन महत्वपूर्ण है।";s:10:"sort_order";i:5;}i:215;a:7:{s:2:"id";i:216;s:10:"disease_id";i:85;s:11:"question_en";s:28:"What is Atrial Fibrillation?";s:9:"answer_en";s:48:"It is an irregular and often rapid heart rhythm.";s:11:"question_hi";s:73:"एट्रियल फिब्रिलेशन क्या है?";s:9:"answer_hi";s:117:"यह हृदय की अनियमित और तेज धड़कन की स्थिति है।";s:10:"sort_order";i:1;}i:216;a:7:{s:2:"id";i:217;s:10:"disease_id";i:85;s:11:"question_en";s:43:"What symptoms occur in Atrial Fibrillation?";s:9:"answer_en";s:57:"Palpitations, dizziness, and fatigue are common symptoms.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:149:"दिल की धड़कन महसूस होना, चक्कर और थकान सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:217;a:7:{s:2:"id";i:218;s:10:"disease_id";i:85;s:11:"question_en";s:46:"Does Atrial Fibrillation increase stroke risk?";s:9:"answer_en";s:51:"Yes, it significantly increases the risk of stroke.";s:11:"question_hi";s:94:"क्या इससे स्ट्रोक का जोखिम बढ़ता है?";s:9:"answer_hi";s:101:"हाँ, इससे स्ट्रोक का जोखिम बढ़ जाता है।";s:10:"sort_order";i:3;}i:218;a:7:{s:2:"id";i:219;s:10:"disease_id";i:85;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:50:"ECG and heart rhythm monitoring are commonly used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:138:"ईसीजी और हृदय गति निगरानी द्वारा निदान किया जाता है।";s:10:"sort_order";i:4;}i:219;a:7:{s:2:"id";i:220;s:10:"disease_id";i:85;s:11:"question_en";s:31:"Can treatment control symptoms?";s:9:"answer_en";s:56:"Yes, medicines and procedures can help control symptoms.";s:11:"question_hi";s:110:"क्या उपचार से लक्षण नियंत्रित हो सकते हैं?";s:9:"answer_hi";s:161:"हाँ, दवाओं और प्रक्रियाओं से लक्षण नियंत्रित किए जा सकते हैं।";s:10:"sort_order";i:5;}i:220;a:7:{s:2:"id";i:221;s:10:"disease_id";i:86;s:11:"question_en";s:15:"What is Angina?";s:9:"answer_en";s:69:"Angina is chest discomfort caused by reduced blood flow to the heart.";s:11:"question_hi";s:42:"एंजाइना क्या है?";s:9:"answer_hi";s:157:"यह हृदय में रक्त प्रवाह कम होने से होने वाला सीने का दर्द है।";s:10:"sort_order";i:1;}i:221;a:7:{s:2:"id";i:222;s:10:"disease_id";i:86;s:11:"question_en";s:21:"What triggers angina?";s:9:"answer_en";s:67:"Physical exertion, stress, or emotional upset may trigger symptoms.";s:11:"question_hi";s:68:"एंजाइना किससे बढ़ सकता है?";s:9:"answer_hi";s:145:"शारीरिक परिश्रम, तनाव या भावनात्मक दबाव से बढ़ सकता है।";s:10:"sort_order";i:2;}i:222;a:7:{s:2:"id";i:223;s:10:"disease_id";i:86;s:11:"question_en";s:25:"Is angina a heart attack?";s:9:"answer_en";s:58:"No, but it may indicate an increased risk of heart attack.";s:11:"question_hi";s:67:"क्या एंजाइना हृदयाघात है?";s:9:"answer_hi";s:137:"नहीं, लेकिन यह हृदयाघात के जोखिम का संकेत हो सकता है।";s:10:"sort_order";i:3;}i:223;a:7:{s:2:"id";i:224;s:10:"disease_id";i:86;s:11:"question_en";s:24:"How is angina diagnosed?";s:9:"answer_en";s:53:"ECG, stress tests, and angiography are commonly used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:128:"ईसीजी, स्ट्रेस टेस्ट और एंजियोग्राफी की जाती है।";s:10:"sort_order";i:4;}i:224;a:7:{s:2:"id";i:225;s:10:"disease_id";i:86;s:11:"question_en";s:27:"Can lifestyle changes help?";s:9:"answer_en";s:55:"Yes, healthy lifestyle habits reduce symptoms and risk.";s:11:"question_hi";s:97:"क्या जीवनशैली में बदलाव मदद करते हैं?";s:9:"answer_hi";s:117:"हाँ, स्वस्थ आदतें लक्षण और जोखिम कम करती हैं।";s:10:"sort_order";i:5;}i:225;a:7:{s:2:"id";i:226;s:10:"disease_id";i:87;s:11:"question_en";s:23:"What is Cardiomyopathy?";s:9:"answer_en";s:62:"It is a disease of the heart muscle affecting pumping ability.";s:11:"question_hi";s:69:"कार्डियोमायोपैथी क्या है?";s:9:"answer_hi";s:87:"यह हृदय की मांसपेशियों का रोग है।";s:10:"sort_order";i:1;}i:226;a:7:{s:2:"id";i:227;s:10:"disease_id";i:87;s:11:"question_en";s:27:"What causes Cardiomyopathy?";s:9:"answer_en";s:60:"Genetics, infections, and alcohol abuse are possible causes.";s:11:"question_hi";s:92:"कार्डियोमायोपैथी के कारण क्या हैं?";s:9:"answer_hi";s:152:"आनुवंशिक कारण, संक्रमण और शराब सेवन इसके कारण हो सकते हैं।";s:10:"sort_order";i:2;}i:227;a:7:{s:2:"id";i:228;s:10:"disease_id";i:87;s:11:"question_en";s:25:"What symptoms are common?";s:9:"answer_en";s:60:"Breathlessness, fatigue, and irregular heartbeat are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:122:"सांस फूलना, थकान और अनियमित धड़कन सामान्य हैं।";s:10:"sort_order";i:3;}i:228;a:7:{s:2:"id";i:229;s:10:"disease_id";i:87;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:40:"Echocardiography and MRI are often used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:148:"इकोकार्डियोग्राफी और एमआरआई द्वारा निदान किया जाता है।";s:10:"sort_order";i:4;}i:229;a:7:{s:2:"id";i:230;s:10:"disease_id";i:87;s:11:"question_en";s:41:"Can Cardiomyopathy lead to Heart Failure?";s:9:"answer_en";s:48:"Yes, severe cases may progress to heart failure.";s:11:"question_hi";s:85:"क्या इससे हृदय विफलता हो सकती है?";s:9:"answer_hi";s:117:"हाँ, गंभीर मामलों में हृदय विफलता हो सकती है।";s:10:"sort_order";i:5;}i:230;a:7:{s:2:"id";i:231;s:10:"disease_id";i:88;s:11:"question_en";s:21:"What is Pericarditis?";s:9:"answer_en";s:67:"Pericarditis is inflammation of the membrane surrounding the heart.";s:11:"question_hi";s:63:"पेरिकार्डाइटिस क्या है?";s:9:"answer_hi";s:104:"यह हृदय को घेरने वाली झिल्ली की सूजन है।";s:10:"sort_order";i:1;}i:231;a:7:{s:2:"id";i:232;s:10:"disease_id";i:88;s:11:"question_en";s:25:"What causes Pericarditis?";s:9:"answer_en";s:59:"Viral infections and autoimmune diseases are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:140:"वायरल संक्रमण और ऑटोइम्यून रोग इसके प्रमुख कारण हैं।";s:10:"sort_order";i:2;}i:232;a:7:{s:2:"id";i:233;s:10:"disease_id";i:88;s:11:"question_en";s:22:"What are the symptoms?";s:9:"answer_en";s:47:"Sharp chest pain and fever are common symptoms.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:119:"सीने में तेज दर्द और बुखार सामान्य लक्षण हैं।";s:10:"sort_order";i:3;}i:233;a:7:{s:2:"id";i:234;s:10:"disease_id";i:88;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:48:"ECG, echocardiography, and blood tests are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:104:"ईसीजी, इको और रक्त परीक्षण किए जाते हैं।";s:10:"sort_order";i:4;}i:234;a:7:{s:2:"id";i:235;s:10:"disease_id";i:88;s:11:"question_en";s:31:"Can it be treated successfully?";s:9:"answer_en";s:46:"Yes, most cases improve with proper treatment.";s:11:"question_hi";s:72:"क्या इसका सफल उपचार संभव है?";s:9:"answer_hi";s:123:"हाँ, अधिकांश मामलों में उपचार से सुधार होता है।";s:10:"sort_order";i:5;}i:235;a:7:{s:2:"id";i:236;s:10:"disease_id";i:89;s:11:"question_en";s:21:"What is Endocarditis?";s:9:"answer_en";s:60:"Endocarditis is an infection of the heart lining and valves.";s:11:"question_hi";s:63:"एंडोकार्डाइटिस क्या है?";s:9:"answer_hi";s:123:"यह हृदय की आंतरिक परत और वाल्वों का संक्रमण है।";s:10:"sort_order";i:1;}i:236;a:7:{s:2:"id";i:237;s:10:"disease_id";i:89;s:11:"question_en";s:25:"What causes Endocarditis?";s:9:"answer_en";s:60:"Bacteria entering the bloodstream are the most common cause.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:134:"रक्त में बैक्टीरिया का प्रवेश इसका प्रमुख कारण है।";s:10:"sort_order";i:2;}i:237;a:7:{s:2:"id";i:238;s:10:"disease_id";i:89;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:54:"Fever, fatigue, and heart murmurs are common symptoms.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:148:"बुखार, थकान और हृदय की असामान्य ध्वनि सामान्य लक्षण हैं।";s:10:"sort_order";i:3;}i:238;a:7:{s:2:"id";i:239;s:10:"disease_id";i:89;s:11:"question_en";s:30:"How is Endocarditis diagnosed?";s:9:"answer_en";s:56:"Blood cultures and echocardiography are important tests.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:144:"रक्त कल्चर और इकोकार्डियोग्राफी महत्वपूर्ण जांच हैं।";s:10:"sort_order";i:4;}i:239;a:7:{s:2:"id";i:240;s:10:"disease_id";i:89;s:11:"question_en";s:28:"Can Endocarditis be serious?";s:9:"answer_en";s:49:"Yes, untreated infection can damage heart valves.";s:11:"question_hi";s:63:"क्या यह गंभीर हो सकता है?";s:9:"answer_hi";s:163:"हाँ, अनुपचारित संक्रमण हृदय वाल्वों को नुकसान पहुंचा सकता है।";s:10:"sort_order";i:5;}i:240;a:7:{s:2:"id";i:241;s:10:"disease_id";i:90;s:11:"question_en";s:34:"What is Peripheral Artery Disease?";s:9:"answer_en";s:73:"It is a condition where narrowed arteries reduce blood flow to the limbs.";s:11:"question_hi";s:80:"पेरिफेरल आर्टरी डिजीज क्या है?";s:9:"answer_hi";s:120:"यह स्थिति अंगों में रक्त प्रवाह कम कर देती है।";s:10:"sort_order";i:1;}i:241;a:7:{s:2:"id";i:242;s:10:"disease_id";i:90;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:44:"Leg pain during walking is a common symptom.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:119:"चलने पर पैरों में दर्द इसका सामान्य लक्षण है।";s:10:"sort_order";i:2;}i:242;a:7:{s:2:"id";i:243;s:10:"disease_id";i:90;s:11:"question_en";s:38:"What causes Peripheral Artery Disease?";s:9:"answer_en";s:41:"Atherosclerosis is the most common cause.";s:11:"question_hi";s:68:"इसके प्रमुख कारण क्या हैं?";s:9:"answer_hi";s:112:"धमनियों में प्लाक जमना इसका मुख्य कारण है।";s:10:"sort_order";i:3;}i:243;a:7:{s:2:"id";i:244;s:10:"disease_id";i:90;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:59:"Ankle-brachial index and Doppler studies are commonly used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:128:"एंकल-ब्रैकियल इंडेक्स और डॉप्लर जांच की जाती है।";s:10:"sort_order";i:4;}i:244;a:7:{s:2:"id";i:245;s:10:"disease_id";i:90;s:11:"question_en";s:20:"Can it be prevented?";s:9:"answer_en";s:57:"Yes, avoiding smoking and controlling risk factors helps.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:174:"हाँ, धूम्रपान छोड़ने और जोखिम कारक नियंत्रित करने से बचाव संभव है।";s:10:"sort_order";i:5;}i:245;a:7:{s:2:"id";i:246;s:10:"disease_id";i:93;s:11:"question_en";s:28:"What is Sickle Cell Disease?";s:9:"answer_en";s:60:"It is an inherited blood disorder affecting red blood cells.";s:11:"question_hi";s:53:"सिकल सेल रोग क्या है?";s:9:"answer_hi";s:176:"यह लाल रक्त कोशिकाओं को प्रभावित करने वाला आनुवंशिक रक्त विकार है।";s:10:"sort_order";i:1;}i:246;a:7:{s:2:"id";i:247;s:10:"disease_id";i:93;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:56:"Pain crises, fatigue, anemia, and infections are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:129:"दर्द, थकान, एनीमिया और संक्रमण सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:247;a:7:{s:2:"id";i:248;s:10:"disease_id";i:93;s:11:"question_en";s:34:"Is Sickle Cell Disease hereditary?";s:9:"answer_en";s:57:"Yes, it is passed from parents to children through genes.";s:11:"question_hi";s:62:"क्या यह आनुवंशिक रोग है?";s:9:"answer_hi";s:131:"हाँ, यह माता-पिता से बच्चों में जीन द्वारा जाता है।";s:10:"sort_order";i:3;}i:248;a:7:{s:2:"id";i:249;s:10:"disease_id";i:93;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:52:"Blood tests and hemoglobin electrophoresis are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:146:"रक्त परीक्षण और हीमोग्लोबिन इलेक्ट्रोफोरेसिस द्वारा।";s:10:"sort_order";i:4;}i:249;a:7:{s:2:"id";i:250;s:10:"disease_id";i:93;s:11:"question_en";s:16:"Can it be cured?";s:9:"answer_en";s:57:"Some patients may benefit from stem cell transplantation.";s:11:"question_hi";s:80:"क्या यह पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:153:"कुछ रोगियों में स्टेम सेल प्रत्यारोपण लाभकारी हो सकता है।";s:10:"sort_order";i:5;}i:250;a:7:{s:2:"id";i:251;s:10:"disease_id";i:94;s:11:"question_en";s:20:"What is Thalassemia?";s:9:"answer_en";s:69:"Thalassemia is an inherited disorder affecting hemoglobin production.";s:11:"question_hi";s:51:"थैलेसीमिया क्या है?";s:9:"answer_hi";s:171:"यह हीमोग्लोबिन निर्माण को प्रभावित करने वाला आनुवंशिक विकार है।";s:10:"sort_order";i:1;}i:251;a:7:{s:2:"id";i:252;s:10:"disease_id";i:94;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:59:"Anemia, weakness, pale skin, and growth problems may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:171:"एनीमिया, कमजोरी, पीली त्वचा और विकास संबंधी समस्याएं हो सकती हैं।";s:10:"sort_order";i:2;}i:252;a:7:{s:2:"id";i:253;s:10:"disease_id";i:94;s:11:"question_en";s:25:"Is Thalassemia inherited?";s:9:"answer_en";s:42:"Yes, it is inherited from carrier parents.";s:11:"question_hi";s:76:"क्या थैलेसीमिया आनुवंशिक है?";s:9:"answer_hi";s:105:"हाँ, यह माता-पिता से विरासत में मिलता है।";s:10:"sort_order";i:3;}i:253;a:7:{s:2:"id";i:254;s:10:"disease_id";i:94;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:50:"Blood tests and genetic testing are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:101:"रक्त परीक्षण और आनुवंशिक जांच द्वारा।";s:10:"sort_order";i:4;}i:254;a:7:{s:2:"id";i:255;s:10:"disease_id";i:94;s:11:"question_en";s:29:"Can Thalassemia be prevented?";s:9:"answer_en";s:49:"Genetic counseling and screening can reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:127:"आनुवंशिक परामर्श और स्क्रीनिंग मदद कर सकते हैं।";s:10:"sort_order";i:5;}i:255;a:7:{s:2:"id";i:256;s:10:"disease_id";i:95;s:11:"question_en";s:19:"What is Hemophilia?";s:9:"answer_en";s:71:"Hemophilia is a bleeding disorder caused by clotting factor deficiency.";s:11:"question_hi";s:51:"हीमोफीलिया क्या है?";s:9:"answer_hi";s:168:"यह रक्त जमने वाले कारकों की कमी से होने वाला रक्तस्राव विकार है।";s:10:"sort_order";i:1;}i:256;a:7:{s:2:"id";i:257;s:10:"disease_id";i:95;s:11:"question_en";s:34:"What symptoms occur in Hemophilia?";s:9:"answer_en";s:65:"Easy bruising, prolonged bleeding, and joint bleeding are common.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:171:"आसानी से खून बहना, लंबे समय तक रक्तस्राव और जोड़ों में रक्तस्राव।";s:10:"sort_order";i:2;}i:257;a:7:{s:2:"id";i:258;s:10:"disease_id";i:95;s:11:"question_en";s:25:"Is Hemophilia hereditary?";s:9:"answer_en";s:41:"Yes, it is usually inherited genetically.";s:11:"question_hi";s:52:"क्या यह आनुवंशिक है?";s:9:"answer_hi";s:93:"हाँ, यह सामान्यतः आनुवंशिक होता है।";s:10:"sort_order";i:3;}i:258;a:7:{s:2:"id";i:259;s:10:"disease_id";i:95;s:11:"question_en";s:28:"How is Hemophilia diagnosed?";s:9:"answer_en";s:49:"Clotting factor tests and blood studies are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:120:"क्लॉटिंग फैक्टर परीक्षण और रक्त जांच द्वारा।";s:10:"sort_order";i:4;}i:259;a:7:{s:2:"id";i:260;s:10:"disease_id";i:95;s:11:"question_en";s:45:"Can people with Hemophilia live normal lives?";s:9:"answer_en";s:54:"With proper treatment many patients live active lives.";s:11:"question_hi";s:91:"क्या रोगी सामान्य जीवन जी सकते हैं?";s:9:"answer_hi";s:123:"उचित उपचार से कई रोगी सामान्य जीवन जी सकते हैं।";s:10:"sort_order";i:5;}i:260;a:7:{s:2:"id";i:261;s:10:"disease_id";i:96;s:11:"question_en";s:17:"What is Leukemia?";s:9:"answer_en";s:53:"Leukemia is a cancer affecting blood and bone marrow.";s:11:"question_hi";s:51:"ल्यूकेमिया क्या है?";s:9:"answer_hi";s:91:"यह रक्त और अस्थि मज्जा का कैंसर है।";s:10:"sort_order";i:1;}i:261;a:7:{s:2:"id";i:262;s:10:"disease_id";i:96;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:61:"Fatigue, infections, bleeding, and fever are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:138:"थकान, संक्रमण, रक्तस्राव और बुखार सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:262;a:7:{s:2:"id";i:263;s:10:"disease_id";i:96;s:11:"question_en";s:26:"How is Leukemia diagnosed?";s:9:"answer_en";s:49:"Blood tests and bone marrow examination are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:99:"रक्त परीक्षण और बोन मैरो जांच द्वारा।";s:10:"sort_order";i:3;}i:263;a:7:{s:2:"id";i:264;s:10:"disease_id";i:96;s:11:"question_en";s:24:"Can Leukemia be treated?";s:9:"answer_en";s:74:"Treatment may include chemotherapy, targeted therapy, and transplantation.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:150:"कीमोथेरेपी, लक्षित उपचार और प्रत्यारोपण किया जा सकता है।";s:10:"sort_order";i:4;}i:264;a:7:{s:2:"id";i:265;s:10:"disease_id";i:96;s:11:"question_en";s:23:"Is Leukemia contagious?";s:9:"answer_en";s:51:"No, leukemia does not spread from person to person.";s:11:"question_hi";s:76:"क्या ल्यूकेमिया संक्रामक है?";s:9:"answer_hi";s:113:"नहीं, यह व्यक्ति से व्यक्ति में नहीं फैलता।";s:10:"sort_order";i:5;}i:265;a:7:{s:2:"id";i:266;s:10:"disease_id";i:97;s:11:"question_en";s:17:"What is Lymphoma?";s:9:"answer_en";s:45:"Lymphoma is a cancer of the lymphatic system.";s:11:"question_hi";s:45:"लिम्फोमा क्या है?";s:9:"answer_hi";s:71:"यह लसीका तंत्र का कैंसर है।";s:10:"sort_order";i:1;}i:266;a:7:{s:2:"id";i:267;s:10:"disease_id";i:97;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:68:"Swollen lymph nodes, fever, night sweats, and weight loss may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:148:"लिम्फ नोड्स में सूजन, बुखार, रात में पसीना और वजन कम होना।";s:10:"sort_order";i:2;}i:267;a:7:{s:2:"id";i:268;s:10:"disease_id";i:97;s:11:"question_en";s:26:"How is Lymphoma diagnosed?";s:9:"answer_en";s:43:"Biopsy and imaging tests are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:88:"बायोप्सी और इमेजिंग जांच द्वारा।";s:10:"sort_order";i:3;}i:268;a:7:{s:2:"id";i:269;s:10:"disease_id";i:97;s:11:"question_en";s:22:"Can Lymphoma be cured?";s:9:"answer_en";s:37:"Many cases respond well to treatment.";s:11:"question_hi";s:75:"क्या लिम्फोमा ठीक हो सकता है?";s:9:"answer_hi";s:96:"कई मामलों में उपचार प्रभावी होता है।";s:10:"sort_order";i:4;}i:269;a:7:{s:2:"id";i:270;s:10:"disease_id";i:97;s:11:"question_en";s:30:"What treatments are available?";s:9:"answer_en";s:70:"Chemotherapy, radiation therapy, and targeted therapies are available.";s:11:"question_hi";s:72:"कौन-कौन से उपचार उपलब्ध हैं?";s:9:"answer_hi";s:142:"कीमोथेरेपी, रेडियोथेरेपी और लक्षित उपचार उपलब्ध हैं।";s:10:"sort_order";i:5;}i:270;a:7:{s:2:"id";i:271;s:10:"disease_id";i:98;s:11:"question_en";s:25:"What is Multiple Myeloma?";s:9:"answer_en";s:50:"It is a cancer of plasma cells in the bone marrow.";s:11:"question_hi";s:64:"मल्टीपल मायलोमा क्या है?";s:9:"answer_hi";s:128:"यह अस्थि मज्जा की प्लाज्मा कोशिकाओं का कैंसर है।";s:10:"sort_order";i:1;}i:271;a:7:{s:2:"id";i:272;s:10:"disease_id";i:98;s:11:"question_en";s:25:"What symptoms are common?";s:9:"answer_en";s:62:"Bone pain, fatigue, infections, and kidney problems may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:175:"हड्डियों में दर्द, थकान, संक्रमण और गुर्दे की समस्याएं हो सकती हैं।";s:10:"sort_order";i:2;}i:272;a:7:{s:2:"id";i:273;s:10:"disease_id";i:98;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:54:"Blood tests, bone marrow biopsy, and imaging are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:134:"रक्त परीक्षण, बोन मैरो बायोप्सी और इमेजिंग द्वारा।";s:10:"sort_order";i:3;}i:273;a:7:{s:2:"id";i:274;s:10:"disease_id";i:98;s:11:"question_en";s:30:"Can Multiple Myeloma be cured?";s:9:"answer_en";s:64:"It is usually manageable but often requires long-term treatment.";s:11:"question_hi";s:80:"क्या यह पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:152:"आमतौर पर दीर्घकालिक उपचार द्वारा नियंत्रित किया जाता है।";s:10:"sort_order";i:4;}i:274;a:7:{s:2:"id";i:275;s:10:"disease_id";i:98;s:11:"question_en";s:30:"What treatments are available?";s:9:"answer_en";s:71:"Chemotherapy, immunotherapy, and stem cell transplantation may be used.";s:11:"question_hi";s:72:"कौन-कौन से उपचार उपलब्ध हैं?";s:9:"answer_hi";s:141:"कीमोथेरेपी, इम्यूनोथेरेपी और स्टेम सेल प्रत्यारोपण।";s:10:"sort_order";i:5;}i:275;a:7:{s:2:"id";i:276;s:10:"disease_id";i:99;s:11:"question_en";s:17:"What is HIV/AIDS?";s:9:"answer_en";s:46:"HIV is a virus that weakens the immune system.";s:11:"question_hi";s:52:"एचआईवी/एड्स क्या है?";s:9:"answer_hi";s:146:"एचआईवी प्रतिरक्षा प्रणाली को कमजोर करने वाला वायरस है।";s:10:"sort_order";i:1;}i:276;a:7:{s:2:"id";i:277;s:10:"disease_id";i:99;s:11:"question_en";s:20:"How does HIV spread?";s:9:"answer_en";s:73:"Through infected blood, sexual contact, and mother-to-child transmission.";s:11:"question_hi";s:55:"एचआईवी कैसे फैलता है?";s:9:"answer_hi";s:120:"संक्रमित रक्त, यौन संपर्क और मां से बच्चे में।";s:10:"sort_order";i:2;}i:277;a:7:{s:2:"id";i:278;s:10:"disease_id";i:99;s:11:"question_en";s:17:"Can HIV be cured?";s:9:"answer_en";s:65:"There is currently no cure, but treatment controls the infection.";s:11:"question_hi";s:92:"क्या एचआईवी पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:155:"वर्तमान में इसका पूर्ण इलाज नहीं है, लेकिन उपचार उपलब्ध है।";s:10:"sort_order";i:3;}i:278;a:7:{s:2:"id";i:279;s:10:"disease_id";i:99;s:11:"question_en";s:21:"How is HIV diagnosed?";s:9:"answer_en";s:60:"Blood tests detect HIV antibodies, antigens, and viral load.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:170:"रक्त परीक्षण द्वारा एंटीबॉडी, एंटीजन और वायरल लोड जांची जाती है।";s:10:"sort_order";i:4;}i:279;a:7:{s:2:"id";i:280;s:10:"disease_id";i:99;s:11:"question_en";s:36:"Can people with HIV live long lives?";s:9:"answer_en";s:63:"Yes, with modern treatment many people live long healthy lives.";s:11:"question_hi";s:101:"क्या एचआईवी रोगी लंबा जीवन जी सकते हैं?";s:9:"answer_hi";s:127:"हाँ, आधुनिक उपचार से लंबा और स्वस्थ जीवन संभव है।";s:10:"sort_order";i:5;}i:280;a:7:{s:2:"id";i:281;s:10:"disease_id";i:100;s:11:"question_en";s:37:"What is Systemic Lupus Erythematosus?";s:9:"answer_en";s:61:"It is a chronic autoimmune disease affecting multiple organs.";s:11:"question_hi";s:98:"सिस्टमिक ल्यूपस एरिथेमेटोसस क्या है?";s:9:"answer_hi";s:135:"यह कई अंगों को प्रभावित करने वाला ऑटोइम्यून रोग है।";s:10:"sort_order";i:1;}i:281;a:7:{s:2:"id";i:282;s:10:"disease_id";i:100;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:62:"Joint pain, fatigue, skin rash, and fever are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:172:"जोड़ों में दर्द, थकान, त्वचा पर चकत्ते और बुखार सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:282;a:7:{s:2:"id";i:283;s:10:"disease_id";i:100;s:11:"question_en";s:23:"How is Lupus diagnosed?";s:9:"answer_en";s:50:"ANA testing and other autoimmune markers are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:117:"एएनए परीक्षण और अन्य ऑटोइम्यून जांच द्वारा।";s:10:"sort_order";i:3;}i:283;a:7:{s:2:"id";i:284;s:10:"disease_id";i:100;s:11:"question_en";s:19:"Can Lupus be cured?";s:9:"answer_en";s:60:"There is no permanent cure, but treatment controls symptoms.";s:11:"question_hi";s:92:"क्या ल्यूपस पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:155:"स्थायी इलाज नहीं है, लेकिन लक्षण नियंत्रित किए जा सकते हैं।";s:10:"sort_order";i:4;}i:284;a:7:{s:2:"id";i:285;s:10:"disease_id";i:100;s:11:"question_en";s:29:"What organs can Lupus affect?";s:9:"answer_en";s:61:"It may affect skin, joints, kidneys, heart, and other organs.";s:11:"question_hi";s:104:"ल्यूपस किन अंगों को प्रभावित कर सकता है?";s:9:"answer_hi";s:177:"यह त्वचा, जोड़ों, गुर्दों, हृदय और अन्य अंगों को प्रभावित कर सकता है।";s:10:"sort_order";i:5;}i:285;a:7:{s:2:"id";i:286;s:10:"disease_id";i:93;s:11:"question_en";s:28:"What is Sickle Cell Disease?";s:9:"answer_en";s:60:"It is an inherited blood disorder affecting red blood cells.";s:11:"question_hi";s:53:"सिकल सेल रोग क्या है?";s:9:"answer_hi";s:176:"यह लाल रक्त कोशिकाओं को प्रभावित करने वाला आनुवंशिक रक्त विकार है।";s:10:"sort_order";i:1;}i:286;a:7:{s:2:"id";i:287;s:10:"disease_id";i:93;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:56:"Pain crises, fatigue, anemia, and infections are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:129:"दर्द, थकान, एनीमिया और संक्रमण सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:287;a:7:{s:2:"id";i:288;s:10:"disease_id";i:93;s:11:"question_en";s:34:"Is Sickle Cell Disease hereditary?";s:9:"answer_en";s:57:"Yes, it is passed from parents to children through genes.";s:11:"question_hi";s:62:"क्या यह आनुवंशिक रोग है?";s:9:"answer_hi";s:131:"हाँ, यह माता-पिता से बच्चों में जीन द्वारा जाता है।";s:10:"sort_order";i:3;}i:288;a:7:{s:2:"id";i:289;s:10:"disease_id";i:93;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:52:"Blood tests and hemoglobin electrophoresis are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:146:"रक्त परीक्षण और हीमोग्लोबिन इलेक्ट्रोफोरेसिस द्वारा।";s:10:"sort_order";i:4;}i:289;a:7:{s:2:"id";i:290;s:10:"disease_id";i:93;s:11:"question_en";s:16:"Can it be cured?";s:9:"answer_en";s:57:"Some patients may benefit from stem cell transplantation.";s:11:"question_hi";s:80:"क्या यह पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:153:"कुछ रोगियों में स्टेम सेल प्रत्यारोपण लाभकारी हो सकता है।";s:10:"sort_order";i:5;}i:290;a:7:{s:2:"id";i:291;s:10:"disease_id";i:94;s:11:"question_en";s:20:"What is Thalassemia?";s:9:"answer_en";s:69:"Thalassemia is an inherited disorder affecting hemoglobin production.";s:11:"question_hi";s:51:"थैलेसीमिया क्या है?";s:9:"answer_hi";s:171:"यह हीमोग्लोबिन निर्माण को प्रभावित करने वाला आनुवंशिक विकार है।";s:10:"sort_order";i:1;}i:291;a:7:{s:2:"id";i:292;s:10:"disease_id";i:94;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:59:"Anemia, weakness, pale skin, and growth problems may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:171:"एनीमिया, कमजोरी, पीली त्वचा और विकास संबंधी समस्याएं हो सकती हैं।";s:10:"sort_order";i:2;}i:292;a:7:{s:2:"id";i:293;s:10:"disease_id";i:94;s:11:"question_en";s:25:"Is Thalassemia inherited?";s:9:"answer_en";s:42:"Yes, it is inherited from carrier parents.";s:11:"question_hi";s:76:"क्या थैलेसीमिया आनुवंशिक है?";s:9:"answer_hi";s:105:"हाँ, यह माता-पिता से विरासत में मिलता है।";s:10:"sort_order";i:3;}i:293;a:7:{s:2:"id";i:294;s:10:"disease_id";i:94;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:50:"Blood tests and genetic testing are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:101:"रक्त परीक्षण और आनुवंशिक जांच द्वारा।";s:10:"sort_order";i:4;}i:294;a:7:{s:2:"id";i:295;s:10:"disease_id";i:94;s:11:"question_en";s:29:"Can Thalassemia be prevented?";s:9:"answer_en";s:49:"Genetic counseling and screening can reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:127:"आनुवंशिक परामर्श और स्क्रीनिंग मदद कर सकते हैं।";s:10:"sort_order";i:5;}i:295;a:7:{s:2:"id";i:296;s:10:"disease_id";i:95;s:11:"question_en";s:19:"What is Hemophilia?";s:9:"answer_en";s:71:"Hemophilia is a bleeding disorder caused by clotting factor deficiency.";s:11:"question_hi";s:51:"हीमोफीलिया क्या है?";s:9:"answer_hi";s:168:"यह रक्त जमने वाले कारकों की कमी से होने वाला रक्तस्राव विकार है।";s:10:"sort_order";i:1;}i:296;a:7:{s:2:"id";i:297;s:10:"disease_id";i:95;s:11:"question_en";s:34:"What symptoms occur in Hemophilia?";s:9:"answer_en";s:65:"Easy bruising, prolonged bleeding, and joint bleeding are common.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:171:"आसानी से खून बहना, लंबे समय तक रक्तस्राव और जोड़ों में रक्तस्राव।";s:10:"sort_order";i:2;}i:297;a:7:{s:2:"id";i:298;s:10:"disease_id";i:95;s:11:"question_en";s:25:"Is Hemophilia hereditary?";s:9:"answer_en";s:41:"Yes, it is usually inherited genetically.";s:11:"question_hi";s:52:"क्या यह आनुवंशिक है?";s:9:"answer_hi";s:93:"हाँ, यह सामान्यतः आनुवंशिक होता है।";s:10:"sort_order";i:3;}i:298;a:7:{s:2:"id";i:299;s:10:"disease_id";i:95;s:11:"question_en";s:28:"How is Hemophilia diagnosed?";s:9:"answer_en";s:49:"Clotting factor tests and blood studies are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:120:"क्लॉटिंग फैक्टर परीक्षण और रक्त जांच द्वारा।";s:10:"sort_order";i:4;}i:299;a:7:{s:2:"id";i:300;s:10:"disease_id";i:95;s:11:"question_en";s:45:"Can people with Hemophilia live normal lives?";s:9:"answer_en";s:54:"With proper treatment many patients live active lives.";s:11:"question_hi";s:91:"क्या रोगी सामान्य जीवन जी सकते हैं?";s:9:"answer_hi";s:123:"उचित उपचार से कई रोगी सामान्य जीवन जी सकते हैं।";s:10:"sort_order";i:5;}i:300;a:7:{s:2:"id";i:301;s:10:"disease_id";i:96;s:11:"question_en";s:17:"What is Leukemia?";s:9:"answer_en";s:53:"Leukemia is a cancer affecting blood and bone marrow.";s:11:"question_hi";s:51:"ल्यूकेमिया क्या है?";s:9:"answer_hi";s:91:"यह रक्त और अस्थि मज्जा का कैंसर है।";s:10:"sort_order";i:1;}i:301;a:7:{s:2:"id";i:302;s:10:"disease_id";i:96;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:61:"Fatigue, infections, bleeding, and fever are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:138:"थकान, संक्रमण, रक्तस्राव और बुखार सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:302;a:7:{s:2:"id";i:303;s:10:"disease_id";i:96;s:11:"question_en";s:26:"How is Leukemia diagnosed?";s:9:"answer_en";s:49:"Blood tests and bone marrow examination are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:99:"रक्त परीक्षण और बोन मैरो जांच द्वारा।";s:10:"sort_order";i:3;}i:303;a:7:{s:2:"id";i:304;s:10:"disease_id";i:96;s:11:"question_en";s:24:"Can Leukemia be treated?";s:9:"answer_en";s:74:"Treatment may include chemotherapy, targeted therapy, and transplantation.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:150:"कीमोथेरेपी, लक्षित उपचार और प्रत्यारोपण किया जा सकता है।";s:10:"sort_order";i:4;}i:304;a:7:{s:2:"id";i:305;s:10:"disease_id";i:96;s:11:"question_en";s:23:"Is Leukemia contagious?";s:9:"answer_en";s:51:"No, leukemia does not spread from person to person.";s:11:"question_hi";s:76:"क्या ल्यूकेमिया संक्रामक है?";s:9:"answer_hi";s:113:"नहीं, यह व्यक्ति से व्यक्ति में नहीं फैलता।";s:10:"sort_order";i:5;}i:305;a:7:{s:2:"id";i:306;s:10:"disease_id";i:97;s:11:"question_en";s:17:"What is Lymphoma?";s:9:"answer_en";s:45:"Lymphoma is a cancer of the lymphatic system.";s:11:"question_hi";s:45:"लिम्फोमा क्या है?";s:9:"answer_hi";s:71:"यह लसीका तंत्र का कैंसर है।";s:10:"sort_order";i:1;}i:306;a:7:{s:2:"id";i:307;s:10:"disease_id";i:97;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:68:"Swollen lymph nodes, fever, night sweats, and weight loss may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:148:"लिम्फ नोड्स में सूजन, बुखार, रात में पसीना और वजन कम होना।";s:10:"sort_order";i:2;}i:307;a:7:{s:2:"id";i:308;s:10:"disease_id";i:97;s:11:"question_en";s:26:"How is Lymphoma diagnosed?";s:9:"answer_en";s:43:"Biopsy and imaging tests are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:88:"बायोप्सी और इमेजिंग जांच द्वारा।";s:10:"sort_order";i:3;}i:308;a:7:{s:2:"id";i:309;s:10:"disease_id";i:97;s:11:"question_en";s:22:"Can Lymphoma be cured?";s:9:"answer_en";s:37:"Many cases respond well to treatment.";s:11:"question_hi";s:75:"क्या लिम्फोमा ठीक हो सकता है?";s:9:"answer_hi";s:96:"कई मामलों में उपचार प्रभावी होता है।";s:10:"sort_order";i:4;}i:309;a:7:{s:2:"id";i:310;s:10:"disease_id";i:97;s:11:"question_en";s:30:"What treatments are available?";s:9:"answer_en";s:70:"Chemotherapy, radiation therapy, and targeted therapies are available.";s:11:"question_hi";s:72:"कौन-कौन से उपचार उपलब्ध हैं?";s:9:"answer_hi";s:142:"कीमोथेरेपी, रेडियोथेरेपी और लक्षित उपचार उपलब्ध हैं।";s:10:"sort_order";i:5;}i:310;a:7:{s:2:"id";i:311;s:10:"disease_id";i:98;s:11:"question_en";s:25:"What is Multiple Myeloma?";s:9:"answer_en";s:50:"It is a cancer of plasma cells in the bone marrow.";s:11:"question_hi";s:64:"मल्टीपल मायलोमा क्या है?";s:9:"answer_hi";s:128:"यह अस्थि मज्जा की प्लाज्मा कोशिकाओं का कैंसर है।";s:10:"sort_order";i:1;}i:311;a:7:{s:2:"id";i:312;s:10:"disease_id";i:98;s:11:"question_en";s:25:"What symptoms are common?";s:9:"answer_en";s:62:"Bone pain, fatigue, infections, and kidney problems may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:175:"हड्डियों में दर्द, थकान, संक्रमण और गुर्दे की समस्याएं हो सकती हैं।";s:10:"sort_order";i:2;}i:312;a:7:{s:2:"id";i:313;s:10:"disease_id";i:98;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:54:"Blood tests, bone marrow biopsy, and imaging are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:134:"रक्त परीक्षण, बोन मैरो बायोप्सी और इमेजिंग द्वारा।";s:10:"sort_order";i:3;}i:313;a:7:{s:2:"id";i:314;s:10:"disease_id";i:98;s:11:"question_en";s:30:"Can Multiple Myeloma be cured?";s:9:"answer_en";s:64:"It is usually manageable but often requires long-term treatment.";s:11:"question_hi";s:80:"क्या यह पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:152:"आमतौर पर दीर्घकालिक उपचार द्वारा नियंत्रित किया जाता है।";s:10:"sort_order";i:4;}i:314;a:7:{s:2:"id";i:315;s:10:"disease_id";i:98;s:11:"question_en";s:30:"What treatments are available?";s:9:"answer_en";s:71:"Chemotherapy, immunotherapy, and stem cell transplantation may be used.";s:11:"question_hi";s:72:"कौन-कौन से उपचार उपलब्ध हैं?";s:9:"answer_hi";s:141:"कीमोथेरेपी, इम्यूनोथेरेपी और स्टेम सेल प्रत्यारोपण।";s:10:"sort_order";i:5;}i:315;a:7:{s:2:"id";i:316;s:10:"disease_id";i:99;s:11:"question_en";s:17:"What is HIV/AIDS?";s:9:"answer_en";s:46:"HIV is a virus that weakens the immune system.";s:11:"question_hi";s:52:"एचआईवी/एड्स क्या है?";s:9:"answer_hi";s:146:"एचआईवी प्रतिरक्षा प्रणाली को कमजोर करने वाला वायरस है।";s:10:"sort_order";i:1;}i:316;a:7:{s:2:"id";i:317;s:10:"disease_id";i:99;s:11:"question_en";s:20:"How does HIV spread?";s:9:"answer_en";s:73:"Through infected blood, sexual contact, and mother-to-child transmission.";s:11:"question_hi";s:55:"एचआईवी कैसे फैलता है?";s:9:"answer_hi";s:120:"संक्रमित रक्त, यौन संपर्क और मां से बच्चे में।";s:10:"sort_order";i:2;}i:317;a:7:{s:2:"id";i:318;s:10:"disease_id";i:99;s:11:"question_en";s:17:"Can HIV be cured?";s:9:"answer_en";s:65:"There is currently no cure, but treatment controls the infection.";s:11:"question_hi";s:92:"क्या एचआईवी पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:155:"वर्तमान में इसका पूर्ण इलाज नहीं है, लेकिन उपचार उपलब्ध है।";s:10:"sort_order";i:3;}i:318;a:7:{s:2:"id";i:319;s:10:"disease_id";i:99;s:11:"question_en";s:21:"How is HIV diagnosed?";s:9:"answer_en";s:60:"Blood tests detect HIV antibodies, antigens, and viral load.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:170:"रक्त परीक्षण द्वारा एंटीबॉडी, एंटीजन और वायरल लोड जांची जाती है।";s:10:"sort_order";i:4;}i:319;a:7:{s:2:"id";i:320;s:10:"disease_id";i:99;s:11:"question_en";s:36:"Can people with HIV live long lives?";s:9:"answer_en";s:63:"Yes, with modern treatment many people live long healthy lives.";s:11:"question_hi";s:101:"क्या एचआईवी रोगी लंबा जीवन जी सकते हैं?";s:9:"answer_hi";s:127:"हाँ, आधुनिक उपचार से लंबा और स्वस्थ जीवन संभव है।";s:10:"sort_order";i:5;}i:320;a:7:{s:2:"id";i:321;s:10:"disease_id";i:100;s:11:"question_en";s:37:"What is Systemic Lupus Erythematosus?";s:9:"answer_en";s:61:"It is a chronic autoimmune disease affecting multiple organs.";s:11:"question_hi";s:98:"सिस्टमिक ल्यूपस एरिथेमेटोसस क्या है?";s:9:"answer_hi";s:135:"यह कई अंगों को प्रभावित करने वाला ऑटोइम्यून रोग है।";s:10:"sort_order";i:1;}i:321;a:7:{s:2:"id";i:322;s:10:"disease_id";i:100;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:62:"Joint pain, fatigue, skin rash, and fever are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:172:"जोड़ों में दर्द, थकान, त्वचा पर चकत्ते और बुखार सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:322;a:7:{s:2:"id";i:323;s:10:"disease_id";i:100;s:11:"question_en";s:23:"How is Lupus diagnosed?";s:9:"answer_en";s:50:"ANA testing and other autoimmune markers are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:117:"एएनए परीक्षण और अन्य ऑटोइम्यून जांच द्वारा।";s:10:"sort_order";i:3;}i:323;a:7:{s:2:"id";i:324;s:10:"disease_id";i:100;s:11:"question_en";s:19:"Can Lupus be cured?";s:9:"answer_en";s:60:"There is no permanent cure, but treatment controls symptoms.";s:11:"question_hi";s:92:"क्या ल्यूपस पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:155:"स्थायी इलाज नहीं है, लेकिन लक्षण नियंत्रित किए जा सकते हैं।";s:10:"sort_order";i:4;}i:324;a:7:{s:2:"id";i:325;s:10:"disease_id";i:100;s:11:"question_en";s:29:"What organs can Lupus affect?";s:9:"answer_en";s:61:"It may affect skin, joints, kidneys, heart, and other organs.";s:11:"question_hi";s:104:"ल्यूपस किन अंगों को प्रभावित कर सकता है?";s:9:"answer_hi";s:177:"यह त्वचा, जोड़ों, गुर्दों, हृदय और अन्य अंगों को प्रभावित कर सकता है।";s:10:"sort_order";i:5;}i:325;a:7:{s:2:"id";i:326;s:10:"disease_id";i:102;s:11:"question_en";s:18:"What is Gastritis?";s:9:"answer_en";s:48:"Gastritis is inflammation of the stomach lining.";s:11:"question_hi";s:57:"गैस्ट्राइटिस क्या है?";s:9:"answer_hi";s:115:"गैस्ट्राइटिस पेट की अंदरूनी परत की सूजन है।";s:10:"sort_order";i:1;}i:326;a:7:{s:2:"id";i:327;s:10:"disease_id";i:102;s:11:"question_en";s:38:"What are common symptoms of Gastritis?";s:9:"answer_en";s:65:"Symptoms include stomach pain, nausea, bloating, and indigestion.";s:11:"question_hi";s:105:"गैस्ट्राइटिस के सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:128:"पेट दर्द, मतली, गैस और अपच इसके सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:327;a:7:{s:2:"id";i:328;s:10:"disease_id";i:102;s:11:"question_en";s:22:"What causes Gastritis?";s:9:"answer_en";s:72:"Common causes include H. pylori infection, alcohol, and NSAID medicines.";s:11:"question_hi";s:80:"गैस्ट्राइटिस के कारण क्या हैं?";s:9:"answer_hi";s:179:"एच. पाइलोरी संक्रमण, शराब और दर्द निवारक दवाएं इसके कारण हो सकती हैं।";s:10:"sort_order";i:3;}i:328;a:7:{s:2:"id";i:329;s:10:"disease_id";i:102;s:11:"question_en";s:27:"How is Gastritis diagnosed?";s:9:"answer_en";s:53:"Diagnosis may involve endoscopy and laboratory tests.";s:11:"question_hi";s:106:"गैस्ट्राइटिस का निदान कैसे किया जाता है?";s:9:"answer_hi";s:167:"एंडोस्कोपी और प्रयोगशाला परीक्षणों द्वारा निदान किया जाता है।";s:10:"sort_order";i:4;}i:329;a:7:{s:2:"id";i:330;s:10:"disease_id";i:102;s:11:"question_en";s:27:"Can Gastritis be prevented?";s:9:"answer_en";s:50:"Avoid smoking, alcohol, and unnecessary NSAID use.";s:11:"question_hi";s:90:"क्या गैस्ट्राइटिस से बचाव संभव है?";s:9:"answer_hi";s:154:"धूम्रपान, शराब और अनावश्यक दर्द निवारक दवाओं से बचाव करें।";s:10:"sort_order";i:5;}i:330;a:7:{s:2:"id";i:331;s:10:"disease_id";i:104;s:11:"question_en";s:23:"What is Stomach Cancer?";s:9:"answer_en";s:60:"It is a malignant tumor that develops in the stomach lining.";s:11:"question_hi";s:53:"पेट का कैंसर क्या है?";s:9:"answer_hi";s:127:"यह पेट की परत में विकसित होने वाला घातक कैंसर है।";s:10:"sort_order";i:1;}i:331;a:7:{s:2:"id";i:332;s:10:"disease_id";i:104;s:11:"question_en";s:43:"What are common symptoms of Stomach Cancer?";s:9:"answer_en";s:66:"Weight loss, stomach pain, nausea, and loss of appetite may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:127:"वजन घटना, पेट दर्द, मतली और भूख कम लगना हो सकता है।";s:10:"sort_order";i:2;}i:332;a:7:{s:2:"id";i:333;s:10:"disease_id";i:104;s:11:"question_en";s:33:"Who is at risk of Stomach Cancer?";s:9:"answer_en";s:63:"Smoking, H. pylori infection, and family history increase risk.";s:11:"question_hi";s:85:"किन लोगों में जोखिम अधिक होता है?";s:9:"answer_hi";s:179:"धूम्रपान, एच. पाइलोरी संक्रमण और पारिवारिक इतिहास जोखिम बढ़ाते हैं।";s:10:"sort_order";i:3;}i:333;a:7:{s:2:"id";i:334;s:10:"disease_id";i:104;s:11:"question_en";s:32:"How is Stomach Cancer diagnosed?";s:9:"answer_en";s:39:"Endoscopy and biopsy are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:133:"एंडोस्कोपी और बायोप्सी द्वारा निदान किया जाता है।";s:10:"sort_order";i:4;}i:334;a:7:{s:2:"id";i:335;s:10:"disease_id";i:104;s:11:"question_en";s:30:"Can Stomach Cancer be treated?";s:9:"answer_en";s:67:"Treatment may include surgery, chemotherapy, and radiation therapy.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:160:"सर्जरी, कीमोथेरेपी और रेडियोथेरेपी से उपचार किया जा सकता है।";s:10:"sort_order";i:5;}i:335;a:7:{s:2:"id";i:336;s:10:"disease_id";i:105;s:11:"question_en";s:24:"What is Gastroenteritis?";s:9:"answer_en";s:79:"It is inflammation of the stomach and intestines causing diarrhea and vomiting.";s:11:"question_hi";s:75:"गैस्ट्रोएंटेराइटिस क्या है?";s:9:"answer_hi";s:141:"यह पेट और आंतों की सूजन है जिससे दस्त और उल्टी होती है।";s:10:"sort_order";i:1;}i:336;a:7:{s:2:"id";i:337;s:10:"disease_id";i:105;s:11:"question_en";s:28:"What causes Gastroenteritis?";s:9:"answer_en";s:61:"Viral, bacterial, and parasitic infections are common causes.";s:11:"question_hi";s:98:"गैस्ट्रोएंटेराइटिस के कारण क्या हैं?";s:9:"answer_hi";s:134:"वायरल, बैक्टीरियल और परजीवी संक्रमण इसके कारण हैं।";s:10:"sort_order";i:2;}i:337;a:7:{s:2:"id";i:338;s:10:"disease_id";i:105;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:58:"Diarrhea, vomiting, fever, and abdominal cramps may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:106:"दस्त, उल्टी, बुखार और पेट दर्द हो सकता है।";s:10:"sort_order";i:3;}i:338;a:7:{s:2:"id";i:339;s:10:"disease_id";i:105;s:11:"question_en";s:31:"How is Gastroenteritis treated?";s:9:"answer_en";s:44:"Hydration and supportive care are important.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:117:"पर्याप्त तरल और सहायक उपचार महत्वपूर्ण हैं।";s:10:"sort_order";i:4;}i:339;a:7:{s:2:"id";i:340;s:10:"disease_id";i:105;s:11:"question_en";s:37:"How can Gastroenteritis be prevented?";s:9:"answer_en";s:54:"Practice good hygiene and consume safe food and water.";s:11:"question_hi";s:79:"इससे बचाव कैसे किया जा सकता है?";s:9:"answer_hi";s:144:"स्वच्छता रखें और सुरक्षित भोजन तथा पानी का उपयोग करें।";s:10:"sort_order";i:5;}i:340;a:7:{s:2:"id";i:341;s:10:"disease_id";i:107;s:11:"question_en";s:32:"What is Alcoholic Liver Disease?";s:9:"answer_en";s:59:"It is liver damage caused by excessive alcohol consumption.";s:11:"question_hi";s:74:"अल्कोहॉलिक लिवर रोग क्या है?";s:9:"answer_hi";s:126:"यह अत्यधिक शराब सेवन से होने वाली यकृत क्षति है।";s:10:"sort_order";i:1;}i:341;a:7:{s:2:"id";i:342;s:10:"disease_id";i:107;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:62:"Fatigue, jaundice, abdominal swelling, and weakness may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:122:"थकान, पीलिया, पेट में सूजन और कमजोरी हो सकती है।";s:10:"sort_order";i:2;}i:342;a:7:{s:2:"id";i:343;s:10:"disease_id";i:107;s:11:"question_en";s:40:"Can Alcoholic Liver Disease be reversed?";s:9:"answer_en";s:58:"Early stages may improve if alcohol is completely stopped.";s:11:"question_hi";s:57:"क्या यह ठीक हो सकता है?";s:9:"answer_hi";s:134:"प्रारंभिक अवस्था में शराब छोड़ने पर सुधार संभव है।";s:10:"sort_order";i:3;}i:343;a:7:{s:2:"id";i:344;s:10:"disease_id";i:107;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:59:"Liver function tests and imaging studies are commonly used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:98:"लिवर फंक्शन टेस्ट और इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:344;a:7:{s:2:"id";i:345;s:10:"disease_id";i:107;s:11:"question_en";s:24:"How can it be prevented?";s:9:"answer_en";s:36:"Avoid excessive alcohol consumption.";s:11:"question_hi";s:79:"इससे बचाव कैसे किया जा सकता है?";s:9:"answer_hi";s:70:"अत्यधिक शराब सेवन से बचें।";s:10:"sort_order";i:5;}i:345;a:7:{s:2:"id";i:346;s:10:"disease_id";i:108;s:11:"question_en";s:20:"What is Hepatitis A?";s:9:"answer_en";s:47:"It is a viral infection that affects the liver.";s:11:"question_hi";s:55:"हेपेटाइटिस ए क्या है?";s:9:"answer_hi";s:125:"यह यकृत को प्रभावित करने वाला वायरल संक्रमण है।";s:10:"sort_order";i:1;}i:346;a:7:{s:2:"id";i:347;s:10:"disease_id";i:108;s:11:"question_en";s:28:"How does Hepatitis A spread?";s:9:"answer_en";s:47:"It spreads through contaminated food and water.";s:11:"question_hi";s:71:"हेपेटाइटिस ए कैसे फैलता है?";s:9:"answer_hi";s:88:"यह दूषित भोजन और पानी से फैलता है।";s:10:"sort_order";i:2;}i:347;a:7:{s:2:"id";i:348;s:10:"disease_id";i:108;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:47:"Jaundice, fever, nausea, and fatigue may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:99:"पीलिया, बुखार, मतली और थकान हो सकती है।";s:10:"sort_order";i:3;}i:348;a:7:{s:2:"id";i:349;s:10:"disease_id";i:108;s:11:"question_en";s:29:"Can Hepatitis A be prevented?";s:9:"answer_en";s:63:"Yes, vaccination and hygiene are effective preventive measures.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:107:"हाँ, टीकाकरण और स्वच्छता से बचाव संभव है।";s:10:"sort_order";i:4;}i:349;a:7:{s:2:"id";i:350;s:10:"disease_id";i:108;s:11:"question_en";s:32:"Does Hepatitis A become chronic?";s:9:"answer_en";s:39:"No, it usually does not become chronic.";s:11:"question_hi";s:81:"क्या यह दीर्घकालिक रोग बनता है?";s:9:"answer_hi";s:108:"नहीं, यह सामान्यतः दीर्घकालिक नहीं बनता।";s:10:"sort_order";i:5;}i:350;a:7:{s:2:"id";i:351;s:10:"disease_id";i:110;s:11:"question_en";s:20:"What is Hepatitis C?";s:9:"answer_en";s:61:"It is a viral infection that can cause chronic liver disease.";s:11:"question_hi";s:58:"हेपेटाइटिस सी क्या है?";s:9:"answer_hi";s:162:"यह एक वायरल संक्रमण है जो दीर्घकालिक यकृत रोग पैदा कर सकता है।";s:10:"sort_order";i:1;}i:351;a:7:{s:2:"id";i:352;s:10:"disease_id";i:110;s:11:"question_en";s:28:"How does Hepatitis C spread?";s:9:"answer_en";s:41:"It spreads mainly through infected blood.";s:11:"question_hi";s:74:"हेपेटाइटिस सी कैसे फैलता है?";s:9:"answer_hi";s:111:"यह मुख्यतः संक्रमित रक्त द्वारा फैलता है।";s:10:"sort_order";i:2;}i:352;a:7:{s:2:"id";i:353;s:10:"disease_id";i:110;s:11:"question_en";s:25:"Can Hepatitis C be cured?";s:9:"answer_en";s:59:"Many patients can be cured with modern antiviral medicines.";s:11:"question_hi";s:88:"क्या हेपेटाइटिस सी ठीक हो सकता है?";s:9:"answer_hi";s:132:"आधुनिक एंटीवायरल दवाओं से कई रोगी ठीक हो सकते हैं।";s:10:"sort_order";i:3;}i:353;a:7:{s:2:"id";i:354;s:10:"disease_id";i:110;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:56:"Blood tests detect hepatitis C antibodies and viral RNA.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:167:"रक्त परीक्षण द्वारा एंटीबॉडी और वायरल आरएनए की जांच की जाती है।";s:10:"sort_order";i:4;}i:354;a:7:{s:2:"id";i:355;s:10:"disease_id";i:110;s:11:"question_en";s:33:"How can Hepatitis C be prevented?";s:9:"answer_en";s:48:"Use sterile needles and screened blood products.";s:11:"question_hi";s:79:"इससे बचाव कैसे किया जा सकता है?";s:9:"answer_hi";s:106:"स्वच्छ सुई और जांचा हुआ रक्त उपयोग करें।";s:10:"sort_order";i:5;}i:355;a:7:{s:2:"id";i:356;s:10:"disease_id";i:111;s:11:"question_en";s:24:"What is Liver Cirrhosis?";s:9:"answer_en";s:37:"It is advanced scarring of the liver.";s:11:"question_hi";s:55:"लिवर सिरोसिस क्या है?";s:9:"answer_hi";s:129:"यह यकृत में उन्नत स्तर की क्षति और फाइब्रोसिस है।";s:10:"sort_order";i:1;}i:356;a:7:{s:2:"id";i:357;s:10:"disease_id";i:111;s:11:"question_en";s:28:"What causes Liver Cirrhosis?";s:9:"answer_en";s:54:"Alcohol abuse and chronic hepatitis are common causes.";s:11:"question_hi";s:78:"लिवर सिरोसिस के कारण क्या हैं?";s:9:"answer_hi";s:139:"शराब और दीर्घकालिक हेपेटाइटिस इसके प्रमुख कारण हैं।";s:10:"sort_order";i:2;}i:357;a:7:{s:2:"id";i:358;s:10:"disease_id";i:111;s:11:"question_en";s:33:"What symptoms occur in Cirrhosis?";s:9:"answer_en";s:52:"Jaundice, swelling, fatigue, and bleeding may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:111:"पीलिया, सूजन, थकान और रक्तस्राव हो सकता है।";s:10:"sort_order";i:3;}i:358;a:7:{s:2:"id";i:359;s:10:"disease_id";i:111;s:11:"question_en";s:23:"Can Cirrhosis be cured?";s:9:"answer_en";s:68:"Liver damage is often permanent, but treatment can slow progression.";s:11:"question_hi";s:95:"क्या सिरोसिस पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:172:"क्षति स्थायी हो सकती है लेकिन उपचार रोग की प्रगति धीमी कर सकता है।";s:10:"sort_order";i:4;}i:359;a:7:{s:2:"id";i:360;s:10:"disease_id";i:111;s:11:"question_en";s:31:"How can Cirrhosis be prevented?";s:9:"answer_en";s:51:"Avoid alcohol and treat hepatitis infections early.";s:11:"question_hi";s:79:"इससे बचाव कैसे किया जा सकता है?";s:9:"answer_hi";s:126:"शराब से बचें और हेपेटाइटिस का समय पर उपचार करें।";s:10:"sort_order";i:5;}i:360;a:7:{s:2:"id";i:361;s:10:"disease_id";i:112;s:11:"question_en";s:21:"What is Liver Cancer?";s:9:"answer_en";s:51:"It is a malignant tumor that develops in the liver.";s:11:"question_hi";s:49:"लिवर कैंसर क्या है?";s:9:"answer_hi";s:113:"यह यकृत में विकसित होने वाला घातक कैंसर है।";s:10:"sort_order";i:1;}i:361;a:7:{s:2:"id";i:362;s:10:"disease_id";i:112;s:11:"question_en";s:31:"Who is at risk of Liver Cancer?";s:9:"answer_en";s:56:"People with hepatitis and cirrhosis have increased risk.";s:11:"question_hi";s:85:"किन लोगों में जोखिम अधिक होता है?";s:9:"answer_hi";s:150:"हेपेटाइटिस और सिरोसिस वाले लोगों में जोखिम अधिक होता है।";s:10:"sort_order";i:2;}i:362;a:7:{s:2:"id";i:363;s:10:"disease_id";i:112;s:11:"question_en";s:24:"What symptoms may occur?";s:9:"answer_en";s:52:"Weight loss, abdominal pain, and jaundice may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:102:"वजन घटना, पेट दर्द और पीलिया हो सकता है।";s:10:"sort_order";i:3;}i:363;a:7:{s:2:"id";i:364;s:10:"disease_id";i:112;s:11:"question_en";s:30:"How is Liver Cancer diagnosed?";s:9:"answer_en";s:50:"Imaging tests, AFP levels, and biopsy may be used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:105:"इमेजिंग, एएफपी जांच और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:364;a:7:{s:2:"id";i:365;s:10:"disease_id";i:112;s:11:"question_en";s:28:"Can Liver Cancer be treated?";s:9:"answer_en";s:57:"Treatment may include surgery, ablation, or chemotherapy.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:157:"सर्जरी, एब्लेशन और कीमोथेरेपी द्वारा उपचार किया जा सकता है।";s:10:"sort_order";i:5;}i:365;a:7:{s:2:"id";i:366;s:10:"disease_id";i:114;s:11:"question_en";s:22:"What is Cholecystitis?";s:9:"answer_en";s:38:"It is inflammation of the gallbladder.";s:11:"question_hi";s:63:"कोलेसिस्टाइटिस क्या है?";s:9:"answer_hi";s:61:"यह पित्ताशय की सूजन है।";s:10:"sort_order";i:1;}i:366;a:7:{s:2:"id";i:367;s:10:"disease_id";i:114;s:11:"question_en";s:26:"What causes Cholecystitis?";s:9:"answer_en";s:37:"Gallstones are the most common cause.";s:11:"question_hi";s:102:"कोलेसिस्टाइटिस का प्रमुख कारण क्या है?";s:9:"answer_hi";s:106:"पित्त की पथरी इसका सबसे सामान्य कारण है।";s:10:"sort_order";i:2;}i:367;a:7:{s:2:"id";i:368;s:10:"disease_id";i:114;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:56:"Right upper abdominal pain, fever, and nausea may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:125:"दाएं ऊपरी पेट में दर्द, बुखार और मतली हो सकती है।";s:10:"sort_order";i:3;}i:368;a:7:{s:2:"id";i:369;s:10:"disease_id";i:114;s:11:"question_en";s:31:"How is Cholecystitis diagnosed?";s:9:"answer_en";s:45:"Ultrasound and blood tests are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:100:"अल्ट्रासाउंड और रक्त परीक्षण द्वारा।";s:10:"sort_order";i:4;}i:369;a:7:{s:2:"id";i:370;s:10:"disease_id";i:114;s:11:"question_en";s:34:"Can Cholecystitis require surgery?";s:9:"answer_en";s:55:"Yes, gallbladder removal may be required in some cases.";s:11:"question_hi";s:107:"क्या इसमें सर्जरी की आवश्यकता हो सकती है?";s:9:"answer_hi";s:129:"हाँ, कुछ मामलों में पित्ताशय निकालना पड़ सकता है।";s:10:"sort_order";i:5;}i:370;a:7:{s:2:"id";i:371;s:10:"disease_id";i:115;s:11:"question_en";s:21:"What is Pancreatitis?";s:9:"answer_en";s:45:"Pancreatitis is inflammation of the pancreas.";s:11:"question_hi";s:66:"पैंक्रियाटाइटिस क्या है?";s:9:"answer_hi";s:64:"यह अग्न्याशय की सूजन है।";s:10:"sort_order";i:1;}i:371;a:7:{s:2:"id";i:372;s:10:"disease_id";i:115;s:11:"question_en";s:25:"What causes Pancreatitis?";s:9:"answer_en";s:45:"Alcohol use and gallstones are common causes.";s:11:"question_hi";s:89:"पैंक्रियाटाइटिस के कारण क्या हैं?";s:9:"answer_hi";s:116:"शराब और पित्त की पथरी इसके सामान्य कारण हैं।";s:10:"sort_order";i:2;}i:372;a:7:{s:2:"id";i:373;s:10:"disease_id";i:115;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:54:"Severe abdominal pain, nausea, and vomiting may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:109:"पेट में तेज दर्द, मतली और उल्टी हो सकती है।";s:10:"sort_order";i:3;}i:373;a:7:{s:2:"id";i:374;s:10:"disease_id";i:115;s:11:"question_en";s:30:"How is Pancreatitis diagnosed?";s:9:"answer_en";s:50:"Blood tests and imaging studies are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:76:"रक्त जांच और इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:374;a:7:{s:2:"id";i:375;s:10:"disease_id";i:115;s:11:"question_en";s:30:"Can Pancreatitis be prevented?";s:9:"answer_en";s:57:"Avoid excessive alcohol and maintain a healthy lifestyle.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:127:"अत्यधिक शराब से बचें और स्वस्थ जीवनशैली अपनाएं।";s:10:"sort_order";i:5;}i:375;a:7:{s:2:"id";i:376;s:10:"disease_id";i:116;s:11:"question_en";s:26:"What is Pancreatic Cancer?";s:9:"answer_en";s:50:"It is a malignant tumor arising from the pancreas.";s:11:"question_hi";s:64:"अग्न्याशय कैंसर क्या है?";s:9:"answer_hi";s:125:"यह अग्न्याशय से विकसित होने वाला घातक कैंसर है।";s:10:"sort_order";i:1;}i:376;a:7:{s:2:"id";i:377;s:10:"disease_id";i:116;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:52:"Weight loss, jaundice, and abdominal pain may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:102:"वजन घटना, पीलिया और पेट दर्द हो सकता है।";s:10:"sort_order";i:2;}i:377;a:7:{s:2:"id";i:378;s:10:"disease_id";i:116;s:11:"question_en";s:15:"Who is at risk?";s:9:"answer_en";s:51:"Smoking, obesity, and family history increase risk.";s:11:"question_hi";s:85:"किन लोगों में जोखिम अधिक होता है?";s:9:"answer_hi";s:146:"धूम्रपान, मोटापा और पारिवारिक इतिहास जोखिम बढ़ाते हैं।";s:10:"sort_order";i:3;}i:378;a:7:{s:2:"id";i:379;s:10:"disease_id";i:116;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:57:"CT scan, MRI, endoscopic ultrasound, and biopsy are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:174:"सीटी स्कैन, एमआरआई, एंडोस्कोपिक अल्ट्रासाउंड और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:379;a:7:{s:2:"id";i:380;s:10:"disease_id";i:116;s:11:"question_en";s:33:"Can Pancreatic Cancer be treated?";s:9:"answer_en";s:66:"Treatment may include surgery, chemotherapy, and targeted therapy.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:135:"सर्जरी, कीमोथेरेपी और लक्षित उपचार किए जा सकते हैं।";s:10:"sort_order";i:5;}i:380;a:7:{s:2:"id";i:381;s:10:"disease_id";i:118;s:11:"question_en";s:22:"What is Crohn Disease?";s:9:"answer_en";s:54:"Crohn Disease is a chronic inflammatory bowel disease.";s:11:"question_hi";s:49:"क्रोहन रोग क्या है?";s:9:"answer_hi";s:108:"यह एक दीर्घकालिक सूजनयुक्त आंत्र रोग है।";s:10:"sort_order";i:1;}i:381;a:7:{s:2:"id";i:382;s:10:"disease_id";i:118;s:11:"question_en";s:37:"What symptoms occur in Crohn Disease?";s:9:"answer_en";s:53:"Diarrhea, abdominal pain, and weight loss are common.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:101:"दस्त, पेट दर्द और वजन घटना सामान्य हैं।";s:10:"sort_order";i:2;}i:382;a:7:{s:2:"id";i:383;s:10:"disease_id";i:118;s:11:"question_en";s:25:"Is Crohn Disease curable?";s:9:"answer_en";s:60:"There is no permanent cure, but treatment controls symptoms.";s:11:"question_hi";s:102:"क्या क्रोहन रोग पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:167:"इसका स्थायी इलाज नहीं है लेकिन लक्षण नियंत्रित किए जा सकते हैं।";s:10:"sort_order";i:3;}i:383;a:7:{s:2:"id";i:384;s:10:"disease_id";i:118;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:48:"Colonoscopy, biopsy, and imaging tests are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:113:"कोलोनोस्कोपी, बायोप्सी और इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:384;a:7:{s:2:"id";i:385;s:10:"disease_id";i:118;s:11:"question_en";s:35:"Can diet help manage Crohn Disease?";s:9:"answer_en";s:50:"Yes, dietary adjustments may help reduce symptoms.";s:11:"question_hi";s:70:"क्या आहार से लाभ हो सकता है?";s:9:"answer_hi";s:122:"हाँ, उचित आहार लक्षण कम करने में मदद कर सकता है।";s:10:"sort_order";i:5;}i:385;a:7:{s:2:"id";i:386;s:10:"disease_id";i:119;s:11:"question_en";s:27:"What is Ulcerative Colitis?";s:9:"answer_en";s:68:"It is a chronic inflammatory disease affecting the colon and rectum.";s:11:"question_hi";s:73:"अल्सरेटिव कोलाइटिस क्या है?";s:9:"answer_hi";s:113:"यह बड़ी आंत और मलाशय की दीर्घकालिक सूजन है।";s:10:"sort_order";i:1;}i:386;a:7:{s:2:"id";i:387;s:10:"disease_id";i:119;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:55:"Bloody diarrhea, abdominal pain, and urgency may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:139:"खूनी दस्त, पेट दर्द और बार-बार शौच की इच्छा हो सकती है।";s:10:"sort_order";i:2;}i:387;a:7:{s:2:"id";i:388;s:10:"disease_id";i:119;s:11:"question_en";s:36:"How is Ulcerative Colitis diagnosed?";s:9:"answer_en";s:41:"Colonoscopy and biopsy are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:90:"कोलोनोस्कोपी और बायोप्सी द्वारा।";s:10:"sort_order";i:3;}i:388;a:7:{s:2:"id";i:389;s:10:"disease_id";i:119;s:11:"question_en";s:32:"Can Ulcerative Colitis be cured?";s:9:"answer_en";s:50:"Treatment controls symptoms and reduces flare-ups.";s:11:"question_hi";s:80:"क्या यह पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:155:"उपचार लक्षण नियंत्रित करता है और रोग की तीव्रता कम करता है।";s:10:"sort_order";i:4;}i:389;a:7:{s:2:"id";i:390;s:10:"disease_id";i:119;s:11:"question_en";s:28:"Does stress affect symptoms?";s:9:"answer_en";s:44:"Stress may worsen symptoms in some patients.";s:11:"question_hi";s:75:"क्या तनाव लक्षण बढ़ा सकता है?";s:9:"answer_hi";s:117:"हाँ, कुछ रोगियों में तनाव लक्षण बढ़ा सकता है।";s:10:"sort_order";i:5;}i:390;a:7:{s:2:"id";i:391;s:10:"disease_id";i:120;s:11:"question_en";s:23:"What is Celiac Disease?";s:9:"answer_en";s:49:"It is an autoimmune disorder triggered by gluten.";s:11:"question_hi";s:49:"सीलिएक रोग क्या है?";s:9:"answer_hi";s:128:"यह ग्लूटेन से सक्रिय होने वाला ऑटोइम्यून रोग है।";s:10:"sort_order";i:1;}i:391;a:7:{s:2:"id";i:392;s:10:"disease_id";i:120;s:11:"question_en";s:26:"What foods contain gluten?";s:9:"answer_en";s:38:"Wheat, barley, and rye contain gluten.";s:11:"question_hi";s:103:"किन खाद्य पदार्थों में ग्लूटेन होता है?";s:9:"answer_hi";s:95:"गेहूं, जौ और राई में ग्लूटेन होता है।";s:10:"sort_order";i:2;}i:392;a:7:{s:2:"id";i:393;s:10:"disease_id";i:120;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:46:"Diarrhea, bloating, and weight loss may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:99:"दस्त, पेट फूलना और वजन घटना हो सकता है।";s:10:"sort_order";i:3;}i:393;a:7:{s:2:"id";i:394;s:10:"disease_id";i:120;s:11:"question_en";s:32:"How is Celiac Disease diagnosed?";s:9:"answer_en";s:52:"Blood tests and intestinal biopsy are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:96:"रक्त जांच और आंत की बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:394;a:7:{s:2:"id";i:395;s:10:"disease_id";i:120;s:11:"question_en";s:30:"What is the primary treatment?";s:9:"answer_en";s:47:"A strict lifelong gluten-free diet is required.";s:11:"question_hi";s:52:"मुख्य उपचार क्या है?";s:9:"answer_hi";s:98:"जीवनभर ग्लूटेन-मुक्त आहार आवश्यक है।";s:10:"sort_order";i:5;}i:395;a:7:{s:2:"id";i:396;s:10:"disease_id";i:121;s:11:"question_en";s:23:"What is Diverticulitis?";s:9:"answer_en";s:60:"It is inflammation or infection of diverticula in the colon.";s:11:"question_hi";s:69:"डाइवर्टिकुलाइटिस क्या है?";s:9:"answer_hi";s:130:"यह बड़ी आंत की छोटी थैलियों की सूजन या संक्रमण है।";s:10:"sort_order";i:1;}i:396;a:7:{s:2:"id";i:397;s:10:"disease_id";i:121;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:51:"Abdominal pain, fever, and bowel changes may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:125:"पेट दर्द, बुखार और मल त्याग में बदलाव हो सकता है।";s:10:"sort_order";i:2;}i:397;a:7:{s:2:"id";i:398;s:10:"disease_id";i:121;s:11:"question_en";s:32:"How is Diverticulitis diagnosed?";s:9:"answer_en";s:50:"CT scan and clinical evaluation are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:110:"सीटी स्कैन और चिकित्सकीय परीक्षण द्वारा।";s:10:"sort_order";i:3;}i:398;a:7:{s:2:"id";i:399;s:10:"disease_id";i:121;s:11:"question_en";s:32:"Can Diverticulitis be prevented?";s:9:"answer_en";s:39:"A high-fiber diet may help reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:107:"उच्च फाइबर वाला आहार जोखिम कम कर सकता है।";s:10:"sort_order";i:4;}i:399;a:7:{s:2:"id";i:400;s:10:"disease_id";i:121;s:11:"question_en";s:24:"Can surgery be required?";s:9:"answer_en";s:46:"Severe or recurrent cases may require surgery.";s:11:"question_hi";s:94:"क्या सर्जरी की आवश्यकता पड़ सकती है?";s:9:"answer_hi";s:178:"गंभीर या बार-बार होने वाले मामलों में सर्जरी की आवश्यकता हो सकती है।";s:10:"sort_order";i:5;}i:400;a:7:{s:2:"id";i:401;s:10:"disease_id";i:122;s:11:"question_en";s:21:"What is Appendicitis?";s:9:"answer_en";s:45:"Appendicitis is inflammation of the appendix.";s:11:"question_hi";s:57:"एपेंडिसाइटिस क्या है?";s:9:"answer_hi";s:64:"यह अपेंडिक्स की सूजन है।";s:10:"sort_order";i:1;}i:401;a:7:{s:2:"id";i:402;s:10:"disease_id";i:122;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:56:"Right lower abdominal pain, fever, and nausea may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:154:"पेट के दाएं निचले हिस्से में दर्द, बुखार और मतली हो सकती है।";s:10:"sort_order";i:2;}i:402;a:7:{s:2:"id";i:403;s:10:"disease_id";i:122;s:11:"question_en";s:29:"Is Appendicitis an emergency?";s:9:"answer_en";s:50:"Yes, urgent medical attention is usually required.";s:11:"question_hi";s:96:"क्या एपेंडिसाइटिस एक आपात स्थिति है?";s:9:"answer_hi";s:125:"हाँ, इसमें तत्काल चिकित्सा की आवश्यकता होती है।";s:10:"sort_order";i:3;}i:403;a:7:{s:2:"id";i:404;s:10:"disease_id";i:122;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:56:"Physical examination, blood tests, and imaging are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:121:"शारीरिक परीक्षण, रक्त जांच और इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:404;a:7:{s:2:"id";i:405;s:10:"disease_id";i:122;s:11:"question_en";s:28:"What is the usual treatment?";s:9:"answer_en";s:43:"Appendectomy surgery is commonly performed.";s:11:"question_hi";s:52:"मुख्य उपचार क्या है?";s:9:"answer_hi";s:128:"आमतौर पर अपेंडिक्स निकालने की सर्जरी की जाती है।";s:10:"sort_order";i:5;}i:405;a:7:{s:2:"id";i:406;s:10:"disease_id";i:123;s:11:"question_en";s:21:"What is Constipation?";s:9:"answer_en";s:55:"Constipation is infrequent or difficult bowel movement.";s:11:"question_hi";s:33:"कब्ज क्या है?";s:9:"answer_hi";s:111:"यह मल त्याग में कठिनाई या कमी की स्थिति है।";s:10:"sort_order";i:1;}i:406;a:7:{s:2:"id";i:407;s:10:"disease_id";i:123;s:11:"question_en";s:25:"What causes Constipation?";s:9:"answer_en";s:64:"Low fiber intake, dehydration, and inactivity are common causes.";s:11:"question_hi";s:56:"कब्ज के कारण क्या हैं?";s:9:"answer_hi";s:155:"कम फाइबर, पानी की कमी और निष्क्रियता इसके सामान्य कारण हैं।";s:10:"sort_order";i:2;}i:407;a:7:{s:2:"id";i:408;s:10:"disease_id";i:123;s:11:"question_en";s:33:"How can Constipation be relieved?";s:9:"answer_en";s:52:"Increase fiber, water intake, and physical activity.";s:11:"question_hi";s:76:"कब्ज से राहत कैसे मिल सकती है?";s:9:"answer_hi";s:102:"फाइबर, पानी और शारीरिक गतिविधि बढ़ाएं।";s:10:"sort_order";i:3;}i:408;a:7:{s:2:"id";i:409;s:10:"disease_id";i:123;s:11:"question_en";s:27:"When should I see a doctor?";s:9:"answer_en";s:63:"If symptoms persist or severe pain occurs, seek medical advice.";s:11:"question_hi";s:81:"डॉक्टर से कब संपर्क करना चाहिए?";s:9:"answer_hi";s:115:"यदि लक्षण लंबे समय तक रहें या तेज दर्द हो तो।";s:10:"sort_order";i:4;}i:409;a:7:{s:2:"id";i:410;s:10:"disease_id";i:123;s:11:"question_en";s:29:"Can diet affect Constipation?";s:9:"answer_en";s:45:"Yes, diet plays a major role in bowel health.";s:11:"question_hi";s:75:"क्या आहार का प्रभाव पड़ता है?";s:9:"answer_hi";s:106:"हाँ, आहार का महत्वपूर्ण प्रभाव पड़ता है।";s:10:"sort_order";i:5;}i:410;a:7:{s:2:"id";i:411;s:10:"disease_id";i:124;s:11:"question_en";s:29:"What is Chronic Constipation?";s:9:"answer_en";s:69:"It is long-term persistent constipation lasting for months or longer.";s:11:"question_hi";s:64:"दीर्घकालिक कब्ज क्या है?";s:9:"answer_hi";s:95:"यह लंबे समय तक बनी रहने वाली कब्ज है।";s:10:"sort_order";i:1;}i:411;a:7:{s:2:"id";i:412;s:10:"disease_id";i:124;s:11:"question_en";s:33:"What causes Chronic Constipation?";s:9:"answer_en";s:58:"Diet, medications, and underlying diseases may contribute.";s:11:"question_hi";s:87:"दीर्घकालिक कब्ज के कारण क्या हैं?";s:9:"answer_hi";s:118:"आहार, दवाएं और अन्य रोग इसके कारण हो सकते हैं।";s:10:"sort_order";i:2;}i:412;a:7:{s:2:"id";i:413;s:10:"disease_id";i:124;s:11:"question_en";s:38:"How is Chronic Constipation diagnosed?";s:9:"answer_en";s:64:"Medical history, examination, and specialized tests may be used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:130:"चिकित्सकीय इतिहास, परीक्षण और विशेष जांच द्वारा।";s:10:"sort_order";i:3;}i:413;a:7:{s:2:"id";i:414;s:10:"disease_id";i:124;s:11:"question_en";s:36:"Can Chronic Constipation be treated?";s:9:"answer_en";s:48:"Yes, lifestyle changes and medicines often help.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:127:"हाँ, जीवनशैली में बदलाव और दवाएं मदद कर सकती हैं।";s:10:"sort_order";i:4;}i:414;a:7:{s:2:"id";i:415;s:10:"disease_id";i:124;s:11:"question_en";s:42:"Can exercise improve Chronic Constipation?";s:9:"answer_en";s:53:"Regular physical activity may improve bowel function.";s:11:"question_hi";s:72:"क्या व्यायाम से लाभ होता है?";s:9:"answer_hi";s:161:"हाँ, नियमित व्यायाम से आंतों की कार्यक्षमता बेहतर हो सकती है।";s:10:"sort_order";i:5;}i:415;a:7:{s:2:"id";i:416;s:10:"disease_id";i:125;s:11:"question_en";s:17:"What is Diarrhea?";s:9:"answer_en";s:55:"Diarrhea is frequent passage of loose or watery stools.";s:11:"question_hi";s:33:"दस्त क्या है?";s:9:"answer_hi";s:115:"दस्त में बार-बार पतला या पानी जैसा मल आता है।";s:10:"sort_order";i:1;}i:416;a:7:{s:2:"id";i:417;s:10:"disease_id";i:125;s:11:"question_en";s:21:"What causes Diarrhea?";s:9:"answer_en";s:73:"Infections, contaminated food, and digestive disorders are common causes.";s:11:"question_hi";s:56:"दस्त के कारण क्या हैं?";s:9:"answer_hi";s:135:"संक्रमण, दूषित भोजन और पाचन विकार सामान्य कारण हैं।";s:10:"sort_order";i:2;}i:417;a:7:{s:2:"id";i:418;s:10:"disease_id";i:125;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:58:"Loose stools, abdominal cramps, and dehydration may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:111:"पतला मल, पेट दर्द और निर्जलीकरण हो सकता है।";s:10:"sort_order";i:3;}i:418;a:7:{s:2:"id";i:419;s:10:"disease_id";i:125;s:11:"question_en";s:24:"How is Diarrhea treated?";s:9:"answer_en";s:62:"Hydration and treatment of the underlying cause are important.";s:11:"question_hi";s:82:"दस्त का उपचार कैसे किया जाता है?";s:9:"answer_hi";s:106:"पर्याप्त तरल और कारण का उपचार आवश्यक है।";s:10:"sort_order";i:4;}i:419;a:7:{s:2:"id";i:420;s:10:"disease_id";i:125;s:11:"question_en";s:30:"How can Diarrhea be prevented?";s:9:"answer_en";s:54:"Practice good hygiene and consume safe food and water.";s:11:"question_hi";s:86:"दस्त से बचाव कैसे किया जा सकता है?";s:9:"answer_hi";s:131:"स्वच्छता रखें और सुरक्षित भोजन-पानी का सेवन करें।";s:10:"sort_order";i:5;}i:420;a:7:{s:2:"id";i:421;s:10:"disease_id";i:126;s:11:"question_en";s:25:"What is Chronic Diarrhea?";s:9:"answer_en";s:44:"Chronic diarrhea lasts more than four weeks.";s:11:"question_hi";s:67:"दीर्घकालिक दस्त क्या हैं?";s:9:"answer_hi";s:107:"चार सप्ताह से अधिक समय तक रहने वाले दस्त।";s:10:"sort_order";i:1;}i:421;a:7:{s:2:"id";i:422;s:10:"disease_id";i:126;s:11:"question_en";s:29:"What causes Chronic Diarrhea?";s:9:"answer_en";s:76:"Inflammatory bowel disease, infections, and malabsorption are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:162:"आंत्र सूजन रोग, संक्रमण और अवशोषण विकार इसके कारण हो सकते हैं।";s:10:"sort_order";i:2;}i:422;a:7:{s:2:"id";i:423;s:10:"disease_id";i:126;s:11:"question_en";s:40:"When should medical attention be sought?";s:9:"answer_en";s:47:"Persistent symptoms require medical evaluation.";s:11:"question_hi";s:81:"डॉक्टर से कब संपर्क करना चाहिए?";s:9:"answer_hi";s:148:"लक्षण लंबे समय तक बने रहें तो चिकित्सकीय जांच आवश्यक है।";s:10:"sort_order";i:3;}i:423;a:7:{s:2:"id";i:424;s:10:"disease_id";i:126;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:54:"Stool tests, blood tests, and colonoscopy may be used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:112:"मल जांच, रक्त जांच और कोलोनोस्कोपी द्वारा।";s:10:"sort_order";i:4;}i:424;a:7:{s:2:"id";i:425;s:10:"disease_id";i:126;s:11:"question_en";s:33:"Can diet affect Chronic Diarrhea?";s:9:"answer_en";s:48:"Yes, dietary modifications may improve symptoms.";s:11:"question_hi";s:75:"क्या आहार का प्रभाव पड़ता है?";s:9:"answer_hi";s:121:"हाँ, उचित आहार से लक्षणों में सुधार हो सकता है।";s:10:"sort_order";i:5;}i:425;a:7:{s:2:"id";i:426;s:10:"disease_id";i:127;s:11:"question_en";s:21:"What are Hemorrhoids?";s:9:"answer_en";s:52:"Hemorrhoids are swollen veins in the rectum or anus.";s:11:"question_hi";s:39:"बवासीर क्या है?";s:9:"answer_hi";s:98:"यह मलाशय या गुदा की सूजी हुई नसें हैं।";s:10:"sort_order";i:1;}i:426;a:7:{s:2:"id";i:427;s:10:"disease_id";i:127;s:11:"question_en";s:37:"What symptoms occur with Hemorrhoids?";s:9:"answer_en";s:54:"Bleeding, itching, and discomfort are common symptoms.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:115:"रक्तस्राव, खुजली और दर्द सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:427;a:7:{s:2:"id";i:428;s:10:"disease_id";i:127;s:11:"question_en";s:24:"What causes Hemorrhoids?";s:9:"answer_en";s:68:"Constipation and straining during bowel movements are common causes.";s:11:"question_hi";s:62:"बवासीर के कारण क्या हैं?";s:9:"answer_hi";s:139:"कब्ज और मल त्याग के दौरान जोर लगाना सामान्य कारण हैं।";s:10:"sort_order";i:3;}i:428;a:7:{s:2:"id";i:429;s:10:"disease_id";i:127;s:11:"question_en";s:29:"Can Hemorrhoids be prevented?";s:9:"answer_en";s:54:"A high-fiber diet and hydration may help prevent them.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:138:"फाइबर युक्त आहार और पर्याप्त पानी सहायक हो सकते हैं।";s:10:"sort_order";i:4;}i:429;a:7:{s:2:"id";i:430;s:10:"disease_id";i:127;s:11:"question_en";s:23:"When is surgery needed?";s:9:"answer_en";s:47:"Severe or persistent cases may require surgery.";s:11:"question_hi";s:65:"सर्जरी कब आवश्यक होती है?";s:9:"answer_hi";s:99:"गंभीर या लगातार रहने वाले मामलों में।";s:10:"sort_order";i:5;}i:430;a:7:{s:2:"id";i:431;s:10:"disease_id";i:128;s:11:"question_en";s:24:"What is an Anal Fissure?";s:9:"answer_en";s:45:"It is a small tear in the lining of the anus.";s:11:"question_hi";s:46:"गुदा विदर क्या है?";s:9:"answer_hi";s:82:"यह गुदा की परत में छोटा चीरा है।";s:10:"sort_order";i:1;}i:431;a:7:{s:2:"id";i:432;s:10:"disease_id";i:128;s:11:"question_en";s:28:"What causes an Anal Fissure?";s:9:"answer_en";s:47:"Hard stools and constipation are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:100:"कठोर मल और कब्ज इसके सामान्य कारण हैं।";s:10:"sort_order";i:2;}i:432;a:7:{s:2:"id";i:433;s:10:"disease_id";i:128;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:52:"Pain and bleeding during bowel movements are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:96:"मल त्याग के दौरान दर्द और रक्तस्राव।";s:10:"sort_order";i:3;}i:433;a:7:{s:2:"id";i:434;s:10:"disease_id";i:128;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:59:"Dietary changes, medicines, and sometimes surgery are used.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:97:"आहार, दवाओं और कभी-कभी सर्जरी द्वारा।";s:10:"sort_order";i:4;}i:434;a:7:{s:2:"id";i:435;s:10:"disease_id";i:128;s:11:"question_en";s:22:"Can it heal naturally?";s:9:"answer_en";s:47:"Many fissures heal with conservative treatment.";s:11:"question_hi";s:73:"क्या यह स्वयं ठीक हो सकता है?";s:9:"answer_hi";s:114:"कई मामलों में उचित देखभाल से ठीक हो सकता है।";s:10:"sort_order";i:5;}i:435;a:7:{s:2:"id";i:436;s:10:"disease_id";i:129;s:11:"question_en";s:24:"What is an Anal Fistula?";s:9:"answer_en";s:60:"It is an abnormal tunnel connecting the anal canal and skin.";s:11:"question_hi";s:36:"भगंदर क्या है?";s:9:"answer_hi";s:126:"यह गुदा नलिका और त्वचा के बीच असामान्य मार्ग है।";s:10:"sort_order";i:1;}i:436;a:7:{s:2:"id";i:437;s:10:"disease_id";i:129;s:11:"question_en";s:28:"What causes an Anal Fistula?";s:9:"answer_en";s:55:"It often develops after infection or abscess formation.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:107:"यह अक्सर संक्रमण या फोड़े के बाद बनता है।";s:10:"sort_order";i:2;}i:437;a:7:{s:2:"id";i:438;s:10:"disease_id";i:129;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:54:"Pain, swelling, and discharge near the anus may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:109:"दर्द, सूजन और गुदा के पास स्राव हो सकता है।";s:10:"sort_order";i:3;}i:438;a:7:{s:2:"id";i:439;s:10:"disease_id";i:129;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:51:"Physical examination and imaging tests may be used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:94:"शारीरिक परीक्षण और इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:439;a:7:{s:2:"id";i:440;s:10:"disease_id";i:129;s:11:"question_en";s:28:"Is surgery usually required?";s:9:"answer_en";s:43:"Yes, many cases require surgical treatment.";s:11:"question_hi";s:71:"क्या सर्जरी आवश्यक होती है?";s:9:"answer_hi";s:135:"हाँ, अधिकांश मामलों में सर्जरी की आवश्यकता होती है।";s:10:"sort_order";i:5;}i:440;a:7:{s:2:"id";i:441;s:10:"disease_id";i:130;s:11:"question_en";s:24:"What is Rectal Prolapse?";s:9:"answer_en";s:53:"It occurs when the rectum protrudes through the anus.";s:11:"question_hi";s:67:"रेक्टल प्रोलैप्स क्या है?";s:9:"answer_hi";s:97:"इसमें मलाशय गुदा से बाहर निकल आता है।";s:10:"sort_order";i:1;}i:441;a:7:{s:2:"id";i:442;s:10:"disease_id";i:130;s:11:"question_en";s:15:"Who is at risk?";s:9:"answer_en";s:69:"Older adults and people with chronic constipation are at higher risk.";s:11:"question_hi";s:85:"किन लोगों में जोखिम अधिक होता है?";s:9:"answer_hi";s:120:"बुजुर्गों और दीर्घकालिक कब्ज वाले लोगों में।";s:10:"sort_order";i:2;}i:442;a:7:{s:2:"id";i:443;s:10:"disease_id";i:130;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:62:"A visible bulge, discomfort, and bowel difficulties may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:123:"बाहर निकला भाग, असुविधा और मल त्याग में कठिनाई।";s:10:"sort_order";i:3;}i:443;a:7:{s:2:"id";i:444;s:10:"disease_id";i:130;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:43:"Physical examination is usually sufficient.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:93:"सामान्यतः शारीरिक परीक्षण द्वारा।";s:10:"sort_order";i:4;}i:444;a:7:{s:2:"id";i:445;s:10:"disease_id";i:130;s:11:"question_en";s:17:"Can surgery help?";s:9:"answer_en";s:42:"Yes, surgery is often used for correction.";s:11:"question_hi";s:69:"क्या सर्जरी से लाभ होता है?";s:9:"answer_hi";s:88:"हाँ, सुधार हेतु सर्जरी की जाती है।";s:10:"sort_order";i:5;}i:445;a:7:{s:2:"id";i:446;s:10:"disease_id";i:131;s:11:"question_en";s:21:"What is Colon Cancer?";s:9:"answer_en";s:45:"Colon cancer develops in the large intestine.";s:11:"question_hi";s:49:"कोलन कैंसर क्या है?";s:9:"answer_hi";s:110:"यह बड़ी आंत में विकसित होने वाला कैंसर है।";s:10:"sort_order";i:1;}i:446;a:7:{s:2:"id";i:447;s:10:"disease_id";i:131;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:57:"Blood in stool, weight loss, and bowel changes may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:112:"मल में रक्त, वजन घटना और मल त्याग में बदलाव।";s:10:"sort_order";i:2;}i:447;a:7:{s:2:"id";i:448;s:10:"disease_id";i:131;s:11:"question_en";s:30:"How is Colon Cancer diagnosed?";s:9:"answer_en";s:41:"Colonoscopy and biopsy are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:90:"कोलोनोस्कोपी और बायोप्सी द्वारा।";s:10:"sort_order";i:3;}i:448;a:7:{s:2:"id";i:449;s:10:"disease_id";i:131;s:11:"question_en";s:30:"Can Colon Cancer be prevented?";s:9:"answer_en";s:44:"Screening and healthy lifestyle reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:127:"स्क्रीनिंग और स्वस्थ जीवनशैली जोखिम कम करती है।";s:10:"sort_order";i:4;}i:449;a:7:{s:2:"id";i:450;s:10:"disease_id";i:131;s:11:"question_en";s:30:"What treatments are available?";s:9:"answer_en";s:56:"Surgery, chemotherapy, and targeted therapy may be used.";s:11:"question_hi";s:72:"कौन-कौन से उपचार उपलब्ध हैं?";s:9:"answer_hi";s:95:"सर्जरी, कीमोथेरेपी और लक्षित उपचार।";s:10:"sort_order";i:5;}i:450;a:7:{s:2:"id";i:451;s:10:"disease_id";i:132;s:11:"question_en";s:22:"What is Rectal Cancer?";s:9:"answer_en";s:37:"Rectal cancer develops in the rectum.";s:11:"question_hi";s:55:"रेक्टल कैंसर क्या है?";s:9:"answer_hi";s:103:"यह मलाशय में विकसित होने वाला कैंसर है।";s:10:"sort_order";i:1;}i:451;a:7:{s:2:"id";i:452;s:10:"disease_id";i:132;s:11:"question_en";s:24:"What symptoms may occur?";s:9:"answer_en";s:60:"Bleeding, bowel changes, and abdominal discomfort may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:126:"रक्तस्राव, मल त्याग में बदलाव और पेट की परेशानी।";s:10:"sort_order";i:2;}i:452;a:7:{s:2:"id";i:453;s:10:"disease_id";i:132;s:11:"question_en";s:31:"How is Rectal Cancer diagnosed?";s:9:"answer_en";s:42:"Colonoscopy, biopsy, and imaging are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:113:"कोलोनोस्कोपी, बायोप्सी और इमेजिंग द्वारा।";s:10:"sort_order";i:3;}i:453;a:7:{s:2:"id";i:454;s:10:"disease_id";i:132;s:11:"question_en";s:29:"Can Rectal Cancer be treated?";s:9:"answer_en";s:52:"Yes, surgery and cancer therapies are commonly used.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:120:"हाँ, सर्जरी और कैंसर उपचार उपयोग किए जाते हैं।";s:10:"sort_order";i:4;}i:454;a:7:{s:2:"id";i:455;s:10:"disease_id";i:132;s:11:"question_en";s:38:"Does early detection improve outcomes?";s:9:"answer_en";s:48:"Yes, early diagnosis improves treatment success.";s:11:"question_hi";s:74:"क्या शीघ्र पहचान लाभकारी है?";s:9:"answer_hi";s:111:"हाँ, समय पर निदान उपचार की सफलता बढ़ाता है।";s:10:"sort_order";i:5;}i:455;a:7:{s:2:"id";i:456;s:10:"disease_id";i:133;s:11:"question_en";s:23:"What is Food Poisoning?";s:9:"answer_en";s:66:"Food poisoning occurs after consuming contaminated food or drinks.";s:11:"question_hi";s:55:"फूड पॉइजनिंग क्या है?";s:9:"answer_hi";s:127:"यह दूषित भोजन या पेय लेने से होने वाली बीमारी है।";s:10:"sort_order";i:1;}i:456;a:7:{s:2:"id";i:457;s:10:"disease_id";i:133;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:56:"Diarrhea, vomiting, abdominal pain, and fever may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:106:"दस्त, उल्टी, पेट दर्द और बुखार हो सकता है।";s:10:"sort_order";i:2;}i:457;a:7:{s:2:"id";i:458;s:10:"disease_id";i:133;s:11:"question_en";s:34:"How long does Food Poisoning last?";s:9:"answer_en";s:37:"Most cases improve within a few days.";s:11:"question_hi";s:60:"यह कितने समय तक रहता है?";s:9:"answer_hi";s:116:"अधिकांश मामले कुछ दिनों में ठीक हो जाते हैं।";s:10:"sort_order";i:3;}i:458;a:7:{s:2:"id";i:459;s:10:"disease_id";i:133;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:44:"Hydration and supportive care are important.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:105:"पर्याप्त तरल और सहायक उपचार आवश्यक हैं।";s:10:"sort_order";i:4;}i:459;a:7:{s:2:"id";i:460;s:10:"disease_id";i:133;s:11:"question_en";s:24:"How can it be prevented?";s:9:"answer_en";s:45:"Proper food handling and hygiene reduce risk.";s:11:"question_hi";s:79:"इससे बचाव कैसे किया जा सकता है?";s:9:"answer_hi";s:108:"भोजन की स्वच्छता और सुरक्षित प्रबंधन से।";s:10:"sort_order";i:5;}i:460;a:7:{s:2:"id";i:461;s:10:"disease_id";i:134;s:11:"question_en";s:28:"What is Lactose Intolerance?";s:9:"answer_en";s:47:"It is the inability to digest lactose properly.";s:11:"question_hi";s:73:"लैक्टोज असहिष्णुता क्या है?";s:9:"answer_hi";s:125:"यह लैक्टोज को सही ढंग से न पचा पाने की स्थिति है।";s:10:"sort_order";i:1;}i:461;a:7:{s:2:"id";i:462;s:10:"disease_id";i:134;s:11:"question_en";s:42:"What symptoms occur after consuming dairy?";s:9:"answer_en";s:54:"Bloating, gas, diarrhea, and abdominal pain may occur.";s:11:"question_hi";s:86:"दूध लेने पर कौन से लक्षण होते हैं?";s:9:"answer_hi";s:110:"पेट फूलना, गैस, दस्त और पेट दर्द हो सकता है।";s:10:"sort_order";i:2;}i:462;a:7:{s:2:"id";i:463;s:10:"disease_id";i:134;s:11:"question_en";s:37:"How is Lactose Intolerance diagnosed?";s:9:"answer_en";s:49:"Dietary evaluation and lactose tests may be used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:113:"आहार मूल्यांकन और लैक्टोज परीक्षण द्वारा।";s:10:"sort_order";i:3;}i:463;a:7:{s:2:"id";i:464;s:10:"disease_id";i:134;s:11:"question_en";s:50:"Can people with Lactose Intolerance consume dairy?";s:9:"answer_en";s:60:"Some people tolerate small amounts or lactose-free products.";s:11:"question_hi";s:98:"क्या ऐसे लोग डेयरी उत्पाद ले सकते हैं?";s:9:"answer_hi";s:151:"कुछ लोग सीमित मात्रा या लैक्टोज-मुक्त उत्पाद ले सकते हैं।";s:10:"sort_order";i:4;}i:464;a:7:{s:2:"id";i:465;s:10:"disease_id";i:134;s:11:"question_en";s:30:"What is the primary treatment?";s:9:"answer_en";s:47:"Reducing lactose intake helps control symptoms.";s:11:"question_hi";s:52:"मुख्य उपचार क्या है?";s:9:"answer_hi";s:93:"लैक्टोज सेवन कम करना मुख्य उपाय है।";s:10:"sort_order";i:5;}i:465;a:7:{s:2:"id";i:466;s:10:"disease_id";i:135;s:11:"question_en";s:20:"What is Esophagitis?";s:9:"answer_en";s:45:"Esophagitis is inflammation of the esophagus.";s:11:"question_hi";s:54:"इसोफैजाइटिस क्या है?";s:9:"answer_hi";s:59:"यह भोजन नली की सूजन है।";s:10:"sort_order";i:1;}i:466;a:7:{s:2:"id";i:467;s:10:"disease_id";i:135;s:11:"question_en";s:24:"What causes Esophagitis?";s:9:"answer_en";s:60:"Acid reflux, infections, and certain medicines can cause it.";s:11:"question_hi";s:77:"इसोफैजाइटिस के कारण क्या हैं?";s:9:"answer_hi";s:152:"एसिड रिफ्लक्स, संक्रमण और कुछ दवाएं इसके कारण हो सकती हैं।";s:10:"sort_order";i:2;}i:467;a:7:{s:2:"id";i:468;s:10:"disease_id";i:135;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:60:"Heartburn, chest pain, and difficulty swallowing are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:104:"सीने में जलन, दर्द और निगलने में कठिनाई।";s:10:"sort_order";i:3;}i:468;a:7:{s:2:"id";i:469;s:10:"disease_id";i:135;s:11:"question_en";s:29:"How is Esophagitis diagnosed?";s:9:"answer_en";s:41:"Endoscopy is commonly used for diagnosis.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:101:"एंडोस्कोपी द्वारा निदान किया जाता है।";s:10:"sort_order";i:4;}i:469;a:7:{s:2:"id";i:470;s:10:"disease_id";i:135;s:11:"question_en";s:29:"Can Esophagitis be prevented?";s:9:"answer_en";s:41:"Managing acid reflux can help prevent it.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:134:"एसिड रिफ्लक्स नियंत्रित करके बचाव किया जा सकता है।";s:10:"sort_order";i:5;}i:470;a:7:{s:2:"id";i:471;s:10:"disease_id";i:136;s:11:"question_en";s:26:"What is Barrett Esophagus?";s:9:"answer_en";s:81:"It is a condition where the esophageal lining changes due to chronic acid reflux.";s:11:"question_hi";s:58:"बैरेट इसोफेगस क्या है?";s:9:"answer_hi";s:183:"यह लंबे समय तक एसिड रिफ्लक्स से भोजन नली की परत में बदलाव की स्थिति है।";s:10:"sort_order";i:1;}i:471;a:7:{s:2:"id";i:472;s:10:"disease_id";i:136;s:11:"question_en";s:29:"Is Barrett Esophagus serious?";s:9:"answer_en";s:46:"It may increase the risk of esophageal cancer.";s:11:"question_hi";s:53:"क्या यह गंभीर रोग है?";s:9:"answer_hi";s:109:"यह इसोफेजियल कैंसर का जोखिम बढ़ा सकता है।";s:10:"sort_order";i:2;}i:472;a:7:{s:2:"id";i:473;s:10:"disease_id";i:136;s:11:"question_en";s:30:"What causes Barrett Esophagus?";s:9:"answer_en";s:31:"Chronic GERD is the main cause.";s:11:"question_hi";s:68:"इसके प्रमुख कारण क्या हैं?";s:9:"answer_hi";s:104:"दीर्घकालिक जीईआरडी इसका मुख्य कारण है।";s:10:"sort_order";i:3;}i:473;a:7:{s:2:"id";i:474;s:10:"disease_id";i:136;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:39:"Endoscopy with biopsy is commonly used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:84:"एंडोस्कोपी और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:474;a:7:{s:2:"id";i:475;s:10:"disease_id";i:136;s:11:"question_en";s:33:"Can Barrett Esophagus be treated?";s:9:"answer_en";s:68:"Treatment focuses on controlling acid reflux and monitoring changes.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:172:"उपचार का लक्ष्य एसिड रिफ्लक्स नियंत्रित करना और निगरानी रखना है।";s:10:"sort_order";i:5;}i:475;a:7:{s:2:"id";i:476;s:10:"disease_id";i:137;s:11:"question_en";s:26:"What is Esophageal Cancer?";s:9:"answer_en";s:44:"Esophageal cancer develops in the food pipe.";s:11:"question_hi";s:64:"इसोफेजियल कैंसर क्या है?";s:9:"answer_hi";s:110:"यह भोजन नली में विकसित होने वाला कैंसर है।";s:10:"sort_order";i:1;}i:476;a:7:{s:2:"id";i:477;s:10:"disease_id";i:137;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:58:"Difficulty swallowing and weight loss are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:80:"निगलने में कठिनाई और वजन घटना।";s:10:"sort_order";i:2;}i:477;a:7:{s:2:"id";i:478;s:10:"disease_id";i:137;s:11:"question_en";s:24:"What increases the risk?";s:9:"answer_en";s:51:"Smoking, alcohol, and chronic reflux increase risk.";s:11:"question_hi";s:75:"किन कारणों से जोखिम बढ़ता है?";s:9:"answer_hi";s:104:"धूम्रपान, शराब और दीर्घकालिक रिफ्लक्स।";s:10:"sort_order";i:3;}i:478;a:7:{s:2:"id";i:479;s:10:"disease_id";i:137;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:40:"Endoscopy, biopsy, and imaging are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:107:"एंडोस्कोपी, बायोप्सी और इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:479;a:7:{s:2:"id";i:480;s:10:"disease_id";i:137;s:11:"question_en";s:33:"Can Esophageal Cancer be treated?";s:9:"answer_en";s:67:"Treatment may include surgery, chemotherapy, and radiation therapy.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:172:"सर्जरी, कीमोथेरेपी और रेडियोथेरेपी द्वारा उपचार किया जा सकता है।";s:10:"sort_order";i:5;}i:480;a:7:{s:2:"id";i:481;s:10:"disease_id";i:138;s:11:"question_en";s:31:"What is Intestinal Obstruction?";s:9:"answer_en";s:76:"It is a blockage in the intestines that prevents normal passage of contents.";s:11:"question_hi";s:52:"आंत्र अवरोध क्या है?";s:9:"answer_hi";s:171:"यह आंतों में होने वाला अवरोध है जिससे सामान्य प्रवाह रुक जाता है।";s:10:"sort_order";i:1;}i:481;a:7:{s:2:"id";i:482;s:10:"disease_id";i:138;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:50:"Abdominal pain, vomiting, and bloating are common.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:75:"पेट दर्द, उल्टी और पेट फूलना।";s:10:"sort_order";i:2;}i:482;a:7:{s:2:"id";i:483;s:10:"disease_id";i:138;s:11:"question_en";s:39:"Is Intestinal Obstruction an emergency?";s:9:"answer_en";s:48:"Yes, it often requires urgent medical attention.";s:11:"question_hi";s:59:"क्या यह आपात स्थिति है?";s:9:"answer_hi";s:132:"हाँ, इसमें तत्काल चिकित्सा की आवश्यकता हो सकती है।";s:10:"sort_order";i:3;}i:483;a:7:{s:2:"id";i:484;s:10:"disease_id";i:138;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:58:"Imaging tests such as X-ray and CT scan are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:77:"एक्स-रे और सीटी स्कैन द्वारा।";s:10:"sort_order";i:4;}i:484;a:7:{s:2:"id";i:485;s:10:"disease_id";i:138;s:11:"question_en";s:24:"Can surgery be required?";s:9:"answer_en";s:44:"Yes, surgery may be necessary in some cases.";s:11:"question_hi";s:94:"क्या सर्जरी की आवश्यकता पड़ सकती है?";s:9:"answer_hi";s:117:"हाँ, कुछ मामलों में सर्जरी आवश्यक हो सकती है।";s:10:"sort_order";i:5;}i:485;a:7:{s:2:"id";i:486;s:10:"disease_id";i:139;s:11:"question_en";s:20:"What is Peritonitis?";s:9:"answer_en";s:52:"Peritonitis is inflammation of the abdominal lining.";s:11:"question_hi";s:57:"पेरिटोनाइटिस क्या है?";s:9:"answer_hi";s:85:"यह पेट की अंदरूनी परत की सूजन है।";s:10:"sort_order";i:1;}i:486;a:7:{s:2:"id";i:487;s:10:"disease_id";i:139;s:11:"question_en";s:24:"What causes Peritonitis?";s:9:"answer_en";s:64:"Infection and perforation of abdominal organs are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:129:"संक्रमण और पेट के अंगों का फटना सामान्य कारण हैं।";s:10:"sort_order";i:2;}i:487;a:7:{s:2:"id";i:488;s:10:"disease_id";i:139;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:51:"Severe abdominal pain, fever, and nausea may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:99:"तेज पेट दर्द, बुखार और मतली हो सकती है।";s:10:"sort_order";i:3;}i:488;a:7:{s:2:"id";i:489;s:10:"disease_id";i:139;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:49:"Treatment often includes antibiotics and surgery.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:136:"एंटीबायोटिक्स और सर्जरी द्वारा उपचार किया जाता है।";s:10:"sort_order";i:4;}i:489;a:7:{s:2:"id";i:490;s:10:"disease_id";i:139;s:11:"question_en";s:25:"Is Peritonitis dangerous?";s:9:"answer_en";s:45:"Yes, it can be life-threatening if untreated.";s:11:"question_hi";s:46:"क्या यह खतरनाक है?";s:9:"answer_hi";s:102:"हाँ, उपचार न होने पर जानलेवा हो सकता है।";s:10:"sort_order";i:5;}i:490;a:7:{s:2:"id";i:491;s:10:"disease_id";i:140;s:11:"question_en";s:29:"What is Short Bowel Syndrome?";s:9:"answer_en";s:66:"It occurs when the small intestine cannot absorb enough nutrients.";s:11:"question_hi";s:74:"शॉर्ट बाउल सिंड्रोम क्या है?";s:9:"answer_hi";s:174:"यह ऐसी स्थिति है जिसमें छोटी आंत पर्याप्त पोषक तत्व नहीं सोख पाती।";s:10:"sort_order";i:1;}i:491;a:7:{s:2:"id";i:492;s:10:"disease_id";i:140;s:11:"question_en";s:15:"What causes it?";s:9:"answer_en";s:41:"It often occurs after intestinal surgery.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:98:"यह अक्सर आंत की सर्जरी के बाद होता है।";s:10:"sort_order";i:2;}i:492;a:7:{s:2:"id";i:493;s:10:"disease_id";i:140;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:50:"Diarrhea, weight loss, and malnutrition may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:92:"दस्त, वजन घटना और कुपोषण हो सकता है।";s:10:"sort_order";i:3;}i:493;a:7:{s:2:"id";i:494;s:10:"disease_id";i:140;s:11:"question_en";s:18:"How is it managed?";s:9:"answer_en";s:56:"Nutritional support and specialized diets are important.";s:11:"question_hi";s:81:"इसका प्रबंधन कैसे किया जाता है?";s:9:"answer_hi";s:111:"पोषण सहायता और विशेष आहार महत्वपूर्ण हैं।";s:10:"sort_order";i:4;}i:494;a:7:{s:2:"id";i:495;s:10:"disease_id";i:140;s:11:"question_en";s:42:"Can people live with Short Bowel Syndrome?";s:9:"answer_en";s:46:"Yes, with proper medical and nutritional care.";s:11:"question_hi";s:91:"क्या इसके साथ सामान्य जीवन संभव है?";s:9:"answer_hi";s:97:"हाँ, उचित चिकित्सा और पोषण सहायता से।";s:10:"sort_order";i:5;}i:495;a:7:{s:2:"id";i:496;s:10:"disease_id";i:141;s:11:"question_en";s:34:"What is a Urinary Tract Infection?";s:9:"answer_en";s:48:"It is an infection affecting the urinary system.";s:11:"question_hi";s:74:"मूत्र मार्ग संक्रमण क्या है?";s:9:"answer_hi";s:77:"यह मूत्र तंत्र का संक्रमण है।";s:10:"sort_order";i:1;}i:496;a:7:{s:2:"id";i:497;s:10:"disease_id";i:141;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:72:"Burning urination, frequent urination, and pelvic discomfort are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:114:"पेशाब में जलन, बार-बार पेशाब आना और असुविधा।";s:10:"sort_order";i:2;}i:497;a:7:{s:2:"id";i:498;s:10:"disease_id";i:141;s:11:"question_en";s:16:"What causes UTI?";s:9:"answer_en";s:62:"Bacteria entering the urinary tract are the most common cause.";s:11:"question_hi";s:59:"यूटीआई का कारण क्या है?";s:9:"answer_hi";s:140:"मूत्र मार्ग में बैक्टीरिया का प्रवेश प्रमुख कारण है।";s:10:"sort_order";i:3;}i:498;a:7:{s:2:"id";i:499;s:10:"disease_id";i:141;s:11:"question_en";s:21:"How is UTI diagnosed?";s:9:"answer_en";s:48:"Urine examination and culture are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:73:"मूत्र जांच और कल्चर द्वारा।";s:10:"sort_order";i:4;}i:499;a:7:{s:2:"id";i:500;s:10:"disease_id";i:141;s:11:"question_en";s:21:"Can UTI be prevented?";s:9:"answer_en";s:56:"Good hygiene and adequate hydration may help prevent it.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:108:"स्वच्छता और पर्याप्त पानी पीना सहायक है।";s:10:"sort_order";i:5;}i:500;a:7:{s:2:"id";i:501;s:10:"disease_id";i:142;s:11:"question_en";s:23:"What are Kidney Stones?";s:9:"answer_en";s:62:"Kidney stones are hard mineral deposits formed in the kidneys.";s:11:"question_hi";s:59:"गुर्दे की पथरी क्या है?";s:9:"answer_hi";s:116:"यह गुर्दों में बनने वाले कठोर खनिज जमाव हैं।";s:10:"sort_order";i:1;}i:501;a:7:{s:2:"id";i:502;s:10:"disease_id";i:142;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:47:"Severe flank pain and blood in urine may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:115:"कमर में तेज दर्द और पेशाब में रक्त आ सकता है।";s:10:"sort_order";i:2;}i:502;a:7:{s:2:"id";i:503;s:10:"disease_id";i:142;s:11:"question_en";s:26:"What causes Kidney Stones?";s:9:"answer_en";s:71:"Dehydration and excess minerals in urine contribute to stone formation.";s:11:"question_hi";s:49:"पथरी क्यों बनती है?";s:9:"answer_hi";s:138:"निर्जलीकरण और खनिजों की अधिकता इसके कारण हो सकती है।";s:10:"sort_order";i:3;}i:503;a:7:{s:2:"id";i:504;s:10:"disease_id";i:142;s:11:"question_en";s:32:"How are Kidney Stones diagnosed?";s:9:"answer_en";s:46:"Ultrasound, CT scan, and urine tests are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:124:"अल्ट्रासाउंड, सीटी स्कैन और मूत्र जांच द्वारा।";s:10:"sort_order";i:4;}i:504;a:7:{s:2:"id";i:505;s:10:"disease_id";i:142;s:11:"question_en";s:31:"Can Kidney Stones be prevented?";s:9:"answer_en";s:43:"Drinking plenty of water helps reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:103:"पर्याप्त पानी पीने से जोखिम कम होता है।";s:10:"sort_order";i:5;}i:505;a:7:{s:2:"id";i:506;s:10:"disease_id";i:144;s:11:"question_en";s:28:"What is Acute Kidney Injury?";s:9:"answer_en";s:42:"It is a sudden decline in kidney function.";s:11:"question_hi";s:71:"एक्यूट किडनी इंजरी क्या है?";s:9:"answer_hi";s:115:"यह गुर्दों की कार्यक्षमता में अचानक कमी है।";s:10:"sort_order";i:1;}i:506;a:7:{s:2:"id";i:507;s:10:"disease_id";i:144;s:11:"question_en";s:32:"What causes Acute Kidney Injury?";s:9:"answer_en";s:65:"Dehydration, infections, and certain medicines are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:145:"निर्जलीकरण, संक्रमण और कुछ दवाएं इसके कारण हो सकती हैं।";s:10:"sort_order";i:2;}i:507;a:7:{s:2:"id";i:508;s:10:"disease_id";i:144;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:44:"Reduced urine output and swelling may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:85:"पेशाब कम होना और सूजन हो सकती है।";s:10:"sort_order";i:3;}i:508;a:7:{s:2:"id";i:509;s:10:"disease_id";i:144;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:46:"Blood tests and urine tests are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:70:"रक्त और मूत्र जांच द्वारा।";s:10:"sort_order";i:4;}i:509;a:7:{s:2:"id";i:510;s:10:"disease_id";i:144;s:11:"question_en";s:32:"Can Acute Kidney Injury recover?";s:9:"answer_en";s:42:"Many patients recover if treated promptly.";s:11:"question_hi";s:57:"क्या यह ठीक हो सकता है?";s:9:"answer_hi";s:102:"समय पर उपचार से कई रोगी ठीक हो सकते हैं।";s:10:"sort_order";i:5;}i:510;a:7:{s:2:"id";i:511;s:10:"disease_id";i:145;s:11:"question_en";s:27:"What is Glomerulonephritis?";s:9:"answer_en";s:49:"It is inflammation of the kidney filtering units.";s:11:"question_hi";s:81:"ग्लोमेरुलोनेफ्राइटिस क्या है?";s:9:"answer_hi";s:116:"यह गुर्दों की छानने वाली इकाइयों की सूजन है।";s:10:"sort_order";i:1;}i:511;a:7:{s:2:"id";i:512;s:10:"disease_id";i:145;s:11:"question_en";s:31:"What causes Glomerulonephritis?";s:9:"answer_en";s:53:"Autoimmune diseases and infections are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:124:"ऑटोइम्यून रोग और संक्रमण इसके प्रमुख कारण हैं।";s:10:"sort_order";i:2;}i:512;a:7:{s:2:"id";i:513;s:10:"disease_id";i:145;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:60:"Blood in urine, swelling, and high blood pressure may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:124:"पेशाब में रक्त, सूजन और उच्च रक्तचाप हो सकता है।";s:10:"sort_order";i:3;}i:513;a:7:{s:2:"id";i:514;s:10:"disease_id";i:145;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:56:"Urine tests, blood tests, and kidney biopsy may be used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:125:"मूत्र जांच, रक्त जांच और किडनी बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:514;a:7:{s:2:"id";i:515;s:10:"disease_id";i:145;s:11:"question_en";s:34:"Can Glomerulonephritis be treated?";s:9:"answer_en";s:55:"Treatment depends on the underlying cause and severity.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:119:"उपचार इसके कारण और गंभीरता पर निर्भर करता है।";s:10:"sort_order";i:5;}i:515;a:7:{s:2:"id";i:516;s:10:"disease_id";i:146;s:11:"question_en";s:27:"What is Nephrotic Syndrome?";s:9:"answer_en";s:80:"Nephrotic Syndrome is a kidney disorder causing excessive protein loss in urine.";s:11:"question_hi";s:73:"नेफ्रोटिक सिंड्रोम क्या है?";s:9:"answer_hi";s:180:"यह गुर्दे का विकार है जिसमें मूत्र के साथ अत्यधिक प्रोटीन निकलता है।";s:10:"sort_order";i:1;}i:516;a:7:{s:2:"id";i:517;s:10:"disease_id";i:146;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:49:"Swelling, foamy urine, and weight gain may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:111:"सूजन, झागदार मूत्र और वजन बढ़ना हो सकता है।";s:10:"sort_order";i:2;}i:517;a:7:{s:2:"id";i:518;s:10:"disease_id";i:146;s:11:"question_en";s:31:"What causes Nephrotic Syndrome?";s:9:"answer_en";s:72:"Kidney diseases, autoimmune disorders, and infections are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:168:"गुर्दे के रोग, ऑटोइम्यून विकार और संक्रमण इसके कारण हो सकते हैं।";s:10:"sort_order";i:3;}i:518;a:7:{s:2:"id";i:519;s:10:"disease_id";i:146;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:56:"Urine tests, blood tests, and kidney biopsy may be used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:125:"मूत्र जांच, रक्त जांच और किडनी बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:519;a:7:{s:2:"id";i:520;s:10:"disease_id";i:146;s:11:"question_en";s:34:"Can Nephrotic Syndrome be treated?";s:9:"answer_en";s:47:"Yes, treatment depends on the underlying cause.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:101:"हाँ, उपचार इसके कारण पर निर्भर करता है।";s:10:"sort_order";i:5;}i:520;a:7:{s:2:"id";i:521;s:10:"disease_id";i:147;s:11:"question_en";s:34:"What is Polycystic Kidney Disease?";s:9:"answer_en";s:66:"It is an inherited disorder causing multiple cysts in the kidneys.";s:11:"question_hi";s:80:"पॉलीसिस्टिक किडनी रोग क्या है?";s:9:"answer_hi";s:161:"यह एक आनुवंशिक रोग है जिसमें गुर्दों में अनेक सिस्ट बनते हैं।";s:10:"sort_order";i:1;}i:521;a:7:{s:2:"id";i:522;s:10:"disease_id";i:147;s:11:"question_en";s:18:"Is PKD hereditary?";s:9:"answer_en";s:34:"Yes, it commonly runs in families.";s:11:"question_hi";s:62:"क्या यह आनुवंशिक रोग है?";s:9:"answer_hi";s:98:"हाँ, यह परिवारों में चलने वाला रोग है।";s:10:"sort_order";i:2;}i:522;a:7:{s:2:"id";i:523;s:10:"disease_id";i:147;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:60:"High blood pressure, kidney enlargement, and pain may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:130:"उच्च रक्तचाप, गुर्दों का बढ़ना और दर्द हो सकता है।";s:10:"sort_order";i:3;}i:523;a:7:{s:2:"id";i:524;s:10:"disease_id";i:147;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:53:"Ultrasound, CT scan, and genetic testing may be used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:133:"अल्ट्रासाउंड, सीटी स्कैन और आनुवंशिक जांच द्वारा।";s:10:"sort_order";i:4;}i:524;a:7:{s:2:"id";i:525;s:10:"disease_id";i:147;s:11:"question_en";s:31:"Can PKD lead to kidney failure?";s:9:"answer_en";s:47:"Yes, advanced cases may lead to kidney failure.";s:11:"question_hi";s:79:"क्या इससे किडनी फेल हो सकती है?";s:9:"answer_hi";s:111:"हाँ, गंभीर मामलों में किडनी फेल हो सकती है।";s:10:"sort_order";i:5;}i:525;a:7:{s:2:"id";i:526;s:10:"disease_id";i:148;s:11:"question_en";s:27:"What is Overactive Bladder?";s:9:"answer_en";s:46:"It causes a sudden urge to urinate frequently.";s:11:"question_hi";s:67:"ओवरएक्टिव ब्लैडर क्या है?";s:9:"answer_hi";s:129:"इसमें बार-बार अचानक पेशाब की तीव्र इच्छा होती है।";s:10:"sort_order";i:1;}i:526;a:7:{s:2:"id";i:527;s:10:"disease_id";i:148;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:64:"Urgency, frequent urination, and nighttime urination are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:116:"बार-बार पेशाब आना और अचानक तीव्र इच्छा होना।";s:10:"sort_order";i:2;}i:527;a:7:{s:2:"id";i:528;s:10:"disease_id";i:148;s:11:"question_en";s:31:"What causes Overactive Bladder?";s:9:"answer_en";s:51:"Abnormal bladder muscle activity is a common cause.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:122:"मूत्राशय की मांसपेशियों की असामान्य गतिविधि।";s:10:"sort_order";i:3;}i:528;a:7:{s:2:"id";i:529;s:10:"disease_id";i:148;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:60:"Bladder training, medicines, and lifestyle changes may help.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:114:"ब्लैडर प्रशिक्षण, दवाएं और जीवनशैली सुधार।";s:10:"sort_order";i:4;}i:529;a:7:{s:2:"id";i:530;s:10:"disease_id";i:148;s:11:"question_en";s:18:"Can exercise help?";s:9:"answer_en";s:49:"Yes, pelvic floor exercises may improve symptoms.";s:11:"question_hi";s:72:"क्या व्यायाम से लाभ होता है?";s:9:"answer_hi";s:125:"हाँ, पेल्विक फ्लोर व्यायाम लाभकारी हो सकते हैं।";s:10:"sort_order";i:5;}i:530;a:7:{s:2:"id";i:531;s:10:"disease_id";i:149;s:11:"question_en";s:29:"What is Urinary Incontinence?";s:9:"answer_en";s:39:"It is the involuntary leakage of urine.";s:11:"question_hi";s:52:"मूत्र असंयम क्या है?";s:9:"answer_hi";s:125:"यह अनियंत्रित रूप से मूत्र निकलने की स्थिति है।";s:10:"sort_order";i:1;}i:531;a:7:{s:2:"id";i:532;s:10:"disease_id";i:149;s:11:"question_en";s:15:"Who is at risk?";s:9:"answer_en";s:45:"Older adults and women are commonly affected.";s:11:"question_hi";s:85:"किन लोगों में जोखिम अधिक होता है?";s:9:"answer_hi";s:115:"बुजुर्गों और महिलाओं में अधिक देखा जाता है।";s:10:"sort_order";i:2;}i:532;a:7:{s:2:"id";i:533;s:10:"disease_id";i:149;s:11:"question_en";s:33:"What causes Urinary Incontinence?";s:9:"answer_en";s:57:"Weak pelvic muscles and nerve problems are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:131:"कमजोर पेल्विक मांसपेशियां और तंत्रिका समस्याएं।";s:10:"sort_order";i:3;}i:533;a:7:{s:2:"id";i:534;s:10:"disease_id";i:149;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:50:"Pelvic exercises, medicines, and surgery may help.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:87:"व्यायाम, दवाएं और कभी-कभी सर्जरी।";s:10:"sort_order";i:4;}i:534;a:7:{s:2:"id";i:535;s:10:"disease_id";i:149;s:11:"question_en";s:20:"Can it be prevented?";s:9:"answer_en";s:57:"Maintaining healthy weight and pelvic exercises may help.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:106:"स्वस्थ वजन और व्यायाम सहायक हो सकते हैं।";s:10:"sort_order";i:5;}i:535;a:7:{s:2:"id";i:536;s:10:"disease_id";i:150;s:11:"question_en";s:12:"What is BPH?";s:9:"answer_en";s:55:"BPH is non-cancerous enlargement of the prostate gland.";s:11:"question_hi";s:39:"बीपीएच क्या है?";s:9:"answer_hi";s:127:"यह प्रोस्टेट ग्रंथि का गैर-कैंसरयुक्त बढ़ना है।";s:10:"sort_order";i:1;}i:536;a:7:{s:2:"id";i:537;s:10:"disease_id";i:150;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:50:"Frequent urination and weak urine flow are common.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:106:"बार-बार पेशाब आना और कमजोर मूत्र प्रवाह।";s:10:"sort_order";i:2;}i:537;a:7:{s:2:"id";i:538;s:10:"disease_id";i:150;s:11:"question_en";s:14:"Is BPH cancer?";s:9:"answer_en";s:22:"No, BPH is not cancer.";s:11:"question_hi";s:55:"क्या बीपीएच कैंसर है?";s:9:"answer_hi";s:59:"नहीं, यह कैंसर नहीं है।";s:10:"sort_order";i:3;}i:538;a:7:{s:2:"id";i:539;s:10:"disease_id";i:150;s:11:"question_en";s:21:"How is BPH diagnosed?";s:9:"answer_en";s:50:"PSA testing, examination, and imaging may be used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:102:"पीएसए जांच, परीक्षण और इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:539;a:7:{s:2:"id";i:540;s:10:"disease_id";i:150;s:11:"question_en";s:19:"Can BPH be treated?";s:9:"answer_en";s:41:"Yes, medicines and surgery are available.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:84:"हाँ, दवाएं और सर्जरी उपलब्ध हैं।";s:10:"sort_order";i:5;}i:540;a:7:{s:2:"id";i:541;s:10:"disease_id";i:151;s:11:"question_en";s:24:"What is Prostate Cancer?";s:9:"answer_en";s:46:"It is a malignant tumor of the prostate gland.";s:11:"question_hi";s:64:"प्रोस्टेट कैंसर क्या है?";s:9:"answer_hi";s:99:"यह प्रोस्टेट ग्रंथि का घातक कैंसर है।";s:10:"sort_order";i:1;}i:541;a:7:{s:2:"id";i:542;s:10:"disease_id";i:151;s:11:"question_en";s:15:"Who is at risk?";s:9:"answer_en";s:57:"Older men and those with family history have higher risk.";s:11:"question_hi";s:85:"किन लोगों में जोखिम अधिक होता है?";s:9:"answer_hi";s:126:"बुजुर्ग पुरुषों और पारिवारिक इतिहास वालों में।";s:10:"sort_order";i:2;}i:542;a:7:{s:2:"id";i:543;s:10:"disease_id";i:151;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:52:"Urinary symptoms or no symptoms may occur initially.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:128:"शुरुआत में पेशाब संबंधी लक्षण या कोई लक्षण नहीं।";s:10:"sort_order";i:3;}i:543;a:7:{s:2:"id";i:544;s:10:"disease_id";i:151;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:47:"PSA testing, MRI, and biopsy are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:89:"पीएसए, एमआरआई और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:544;a:7:{s:2:"id";i:545;s:10:"disease_id";i:151;s:11:"question_en";s:31:"Can Prostate Cancer be treated?";s:9:"answer_en";s:54:"Yes, surgery, radiation, and hormone therapy are used.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:164:"हाँ, सर्जरी, रेडियोथेरेपी और हार्मोन उपचार उपयोग किए जाते हैं।";s:10:"sort_order";i:5;}i:545;a:7:{s:2:"id";i:546;s:10:"disease_id";i:152;s:11:"question_en";s:29:"What is Erectile Dysfunction?";s:9:"answer_en";s:54:"It is difficulty achieving or maintaining an erection.";s:11:"question_hi";s:79:"इरेक्टाइल डिस्फंक्शन क्या है?";s:9:"answer_hi";s:144:"यह पर्याप्त स्तंभन प्राप्त या बनाए रखने में कठिनाई है।";s:10:"sort_order";i:1;}i:546;a:7:{s:2:"id";i:547;s:10:"disease_id";i:152;s:11:"question_en";s:33:"What causes Erectile Dysfunction?";s:9:"answer_en";s:71:"Diabetes, stress, hormonal problems, and vascular disease may cause it.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:135:"मधुमेह, तनाव, हार्मोनल समस्याएं और रक्त वाहिका रोग।";s:10:"sort_order";i:2;}i:547;a:7:{s:2:"id";i:548;s:10:"disease_id";i:152;s:11:"question_en";s:42:"Can lifestyle affect Erectile Dysfunction?";s:9:"answer_en";s:52:"Yes, smoking, obesity, and inactivity may worsen it.";s:11:"question_hi";s:93:"क्या जीवनशैली इसका प्रभाव डालती है?";s:9:"answer_hi";s:145:"हाँ, धूम्रपान, मोटापा और निष्क्रियता इसे बढ़ा सकते हैं।";s:10:"sort_order";i:3;}i:548;a:7:{s:2:"id";i:549;s:10:"disease_id";i:152;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:60:"Medical history, examination, and laboratory tests are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:114:"इतिहास, परीक्षण और प्रयोगशाला जांच द्वारा।";s:10:"sort_order";i:4;}i:549;a:7:{s:2:"id";i:550;s:10:"disease_id";i:152;s:11:"question_en";s:36:"Can Erectile Dysfunction be treated?";s:9:"answer_en";s:65:"Yes, medicines and lifestyle changes are effective in many cases.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:122:"हाँ, दवाएं और जीवनशैली सुधार लाभकारी होते हैं।";s:10:"sort_order";i:5;}i:550;a:7:{s:2:"id";i:551;s:10:"disease_id";i:153;s:11:"question_en";s:25:"What is Male Infertility?";s:9:"answer_en";s:40:"It is reduced ability to father a child.";s:11:"question_hi";s:55:"पुरुष बांझपन क्या है?";s:9:"answer_hi";s:113:"यह संतान उत्पन्न करने की क्षमता में कमी है।";s:10:"sort_order";i:1;}i:551;a:7:{s:2:"id";i:552;s:10:"disease_id";i:153;s:11:"question_en";s:29:"What causes Male Infertility?";s:9:"answer_en";s:61:"Sperm abnormalities and hormonal disorders are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:100:"शुक्राणु विकार और हार्मोनल समस्याएं।";s:10:"sort_order";i:2;}i:552;a:7:{s:2:"id";i:553;s:10:"disease_id";i:153;s:11:"question_en";s:34:"How is Male Infertility diagnosed?";s:9:"answer_en";s:53:"Semen analysis and hormone testing are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:101:"वीर्य जांच और हार्मोन परीक्षण द्वारा।";s:10:"sort_order";i:3;}i:553;a:7:{s:2:"id";i:554;s:10:"disease_id";i:153;s:11:"question_en";s:32:"Can Male Infertility be treated?";s:9:"answer_en";s:39:"Yes, depending on the underlying cause.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:101:"हाँ, इसके कारण के अनुसार उपचार संभव है।";s:10:"sort_order";i:4;}i:554;a:7:{s:2:"id";i:555;s:10:"disease_id";i:153;s:11:"question_en";s:30:"Does smoking affect fertility?";s:9:"answer_en";s:38:"Yes, smoking can reduce sperm quality.";s:11:"question_hi";s:128:"क्या धूम्रपान प्रजनन क्षमता को प्रभावित करता है?";s:9:"answer_hi";s:117:"हाँ, यह शुक्राणुओं की गुणवत्ता कम कर सकता है।";s:10:"sort_order";i:5;}i:555;a:7:{s:2:"id";i:556;s:10:"disease_id";i:154;s:11:"question_en";s:27:"What is Female Infertility?";s:9:"answer_en";s:66:"It is inability to conceive after regular unprotected intercourse.";s:11:"question_hi";s:55:"महिला बांझपन क्या है?";s:9:"answer_hi";s:130:"नियमित असुरक्षित संबंधों के बाद गर्भधारण न होना।";s:10:"sort_order";i:1;}i:556;a:7:{s:2:"id";i:557;s:10:"disease_id";i:154;s:11:"question_en";s:31:"What causes Female Infertility?";s:9:"answer_en";s:70:"Ovulation disorders and reproductive tract problems are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:120:"ओव्यूलेशन विकार और प्रजनन तंत्र की समस्याएं।";s:10:"sort_order";i:2;}i:557;a:7:{s:2:"id";i:558;s:10:"disease_id";i:154;s:11:"question_en";s:36:"How is Female Infertility diagnosed?";s:9:"answer_en";s:61:"Hormone tests, ultrasound, and fertility evaluation are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:148:"हार्मोन जांच, अल्ट्रासाउंड और प्रजनन मूल्यांकन द्वारा।";s:10:"sort_order";i:3;}i:558;a:7:{s:2:"id";i:559;s:10:"disease_id";i:154;s:11:"question_en";s:34:"Can Female Infertility be treated?";s:9:"answer_en";s:47:"Yes, treatment depends on the underlying cause.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:88:"हाँ, उपचार कारण पर निर्भर करता है।";s:10:"sort_order";i:4;}i:559;a:7:{s:2:"id";i:560;s:10:"disease_id";i:154;s:11:"question_en";s:26:"Does age affect fertility?";s:9:"answer_en";s:44:"Yes, fertility generally decreases with age.";s:11:"question_hi";s:116:"क्या उम्र प्रजनन क्षमता को प्रभावित करती है?";s:9:"answer_hi";s:117:"हाँ, उम्र बढ़ने के साथ प्रजनन क्षमता घटती है।";s:10:"sort_order";i:5;}i:560;a:7:{s:2:"id";i:561;s:10:"disease_id";i:155;s:11:"question_en";s:22:"What is Endometriosis?";s:9:"answer_en";s:86:"It is a condition where tissue similar to the uterine lining grows outside the uterus.";s:11:"question_hi";s:66:"एंडोमेट्रियोसिस क्या है?";s:9:"answer_hi";s:155:"यह ऐसी स्थिति है जिसमें गर्भाशय जैसी ऊतक परत बाहर बढ़ती है।";s:10:"sort_order";i:1;}i:561;a:7:{s:2:"id";i:562;s:10:"disease_id";i:155;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:56:"Pelvic pain, painful periods, and infertility may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:115:"पेल्विक दर्द, दर्दनाक मासिक धर्म और बांझपन।";s:10:"sort_order";i:2;}i:562;a:7:{s:2:"id";i:563;s:10:"disease_id";i:155;s:11:"question_en";s:31:"How is Endometriosis diagnosed?";s:9:"answer_en";s:44:"Imaging studies and laparoscopy may be used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:87:"इमेजिंग और लैप्रोस्कोपी द्वारा।";s:10:"sort_order";i:3;}i:563;a:7:{s:2:"id";i:564;s:10:"disease_id";i:155;s:11:"question_en";s:35:"Can Endometriosis affect fertility?";s:9:"answer_en";s:43:"Yes, it may reduce fertility in some women.";s:11:"question_hi";s:117:"क्या यह प्रजनन क्षमता को प्रभावित कर सकता है?";s:9:"answer_hi";s:127:"हाँ, कुछ महिलाओं में प्रजनन क्षमता कम कर सकता है।";s:10:"sort_order";i:4;}i:564;a:7:{s:2:"id";i:565;s:10:"disease_id";i:155;s:11:"question_en";s:30:"What treatments are available?";s:9:"answer_en";s:52:"Medicines, hormone therapy, and surgery may be used.";s:11:"question_hi";s:72:"कौन-कौन से उपचार उपलब्ध हैं?";s:9:"answer_hi";s:86:"दवाएं, हार्मोन थेरेपी और सर्जरी।";s:10:"sort_order";i:5;}i:565;a:7:{s:2:"id";i:566;s:10:"disease_id";i:151;s:11:"question_en";s:24:"What are Bladder Stones?";s:9:"answer_en";s:74:"Bladder stones are hard mineral deposits that form in the urinary bladder.";s:11:"question_hi";s:65:"मूत्राशय की पथरी क्या है?";s:9:"answer_hi";s:145:"मूत्राशय में बनने वाले कठोर खनिज जमाव को पथरी कहते हैं।";s:10:"sort_order";i:1;}i:566;a:7:{s:2:"id";i:567;s:10:"disease_id";i:151;s:11:"question_en";s:27:"What causes Bladder Stones?";s:9:"answer_en";s:59:"Urinary retention and concentrated urine are common causes.";s:11:"question_hi";s:81:"मूत्राशय की पथरी क्यों बनती है?";s:9:"answer_hi";s:125:"मूत्र रुकना और सघन मूत्र इसके सामान्य कारण हैं।";s:10:"sort_order";i:2;}i:567;a:7:{s:2:"id";i:568;s:10:"disease_id";i:151;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:68:"Painful urination, blood in urine, and frequent urination may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:139:"दर्दयुक्त पेशाब, मूत्र में रक्त और बार-बार पेशाब आना।";s:10:"sort_order";i:3;}i:568;a:7:{s:2:"id";i:569;s:10:"disease_id";i:151;s:11:"question_en";s:33:"How are Bladder Stones diagnosed?";s:9:"answer_en";s:55:"Ultrasound, CT scan, and urine tests are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:124:"अल्ट्रासाउंड, सीटी स्कैन और मूत्र जांच द्वारा।";s:10:"sort_order";i:4;}i:569;a:7:{s:2:"id";i:570;s:10:"disease_id";i:151;s:11:"question_en";s:32:"Can Bladder Stones be prevented?";s:9:"answer_en";s:35:"Adequate hydration may reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:110:"पर्याप्त पानी पीने से जोखिम कम हो सकता है।";s:10:"sort_order";i:5;}i:570;a:7:{s:2:"id";i:571;s:10:"disease_id";i:152;s:11:"question_en";s:23:"What is Bladder Cancer?";s:9:"answer_en";s:61:"Bladder cancer develops in the lining of the urinary bladder.";s:11:"question_hi";s:61:"मूत्राशय कैंसर क्या है?";s:9:"answer_hi";s:129:"यह मूत्राशय की परत में विकसित होने वाला कैंसर है।";s:10:"sort_order";i:1;}i:571;a:7:{s:2:"id";i:572;s:10:"disease_id";i:152;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:41:"Blood in urine is a common early symptom.";s:11:"question_hi";s:71:"इसका सामान्य लक्षण क्या है?";s:9:"answer_hi";s:127:"मूत्र में रक्त इसका सामान्य प्रारंभिक लक्षण है।";s:10:"sort_order";i:2;}i:572;a:7:{s:2:"id";i:573;s:10:"disease_id";i:152;s:11:"question_en";s:42:"What increases the risk of Bladder Cancer?";s:9:"answer_en";s:41:"Smoking is one of the major risk factors.";s:11:"question_hi";s:103:"मूत्राशय कैंसर का जोखिम किससे बढ़ता है?";s:9:"answer_hi";s:112:"धूम्रपान प्रमुख जोखिम कारकों में से एक है।";s:10:"sort_order";i:3;}i:573;a:7:{s:2:"id";i:574;s:10:"disease_id";i:152;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:40:"Cystoscopy and biopsy are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:90:"सिस्टोस्कोपी और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:574;a:7:{s:2:"id";i:575;s:10:"disease_id";i:152;s:11:"question_en";s:30:"Can Bladder Cancer be treated?";s:9:"answer_en";s:48:"Yes, surgery and cancer therapies are available.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:100:"हाँ, सर्जरी और कैंसर उपचार उपलब्ध हैं।";s:10:"sort_order";i:5;}i:575;a:7:{s:2:"id";i:576;s:10:"disease_id";i:155;s:11:"question_en";s:19:"What is Urethritis?";s:9:"answer_en";s:42:"Urethritis is inflammation of the urethra.";s:11:"question_hi";s:57:"यूरेथ्राइटिस क्या है?";s:9:"answer_hi";s:67:"यह मूत्रमार्ग की सूजन है।";s:10:"sort_order";i:1;}i:576;a:7:{s:2:"id";i:577;s:10:"disease_id";i:155;s:11:"question_en";s:23:"What causes Urethritis?";s:9:"answer_en";s:64:"Bacterial and sexually transmitted infections are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:94:"बैक्टीरियल और यौन संचारित संक्रमण।";s:10:"sort_order";i:2;}i:577;a:7:{s:2:"id";i:578;s:10:"disease_id";i:155;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:42:"Burning urination and discharge may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:88:"पेशाब में जलन और स्राव हो सकता है।";s:10:"sort_order";i:3;}i:578;a:7:{s:2:"id";i:579;s:10:"disease_id";i:155;s:11:"question_en";s:28:"How is Urethritis diagnosed?";s:9:"answer_en";s:45:"Urine tests and infection screening are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:101:"मूत्र जांच और संक्रमण परीक्षण द्वारा।";s:10:"sort_order";i:4;}i:579;a:7:{s:2:"id";i:580;s:10:"disease_id";i:155;s:11:"question_en";s:28:"Can Urethritis be prevented?";s:9:"answer_en";s:34:"Safe sexual practices reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:109:"सुरक्षित यौन व्यवहार से जोखिम कम होता है।";s:10:"sort_order";i:5;}i:580;a:7:{s:2:"id";i:581;s:10:"disease_id";i:156;s:11:"question_en";s:26:"What is Urinary Retention?";s:9:"answer_en";s:52:"It is the inability to completely empty the bladder.";s:11:"question_hi";s:52:"मूत्र अवरोध क्या है?";s:9:"answer_hi";s:134:"यह मूत्राशय को पूरी तरह खाली न कर पाने की स्थिति है।";s:10:"sort_order";i:1;}i:581;a:7:{s:2:"id";i:582;s:10:"disease_id";i:156;s:11:"question_en";s:30:"What causes Urinary Retention?";s:9:"answer_en";s:59:"Prostate enlargement and nerve disorders are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:142:"प्रोस्टेट वृद्धि और तंत्रिका विकार सामान्य कारण हैं।";s:10:"sort_order";i:2;}i:582;a:7:{s:2:"id";i:583;s:10:"disease_id";i:156;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:56:"Difficulty urinating and incomplete emptying are common.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:142:"पेशाब करने में कठिनाई और मूत्राशय का पूरा खाली न होना।";s:10:"sort_order";i:3;}i:583;a:7:{s:2:"id";i:584;s:10:"disease_id";i:156;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:46:"Bladder scans and urinary testing may be used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:92:"ब्लैडर स्कैन और मूत्र जांच द्वारा।";s:10:"sort_order";i:4;}i:584;a:7:{s:2:"id";i:585;s:10:"disease_id";i:156;s:11:"question_en";s:29:"Is Urinary Retention serious?";s:9:"answer_en";s:61:"Untreated retention can damage the urinary tract and kidneys.";s:11:"question_hi";s:43:"क्या यह गंभीर है?";s:9:"answer_hi";s:156:"उपचार न होने पर मूत्र तंत्र और गुर्दों को नुकसान हो सकता है।";s:10:"sort_order";i:5;}i:585;a:7:{s:2:"id";i:586;s:10:"disease_id";i:157;s:11:"question_en";s:22:"What is Kidney Cancer?";s:9:"answer_en";s:42:"Kidney cancer develops from kidney tissue.";s:11:"question_hi";s:52:"किडनी कैंसर क्या है?";s:9:"answer_hi";s:129:"यह गुर्दे के ऊतकों में विकसित होने वाला कैंसर है।";s:10:"sort_order";i:1;}i:586;a:7:{s:2:"id";i:587;s:10:"disease_id";i:157;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:54:"Blood in urine, flank pain, and weight loss may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:95:"मूत्र में रक्त, कमर दर्द और वजन घटना।";s:10:"sort_order";i:2;}i:587;a:7:{s:2:"id";i:588;s:10:"disease_id";i:157;s:11:"question_en";s:22:"Who is at higher risk?";s:9:"answer_en";s:50:"Smokers and obese individuals have increased risk.";s:11:"question_hi";s:85:"किन लोगों में जोखिम अधिक होता है?";s:9:"answer_hi";s:134:"धूम्रपान करने वालों और मोटापे से ग्रस्त लोगों में।";s:10:"sort_order";i:3;}i:588;a:7:{s:2:"id";i:589;s:10:"disease_id";i:157;s:11:"question_en";s:31:"How is Kidney Cancer diagnosed?";s:9:"answer_en";s:37:"CT scan, MRI, and biopsy may be used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:102:"सीटी स्कैन, एमआरआई और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:589;a:7:{s:2:"id";i:590;s:10:"disease_id";i:157;s:11:"question_en";s:29:"Can Kidney Cancer be treated?";s:9:"answer_en";s:50:"Yes, surgery and targeted therapies are available.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:103:"हाँ, सर्जरी और लक्षित उपचार उपलब्ध हैं।";s:10:"sort_order";i:5;}i:590;a:7:{s:2:"id";i:591;s:10:"disease_id";i:158;s:11:"question_en";s:30:"What is Renal Artery Stenosis?";s:9:"answer_en";s:54:"It is narrowing of the arteries supplying the kidneys.";s:11:"question_hi";s:80:"रीनल आर्टरी स्टेनोसिस क्या है?";s:9:"answer_hi";s:144:"यह गुर्दों को रक्त पहुंचाने वाली धमनियों का संकुचन है।";s:10:"sort_order";i:1;}i:591;a:7:{s:2:"id";i:592;s:10:"disease_id";i:158;s:11:"question_en";s:34:"What causes Renal Artery Stenosis?";s:9:"answer_en";s:41:"Atherosclerosis is the most common cause.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:103:"एथेरोस्क्लेरोसिस इसका प्रमुख कारण है।";s:10:"sort_order";i:2;}i:592;a:7:{s:2:"id";i:593;s:10:"disease_id";i:158;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:53:"High blood pressure and kidney dysfunction may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:127:"उच्च रक्तचाप और गुर्दों की कार्यक्षमता में कमी।";s:10:"sort_order";i:3;}i:593;a:7:{s:2:"id";i:594;s:10:"disease_id";i:158;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:47:"Doppler ultrasound and CT angiography are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:134:"डॉप्लर अल्ट्रासाउंड और सीटी एंजियोग्राफी द्वारा।";s:10:"sort_order";i:4;}i:594;a:7:{s:2:"id";i:595;s:10:"disease_id";i:158;s:11:"question_en";s:18:"Can it be treated?";s:9:"answer_en";s:48:"Yes, medicines and vascular procedures may help.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:132:"हाँ, दवाएं और विशेष प्रक्रियाएं सहायक हो सकती हैं।";s:10:"sort_order";i:5;}i:595;a:7:{s:2:"id";i:596;s:10:"disease_id";i:159;s:11:"question_en";s:30:"What is Vesicoureteral Reflux?";s:9:"answer_en";s:57:"Urine flows backward from the bladder toward the kidneys.";s:11:"question_hi";s:85:"वेसिकोयूरेटरल रिफ्लक्स क्या है?";s:9:"answer_hi";s:135:"इसमें मूत्र मूत्राशय से वापस गुर्दों की ओर जाता है।";s:10:"sort_order";i:1;}i:596;a:7:{s:2:"id";i:597;s:10:"disease_id";i:159;s:11:"question_en";s:37:"Who commonly develops this condition?";s:9:"answer_en";s:37:"It is commonly diagnosed in children.";s:11:"question_hi";s:99:"यह रोग किन लोगों में अधिक पाया जाता है?";s:9:"answer_hi";s:87:"यह अक्सर बच्चों में पाया जाता है।";s:10:"sort_order";i:2;}i:597;a:7:{s:2:"id";i:598;s:10:"disease_id";i:159;s:11:"question_en";s:27:"What problems can it cause?";s:9:"answer_en";s:56:"Repeated urinary infections and kidney damage may occur.";s:11:"question_hi";s:81:"इससे क्या समस्याएं हो सकती हैं?";s:9:"answer_hi";s:126:"बार-बार संक्रमण और गुर्दों को नुकसान हो सकता है।";s:10:"sort_order";i:3;}i:598;a:7:{s:2:"id";i:599;s:10:"disease_id";i:159;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:38:"VCUG and ultrasound are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:90:"वीसीयूजी और अल्ट्रासाउंड द्वारा।";s:10:"sort_order";i:4;}i:599;a:7:{s:2:"id";i:600;s:10:"disease_id";i:159;s:11:"question_en";s:43:"Can Vesicoureteral Reflux improve with age?";s:9:"answer_en";s:41:"Some mild cases improve as children grow.";s:11:"question_hi";s:87:"क्या यह उम्र के साथ ठीक हो सकता है?";s:9:"answer_hi";s:159:"कुछ हल्के मामलों में बच्चों के बड़े होने पर सुधार हो सकता है।";s:10:"sort_order";i:5;}i:600;a:7:{s:2:"id";i:601;s:10:"disease_id";i:160;s:11:"question_en";s:29:"What is Diabetic Nephropathy?";s:9:"answer_en";s:39:"It is kidney damage caused by diabetes.";s:11:"question_hi";s:76:"डायबिटिक नेफ्रोपैथी क्या है?";s:9:"answer_hi";s:123:"यह मधुमेह के कारण होने वाली गुर्दे की क्षति है।";s:10:"sort_order";i:1;}i:601;a:7:{s:2:"id";i:602;s:10:"disease_id";i:160;s:11:"question_en";s:33:"What causes Diabetic Nephropathy?";s:9:"answer_en";s:56:"Long-term high blood sugar damages kidney blood vessels.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:202:"लंबे समय तक उच्च रक्त शर्करा गुर्दों की रक्त वाहिकाओं को नुकसान पहुंचाती है।";s:10:"sort_order";i:2;}i:602;a:7:{s:2:"id";i:603;s:10:"disease_id";i:160;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:40:"Protein in urine and swelling may occur.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:97:"मूत्र में प्रोटीन और सूजन हो सकती है।";s:10:"sort_order";i:3;}i:603;a:7:{s:2:"id";i:604;s:10:"disease_id";i:160;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:57:"Urine protein testing and kidney function tests are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:114:"मूत्र प्रोटीन और किडनी फंक्शन जांच द्वारा।";s:10:"sort_order";i:4;}i:604;a:7:{s:2:"id";i:605;s:10:"disease_id";i:160;s:11:"question_en";s:20:"Can it be prevented?";s:9:"answer_en";s:35:"Good diabetes control reduces risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:119:"मधुमेह को नियंत्रित रखने से जोखिम कम होता है।";s:10:"sort_order";i:5;}i:605;a:7:{s:2:"id";i:606;s:10:"disease_id";i:162;s:11:"question_en";s:30:"What is Premature Ejaculation?";s:9:"answer_en";s:48:"It is ejaculation occurring sooner than desired.";s:11:"question_hi";s:45:"शीघ्रपतन क्या है?";s:9:"answer_hi";s:113:"यह अपेक्षा से पहले स्खलन होने की स्थिति है।";s:10:"sort_order";i:1;}i:606;a:7:{s:2:"id";i:607;s:10:"disease_id";i:162;s:11:"question_en";s:34:"What causes Premature Ejaculation?";s:9:"answer_en";s:55:"Stress, anxiety, and biological factors may contribute.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:117:"तनाव, चिंता और जैविक कारक योगदान कर सकते हैं।";s:10:"sort_order";i:2;}i:607;a:7:{s:2:"id";i:608;s:10:"disease_id";i:162;s:11:"question_en";s:38:"Can psychological factors play a role?";s:9:"answer_en";s:48:"Yes, anxiety and stress are common contributors.";s:11:"question_hi";s:93:"क्या मानसिक कारण भूमिका निभाते हैं?";s:9:"answer_hi";s:94:"हाँ, चिंता और तनाव सामान्य कारण हैं।";s:10:"sort_order";i:3;}i:608;a:7:{s:2:"id";i:609;s:10:"disease_id";i:162;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:55:"Behavioral therapy, counseling, and medicines may help.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:141:"व्यवहार चिकित्सा, परामर्श और दवाएं सहायक हो सकती हैं।";s:10:"sort_order";i:4;}i:609;a:7:{s:2:"id";i:610;s:10:"disease_id";i:162;s:11:"question_en";s:27:"Can lifestyle changes help?";s:9:"answer_en";s:43:"Yes, stress reduction may improve symptoms.";s:11:"question_hi";s:98:"क्या जीवनशैली सुधार से लाभ हो सकता है?";s:9:"answer_hi";s:90:"हाँ, तनाव कम करने से लाभ हो सकता है।";s:10:"sort_order";i:5;}i:610;a:7:{s:2:"id";i:611;s:10:"disease_id";i:164;s:11:"question_en";s:25:"What is Low Testosterone?";s:9:"answer_en";s:59:"It is a condition with reduced testosterone hormone levels.";s:11:"question_hi";s:67:"कम टेस्टोस्टेरोन क्या है?";s:9:"answer_hi";s:140:"यह टेस्टोस्टेरोन हार्मोन के निम्न स्तर की स्थिति है।";s:10:"sort_order";i:1;}i:611;a:7:{s:2:"id";i:612;s:10:"disease_id";i:164;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:55:"Fatigue, low libido, and reduced muscle mass may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:119:"थकान, कामेच्छा में कमी और मांसपेशियों की कमी।";s:10:"sort_order";i:2;}i:612;a:7:{s:2:"id";i:613;s:10:"disease_id";i:164;s:11:"question_en";s:29:"What causes Low Testosterone?";s:9:"answer_en";s:62:"Aging, hormonal disorders, and chronic illnesses may cause it.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:111:"उम्र, हार्मोनल विकार और पुरानी बीमारियां।";s:10:"sort_order";i:3;}i:613;a:7:{s:2:"id";i:614;s:10:"disease_id";i:164;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:44:"Blood testosterone testing is commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:87:"रक्त टेस्टोस्टेरोन जांच द्वारा।";s:10:"sort_order";i:4;}i:614;a:7:{s:2:"id";i:615;s:10:"disease_id";i:164;s:11:"question_en";s:32:"Can Low Testosterone be treated?";s:9:"answer_en";s:47:"Yes, treatment depends on the underlying cause.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:101:"हाँ, उपचार इसके कारण पर निर्भर करता है।";s:10:"sort_order";i:5;}i:615;a:7:{s:2:"id";i:616;s:10:"disease_id";i:165;s:11:"question_en";s:20:"What is Prostatitis?";s:9:"answer_en";s:50:"Prostatitis is inflammation of the prostate gland.";s:11:"question_hi";s:63:"प्रोस्टेटाइटिस क्या है?";s:9:"answer_hi";s:83:"यह प्रोस्टेट ग्रंथि की सूजन है।";s:10:"sort_order";i:1;}i:616;a:7:{s:2:"id";i:617;s:10:"disease_id";i:165;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:66:"Pelvic pain, urinary discomfort, and painful urination are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:106:"पेल्विक दर्द, पेशाब में परेशानी और दर्द।";s:10:"sort_order";i:2;}i:617;a:7:{s:2:"id";i:618;s:10:"disease_id";i:165;s:11:"question_en";s:24:"What causes Prostatitis?";s:9:"answer_en";s:38:"Bacterial infection is a common cause.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:110:"बैक्टीरियल संक्रमण इसका सामान्य कारण है।";s:10:"sort_order";i:3;}i:618;a:7:{s:2:"id";i:619;s:10:"disease_id";i:165;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:55:"Urine tests and prostate examination are commonly used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:107:"मूत्र जांच और प्रोस्टेट परीक्षण द्वारा।";s:10:"sort_order";i:4;}i:619;a:7:{s:2:"id";i:620;s:10:"disease_id";i:165;s:11:"question_en";s:27:"Can Prostatitis be treated?";s:9:"answer_en";s:49:"Yes, treatment depends on the cause and symptoms.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:117:"हाँ, उपचार कारण और लक्षणों पर निर्भर करता है।";s:10:"sort_order";i:5;}i:620;a:7:{s:2:"id";i:621;s:10:"disease_id";i:168;s:11:"question_en";s:26:"What is Testicular Cancer?";s:9:"answer_en";s:46:"It is a cancer that develops in the testicles.";s:11:"question_hi";s:49:"वृषण कैंसर क्या है?";s:9:"answer_hi";s:106:"यह अंडकोष में विकसित होने वाला कैंसर है।";s:10:"sort_order";i:1;}i:621;a:7:{s:2:"id";i:622;s:10:"disease_id";i:168;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:54:"A painless lump or swelling in the testicle is common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:109:"अंडकोष में गांठ या सूजन सामान्य लक्षण है।";s:10:"sort_order";i:2;}i:622;a:7:{s:2:"id";i:623;s:10:"disease_id";i:168;s:11:"question_en";s:22:"Who is at higher risk?";s:9:"answer_en";s:48:"Men with undescended testicles have higher risk.";s:11:"question_hi";s:72:"किन लोगों में जोखिम अधिक है?";s:9:"answer_hi";s:126:"जिनमें अवरोही न हुआ वृषण हो उनमें जोखिम अधिक है।";s:10:"sort_order";i:3;}i:623;a:7:{s:2:"id";i:624;s:10:"disease_id";i:168;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:52:"Ultrasound and tumor marker tests are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:116:"अल्ट्रासाउंड और ट्यूमर मार्कर जांच द्वारा।";s:10:"sort_order";i:4;}i:624;a:7:{s:2:"id";i:625;s:10:"disease_id";i:168;s:11:"question_en";s:31:"Can Testicular Cancer be cured?";s:9:"answer_en";s:59:"Many cases can be successfully treated when detected early.";s:11:"question_hi";s:57:"क्या यह ठीक हो सकता है?";s:9:"answer_hi";s:137:"समय पर पहचान होने पर कई मामलों में सफल उपचार संभव है।";s:10:"sort_order";i:5;}i:625;a:7:{s:2:"id";i:626;s:10:"disease_id";i:169;s:11:"question_en";s:27:"What is Testicular Torsion?";s:9:"answer_en";s:67:"It occurs when the spermatic cord twists and cuts off blood supply.";s:11:"question_hi";s:49:"वृषण मरोड़ क्या है?";s:9:"answer_hi";s:154:"इसमें शुक्रवाहिनी मुड़ जाती है और रक्त प्रवाह रुक जाता है।";s:10:"sort_order";i:1;}i:626;a:7:{s:2:"id";i:627;s:10:"disease_id";i:169;s:11:"question_en";s:35:"Is Testicular Torsion an emergency?";s:9:"answer_en";s:42:"Yes, it requires urgent medical attention.";s:11:"question_hi";s:59:"क्या यह आपात स्थिति है?";s:9:"answer_hi";s:84:"हाँ, यह चिकित्सा आपात स्थिति है।";s:10:"sort_order";i:2;}i:627;a:7:{s:2:"id";i:628;s:10:"disease_id";i:169;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:54:"Sudden severe testicular pain and swelling are common.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:61:"अचानक तेज दर्द और सूजन।";s:10:"sort_order";i:3;}i:628;a:7:{s:2:"id";i:629;s:10:"disease_id";i:169;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:53:"Physical examination and Doppler ultrasound are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:128:"शारीरिक परीक्षण और डॉप्लर अल्ट्रासाउंड द्वारा।";s:10:"sort_order";i:4;}i:629;a:7:{s:2:"id";i:630;s:10:"disease_id";i:169;s:11:"question_en";s:22:"What is the treatment?";s:9:"answer_en";s:38:"Emergency surgery is usually required.";s:11:"question_hi";s:49:"इसका उपचार क्या है?";s:9:"answer_hi";s:124:"आमतौर पर आपातकालीन सर्जरी की आवश्यकता होती है।";s:10:"sort_order";i:5;}i:630;a:7:{s:2:"id";i:631;s:10:"disease_id";i:170;s:11:"question_en";s:18:"What is Hydrocele?";s:9:"answer_en";s:52:"Hydrocele is fluid accumulation around the testicle.";s:11:"question_hi";s:51:"हाइड्रोसील क्या है?";s:9:"answer_hi";s:117:"यह अंडकोष के आसपास तरल जमा होने की स्थिति है।";s:10:"sort_order";i:1;}i:631;a:7:{s:2:"id";i:632;s:10:"disease_id";i:170;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:44:"Scrotal swelling is the most common symptom.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:93:"अंडकोश की सूजन इसका मुख्य लक्षण है।";s:10:"sort_order";i:2;}i:632;a:7:{s:2:"id";i:633;s:10:"disease_id";i:170;s:11:"question_en";s:23:"Is Hydrocele dangerous?";s:9:"answer_en";s:58:"Most hydroceles are not dangerous but should be evaluated.";s:11:"question_hi";s:70:"क्या हाइड्रोसील खतरनाक है?";s:9:"answer_hi";s:122:"अधिकांश मामलों में नहीं, लेकिन जांच आवश्यक है।";s:10:"sort_order";i:3;}i:633;a:7:{s:2:"id";i:634;s:10:"disease_id";i:170;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:45:"Physical examination and ultrasound are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:109:"शारीरिक परीक्षण और अल्ट्रासाउंड द्वारा।";s:10:"sort_order";i:4;}i:634;a:7:{s:2:"id";i:635;s:10:"disease_id";i:170;s:11:"question_en";s:30:"Can Hydrocele require surgery?";s:9:"answer_en";s:41:"Yes, surgery may be needed in some cases.";s:11:"question_hi";s:94:"क्या सर्जरी की आवश्यकता पड़ सकती है?";s:9:"answer_hi";s:117:"हाँ, कुछ मामलों में सर्जरी आवश्यक हो सकती है।";s:10:"sort_order";i:5;}i:635;a:7:{s:2:"id";i:636;s:10:"disease_id";i:171;s:11:"question_en";s:19:"What is Varicocele?";s:9:"answer_en";s:50:"Varicocele is enlargement of veins in the scrotum.";s:11:"question_hi";s:48:"वैरिकोसील क्या है?";s:9:"answer_hi";s:78:"यह अंडकोश की नसों का बढ़ना है।";s:10:"sort_order";i:1;}i:636;a:7:{s:2:"id";i:637;s:10:"disease_id";i:171;s:11:"question_en";s:32:"Can Varicocele affect fertility?";s:9:"answer_en";s:41:"Yes, it may reduce fertility in some men.";s:11:"question_hi";s:117:"क्या यह प्रजनन क्षमता को प्रभावित कर सकता है?";s:9:"answer_hi";s:145:"हाँ, कुछ पुरुषों में प्रजनन क्षमता प्रभावित हो सकती है।";s:10:"sort_order";i:2;}i:637;a:7:{s:2:"id";i:638;s:10:"disease_id";i:171;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:41:"Scrotal discomfort or swelling may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:91:"अंडकोश में दर्द या सूजन हो सकती है।";s:10:"sort_order";i:3;}i:638;a:7:{s:2:"id";i:639;s:10:"disease_id";i:171;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:53:"Examination and Doppler ultrasound are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:106:"परीक्षण और डॉप्लर अल्ट्रासाउंड द्वारा।";s:10:"sort_order";i:4;}i:639;a:7:{s:2:"id";i:640;s:10:"disease_id";i:171;s:11:"question_en";s:26:"Can Varicocele be treated?";s:9:"answer_en";s:50:"Yes, surgery may be recommended in selected cases.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:125:"हाँ, कुछ मामलों में सर्जरी की सलाह दी जा सकती है।";s:10:"sort_order";i:5;}i:640;a:7:{s:2:"id";i:641;s:10:"disease_id";i:172;s:11:"question_en";s:21:"What is Epididymitis?";s:9:"answer_en";s:37:"It is inflammation of the epididymis.";s:11:"question_hi";s:60:"एपिडिडिमाइटिस क्या है?";s:9:"answer_hi";s:67:"यह एपिडिडिमिस की सूजन है।";s:10:"sort_order";i:1;}i:641;a:7:{s:2:"id";i:642;s:10:"disease_id";i:172;s:11:"question_en";s:25:"What causes Epididymitis?";s:9:"answer_en";s:40:"Bacterial infections are a common cause.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:97:"बैक्टीरियल संक्रमण सामान्य कारण है।";s:10:"sort_order";i:2;}i:642;a:7:{s:2:"id";i:643;s:10:"disease_id";i:172;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:36:"Pain, swelling, and fever may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:79:"दर्द, सूजन और बुखार हो सकता है।";s:10:"sort_order";i:3;}i:643;a:7:{s:2:"id";i:644;s:10:"disease_id";i:172;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:39:"Urine tests and ultrasound may be used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:94:"मूत्र जांच और अल्ट्रासाउंड द्वारा।";s:10:"sort_order";i:4;}i:644;a:7:{s:2:"id";i:645;s:10:"disease_id";i:172;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:56:"Antibiotics are commonly used when infection is present.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:114:"संक्रमण होने पर एंटीबायोटिक्स दी जाती हैं।";s:10:"sort_order";i:5;}i:645;a:7:{s:2:"id";i:646;s:10:"disease_id";i:173;s:11:"question_en";s:17:"What is Orchitis?";s:9:"answer_en";s:50:"Orchitis is inflammation of one or both testicles.";s:11:"question_hi";s:48:"ऑर्काइटिस क्या है?";s:9:"answer_hi";s:85:"यह एक या दोनों अंडकोष की सूजन है।";s:10:"sort_order";i:1;}i:646;a:7:{s:2:"id";i:647;s:10:"disease_id";i:173;s:11:"question_en";s:21:"What causes Orchitis?";s:9:"answer_en";s:48:"Viral or bacterial infections are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:133:"वायरल या बैक्टीरियल संक्रमण इसके प्रमुख कारण हैं।";s:10:"sort_order";i:2;}i:647;a:7:{s:2:"id";i:648;s:10:"disease_id";i:173;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:47:"Testicular pain, swelling, and fever may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:108:"अंडकोष में दर्द, सूजन और बुखार हो सकता है।";s:10:"sort_order";i:3;}i:648;a:7:{s:2:"id";i:649;s:10:"disease_id";i:173;s:11:"question_en";s:30:"Can Orchitis affect fertility?";s:9:"answer_en";s:34:"Severe cases may affect fertility.";s:11:"question_hi";s:117:"क्या यह प्रजनन क्षमता को प्रभावित कर सकता है?";s:9:"answer_hi";s:137:"गंभीर मामलों में प्रजनन क्षमता प्रभावित हो सकती है।";s:10:"sort_order";i:4;}i:649;a:7:{s:2:"id";i:650;s:10:"disease_id";i:173;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:50:"Examination, blood tests, and ultrasound are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:114:"परीक्षण, रक्त जांच और अल्ट्रासाउंड द्वारा।";s:10:"sort_order";i:5;}i:650;a:7:{s:2:"id";i:651;s:10:"disease_id";i:174;s:11:"question_en";s:18:"What is Balanitis?";s:9:"answer_en";s:51:"Balanitis is inflammation of the head of the penis.";s:11:"question_hi";s:51:"बैलेनाइटिस क्या है?";s:9:"answer_hi";s:78:"यह लिंग के अग्रभाग की सूजन है।";s:10:"sort_order";i:1;}i:651;a:7:{s:2:"id";i:652;s:10:"disease_id";i:174;s:11:"question_en";s:22:"What causes Balanitis?";s:9:"answer_en";s:46:"Poor hygiene and infections are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:127:"खराब स्वच्छता और संक्रमण इसके सामान्य कारण हैं।";s:10:"sort_order";i:2;}i:652;a:7:{s:2:"id";i:653;s:10:"disease_id";i:174;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:37:"Redness, itching, and pain may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:85:"लालिमा, खुजली और दर्द हो सकता है।";s:10:"sort_order";i:3;}i:653;a:7:{s:2:"id";i:654;s:10:"disease_id";i:174;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:43:"Physical examination is usually sufficient.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:88:"आमतौर पर शारीरिक परीक्षण द्वारा।";s:10:"sort_order";i:4;}i:654;a:7:{s:2:"id";i:655;s:10:"disease_id";i:174;s:11:"question_en";s:27:"Can Balanitis be prevented?";s:9:"answer_en";s:40:"Good personal hygiene helps reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:114:"अच्छी व्यक्तिगत स्वच्छता जोखिम कम करती है।";s:10:"sort_order";i:5;}i:655;a:7:{s:2:"id";i:656;s:10:"disease_id";i:175;s:11:"question_en";s:17:"What is Phimosis?";s:9:"answer_en";s:52:"Phimosis is inability to fully retract the foreskin.";s:11:"question_hi";s:45:"फाइमोसिस क्या है?";s:9:"answer_hi";s:140:"यह अग्रचर्म को पूरी तरह पीछे न खींच पाने की स्थिति है।";s:10:"sort_order";i:1;}i:656;a:7:{s:2:"id";i:657;s:10:"disease_id";i:175;s:11:"question_en";s:21:"What causes Phimosis?";s:9:"answer_en";s:48:"Scarring and repeated infections may contribute.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:117:"दाग और बार-बार संक्रमण इसके कारण हो सकते हैं।";s:10:"sort_order";i:2;}i:657;a:7:{s:2:"id";i:658;s:10:"disease_id";i:175;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:56:"Difficulty retracting foreskin and discomfort may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:117:"अग्रचर्म पीछे खींचने में कठिनाई और असुविधा।";s:10:"sort_order";i:3;}i:658;a:7:{s:2:"id";i:659;s:10:"disease_id";i:175;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:53:"Topical medicines or circumcision may be recommended.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:92:"दवाएं या खतना की सलाह दी जा सकती है।";s:10:"sort_order";i:4;}i:659;a:7:{s:2:"id";i:660;s:10:"disease_id";i:175;s:11:"question_en";s:22:"Can good hygiene help?";s:9:"answer_en";s:45:"Yes, proper hygiene may reduce complications.";s:11:"question_hi";s:75:"क्या स्वच्छता से लाभ होता है?";s:9:"answer_hi";s:110:"हाँ, उचित स्वच्छता जटिलताएं कम कर सकती है।";s:10:"sort_order";i:5;}i:660;a:7:{s:2:"id";i:661;s:10:"disease_id";i:176;s:11:"question_en";s:25:"What is Peyronie Disease?";s:9:"answer_en";s:68:"It is a condition causing curvature of the penis due to scar tissue.";s:11:"question_hi";s:49:"पेरोनी रोग क्या है?";s:9:"answer_hi";s:159:"यह दाग ऊतक के कारण लिंग में टेढ़ापन पैदा करने वाली स्थिति है।";s:10:"sort_order";i:1;}i:661;a:7:{s:2:"id";i:662;s:10:"disease_id";i:176;s:11:"question_en";s:29:"What causes Peyronie Disease?";s:9:"answer_en";s:57:"Minor repeated injury and genetic factors may contribute.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:145:"बार-बार छोटी चोटें और आनुवंशिक कारण योगदान कर सकते हैं।";s:10:"sort_order";i:2;}i:662;a:7:{s:2:"id";i:663;s:10:"disease_id";i:176;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:68:"Penile curvature, pain, and difficulty during intercourse may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:129:"लिंग में टेढ़ापन, दर्द और संबंध बनाने में कठिनाई।";s:10:"sort_order";i:3;}i:663;a:7:{s:2:"id";i:664;s:10:"disease_id";i:176;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:43:"Physical examination is usually sufficient.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:88:"आमतौर पर शारीरिक परीक्षण द्वारा।";s:10:"sort_order";i:4;}i:664;a:7:{s:2:"id";i:665;s:10:"disease_id";i:176;s:11:"question_en";s:32:"Can Peyronie Disease be treated?";s:9:"answer_en";s:57:"Yes, medicines and surgery may be used in selected cases.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:147:"हाँ, कुछ मामलों में दवाएं और सर्जरी उपयोग की जा सकती हैं।";s:10:"sort_order";i:5;}i:665;a:7:{s:2:"id";i:666;s:10:"disease_id";i:177;s:11:"question_en";s:21:"What is Hypogonadism?";s:9:"answer_en";s:81:"Hypogonadism is a condition in which the body produces insufficient sex hormones.";s:11:"question_hi";s:63:"हाइपोगोनाडिज्म क्या है?";s:9:"answer_hi";s:163:"यह ऐसी स्थिति है जिसमें शरीर पर्याप्त यौन हार्मोन नहीं बनाता।";s:10:"sort_order";i:1;}i:666;a:7:{s:2:"id";i:667;s:10:"disease_id";i:177;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:65:"Fatigue, low libido, and reduced muscle mass are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:119:"थकान, कामेच्छा में कमी और मांसपेशियों की कमी।";s:10:"sort_order";i:2;}i:667;a:7:{s:2:"id";i:668;s:10:"disease_id";i:177;s:11:"question_en";s:25:"What causes Hypogonadism?";s:9:"answer_en";s:63:"Hormonal disorders, aging, and genetic conditions may cause it.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:118:"हार्मोनल विकार, बढ़ती उम्र और आनुवंशिक कारण।";s:10:"sort_order";i:3;}i:668;a:7:{s:2:"id";i:669;s:10:"disease_id";i:177;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:57:"Hormone testing and medical evaluation are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:122:"हार्मोन जांच और चिकित्सकीय मूल्यांकन द्वारा।";s:10:"sort_order";i:4;}i:669;a:7:{s:2:"id";i:670;s:10:"disease_id";i:177;s:11:"question_en";s:28:"Can Hypogonadism be treated?";s:9:"answer_en";s:47:"Yes, treatment depends on the underlying cause.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:101:"हाँ, उपचार इसके कारण पर निर्भर करता है।";s:10:"sort_order";i:5;}i:670;a:7:{s:2:"id";i:671;s:10:"disease_id";i:178;s:11:"question_en";s:23:"What is Cryptorchidism?";s:9:"answer_en";s:70:"It is a condition where one or both testicles do not descend properly.";s:11:"question_hi";s:72:"क्रिप्टॉर्किडिज्म क्या है?";s:9:"answer_hi";s:145:"यह स्थिति है जिसमें एक या दोनों अंडकोष नीचे नहीं उतरते।";s:10:"sort_order";i:1;}i:671;a:7:{s:2:"id";i:672;s:10:"disease_id";i:178;s:11:"question_en";s:29:"When is it usually diagnosed?";s:9:"answer_en";s:52:"It is usually diagnosed during infancy or childhood.";s:11:"question_hi";s:53:"यह कब पहचाना जाता है?";s:9:"answer_hi";s:89:"आमतौर पर शिशु या बाल्यावस्था में।";s:10:"sort_order";i:2;}i:672;a:7:{s:2:"id";i:673;s:10:"disease_id";i:178;s:11:"question_en";s:27:"Why is treatment important?";s:9:"answer_en";s:53:"Untreated cases may affect fertility and cancer risk.";s:11:"question_hi";s:58:"उपचार क्यों आवश्यक है?";s:9:"answer_hi";s:171:"उपचार न होने पर प्रजनन क्षमता और कैंसर जोखिम प्रभावित हो सकता है।";s:10:"sort_order";i:3;}i:673;a:7:{s:2:"id";i:674;s:10:"disease_id";i:178;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:45:"Physical examination and imaging may be used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:94:"शारीरिक परीक्षण और इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:674;a:7:{s:2:"id";i:675;s:10:"disease_id";i:178;s:11:"question_en";s:17:"Can surgery help?";s:9:"answer_en";s:34:"Yes, surgery is often recommended.";s:11:"question_hi";s:69:"क्या सर्जरी से लाभ होता है?";s:9:"answer_hi";s:95:"हाँ, अक्सर सर्जरी की सलाह दी जाती है।";s:10:"sort_order";i:5;}i:675;a:7:{s:2:"id";i:676;s:10:"disease_id";i:179;s:11:"question_en";s:23:"What are Genital Warts?";s:9:"answer_en";s:50:"Genital warts are growths caused by HPV infection.";s:11:"question_hi";s:58:"जननांग मस्से क्या हैं?";s:9:"answer_hi";s:109:"ये एचपीवी संक्रमण से होने वाले मस्से हैं।";s:10:"sort_order";i:1;}i:676;a:7:{s:2:"id";i:677;s:10:"disease_id";i:179;s:11:"question_en";s:28:"How do Genital Warts spread?";s:9:"answer_en";s:47:"They are usually spread through sexual contact.";s:11:"question_hi";s:46:"ये कैसे फैलते हैं?";s:9:"answer_hi";s:87:"आमतौर पर यौन संपर्क से फैलते हैं।";s:10:"sort_order";i:2;}i:677;a:7:{s:2:"id";i:678;s:10:"disease_id";i:179;s:11:"question_en";s:31:"Can Genital Warts be prevented?";s:9:"answer_en";s:41:"HPV vaccination and safe sex reduce risk.";s:11:"question_hi";s:59:"क्या इनसे बचाव संभव है?";s:9:"answer_hi";s:133:"एचपीवी टीकाकरण और सुरक्षित यौन व्यवहार सहायक हैं।";s:10:"sort_order";i:3;}i:678;a:7:{s:2:"id";i:679;s:10:"disease_id";i:179;s:11:"question_en";s:23:"How are they diagnosed?";s:9:"answer_en";s:51:"Diagnosis is usually based on physical examination.";s:11:"question_hi";s:75:"इनका निदान कैसे किया जाता है?";s:9:"answer_hi";s:88:"आमतौर पर शारीरिक परीक्षण द्वारा।";s:10:"sort_order";i:4;}i:679;a:7:{s:2:"id";i:680;s:10:"disease_id";i:179;s:11:"question_en";s:27:"Can treatment remove warts?";s:9:"answer_en";s:55:"Yes, medicines and procedures can remove visible warts.";s:11:"question_hi";s:82:"क्या उपचार से मस्से हट सकते हैं?";s:9:"answer_hi";s:120:"हाँ, दवाओं और प्रक्रियाओं से हटाए जा सकते हैं।";s:10:"sort_order";i:5;}i:680;a:7:{s:2:"id";i:681;s:10:"disease_id";i:180;s:11:"question_en";s:27:"What is Male Breast Cancer?";s:9:"answer_en";s:52:"It is a rare cancer occurring in male breast tissue.";s:11:"question_hi";s:65:"पुरुष स्तन कैंसर क्या है?";s:9:"answer_hi";s:139:"यह पुरुषों के स्तन ऊतक में होने वाला दुर्लभ कैंसर है।";s:10:"sort_order";i:1;}i:681;a:7:{s:2:"id";i:682;s:10:"disease_id";i:180;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:41:"A lump in the breast is a common symptom.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:83:"स्तन में गांठ सामान्य लक्षण है।";s:10:"sort_order";i:2;}i:682;a:7:{s:2:"id";i:683;s:10:"disease_id";i:180;s:11:"question_en";s:22:"Who is at higher risk?";s:9:"answer_en";s:52:"Family history and hormonal disorders increase risk.";s:11:"question_hi";s:85:"किन लोगों में जोखिम अधिक होता है?";s:9:"answer_hi";s:136:"पारिवारिक इतिहास और हार्मोनल विकार वाले लोगों में।";s:10:"sort_order";i:3;}i:683;a:7:{s:2:"id";i:684;s:10:"disease_id";i:180;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:37:"Imaging and biopsy are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:75:"इमेजिंग और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:684;a:7:{s:2:"id";i:685;s:10:"disease_id";i:180;s:11:"question_en";s:34:"Can Male Breast Cancer be treated?";s:9:"answer_en";s:48:"Yes, surgery and cancer therapies are available.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:100:"हाँ, सर्जरी और कैंसर उपचार उपलब्ध हैं।";s:10:"sort_order";i:5;}i:685;a:7:{s:2:"id";i:686;s:10:"disease_id";i:181;s:11:"question_en";s:13:"What is PCOS?";s:9:"answer_en";s:55:"PCOS is a hormonal disorder affecting ovarian function.";s:11:"question_hi";s:42:"पीसीओएस क्या है?";s:9:"answer_hi";s:175:"यह अंडाशय की कार्यक्षमता को प्रभावित करने वाला हार्मोनल विकार है।";s:10:"sort_order";i:1;}i:686;a:7:{s:2:"id";i:687;s:10:"disease_id";i:181;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:52:"Irregular periods, weight gain, and acne are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:109:"अनियमित मासिक धर्म, वजन बढ़ना और मुंहासे।";s:10:"sort_order";i:2;}i:687;a:7:{s:2:"id";i:688;s:10:"disease_id";i:181;s:11:"question_en";s:17:"What causes PCOS?";s:9:"answer_en";s:61:"Hormonal imbalance and insulin resistance are common factors.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:106:"हार्मोन असंतुलन और इंसुलिन रेजिस्टेंस।";s:10:"sort_order";i:3;}i:688;a:7:{s:2:"id";i:689;s:10:"disease_id";i:181;s:11:"question_en";s:22:"How is PCOS diagnosed?";s:9:"answer_en";s:47:"Hormone tests and ultrasound are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:100:"हार्मोन जांच और अल्ट्रासाउंड द्वारा।";s:10:"sort_order";i:4;}i:689;a:7:{s:2:"id";i:690;s:10:"disease_id";i:181;s:11:"question_en";s:27:"Can lifestyle changes help?";s:9:"answer_en";s:46:"Yes, healthy diet and exercise are beneficial.";s:11:"question_hi";s:91:"क्या जीवनशैली सुधार से लाभ होता है?";s:9:"answer_hi";s:106:"हाँ, स्वस्थ आहार और व्यायाम लाभकारी हैं।";s:10:"sort_order";i:5;}i:690;a:7:{s:2:"id";i:691;s:10:"disease_id";i:182;s:11:"question_en";s:22:"What is Endometriosis?";s:9:"answer_en";s:86:"It is a condition where tissue similar to the uterine lining grows outside the uterus.";s:11:"question_hi";s:66:"एंडोमेट्रियोसिस क्या है?";s:9:"answer_hi";s:161:"यह ऐसी स्थिति है जिसमें गर्भाशय जैसी ऊतक वृद्धि बाहर होती है।";s:10:"sort_order";i:1;}i:691;a:7:{s:2:"id";i:692;s:10:"disease_id";i:182;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:43:"Pelvic pain and painful periods are common.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:95:"पेल्विक दर्द और दर्दनाक मासिक धर्म।";s:10:"sort_order";i:2;}i:692;a:7:{s:2:"id";i:693;s:10:"disease_id";i:182;s:11:"question_en";s:35:"Can Endometriosis affect fertility?";s:9:"answer_en";s:43:"Yes, it may affect fertility in some women.";s:11:"question_hi";s:117:"क्या यह प्रजनन क्षमता को प्रभावित कर सकता है?";s:9:"answer_hi";s:92:"हाँ, कुछ महिलाओं में ऐसा हो सकता है।";s:10:"sort_order";i:3;}i:693;a:7:{s:2:"id";i:694;s:10:"disease_id";i:182;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:39:"Ultrasound and laparoscopy may be used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:102:"अल्ट्रासाउंड और लैप्रोस्कोपी द्वारा।";s:10:"sort_order";i:4;}i:694;a:7:{s:2:"id";i:695;s:10:"disease_id";i:182;s:11:"question_en";s:29:"Can Endometriosis be treated?";s:9:"answer_en";s:36:"Yes, medicines and surgery may help.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:101:"हाँ, दवाएं और सर्जरी सहायक हो सकती हैं।";s:10:"sort_order";i:5;}i:695;a:7:{s:2:"id";i:696;s:10:"disease_id";i:183;s:11:"question_en";s:26:"What are Uterine Fibroids?";s:9:"answer_en";s:45:"They are non-cancerous growths in the uterus.";s:11:"question_hi";s:73:"गर्भाशय फाइब्रॉइड क्या हैं?";s:9:"answer_hi";s:137:"ये गर्भाशय में होने वाली गैर-कैंसरयुक्त गांठें हैं।";s:10:"sort_order";i:1;}i:696;a:7:{s:2:"id";i:697;s:10:"disease_id";i:183;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:55:"Heavy bleeding and pelvic pressure are common symptoms.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:85:"अधिक रक्तस्राव और पेल्विक दबाव।";s:10:"sort_order";i:2;}i:697;a:7:{s:2:"id";i:698;s:10:"disease_id";i:183;s:11:"question_en";s:23:"Are fibroids cancerous?";s:9:"answer_en";s:43:"Most fibroids are benign and not cancerous.";s:11:"question_hi";s:80:"क्या फाइब्रॉइड कैंसर होते हैं?";s:9:"answer_hi";s:109:"अधिकांश फाइब्रॉइड कैंसरयुक्त नहीं होते।";s:10:"sort_order";i:3;}i:698;a:7:{s:2:"id";i:699;s:10:"disease_id";i:183;s:11:"question_en";s:27:"How are fibroids diagnosed?";s:9:"answer_en";s:28:"Ultrasound is commonly used.";s:11:"question_hi";s:62:"इनका निदान कैसे होता है?";s:9:"answer_hi";s:81:"आमतौर पर अल्ट्रासाउंड द्वारा।";s:10:"sort_order";i:4;}i:699;a:7:{s:2:"id";i:700;s:10:"disease_id";i:183;s:11:"question_en";s:24:"Can fibroids be treated?";s:9:"answer_en";s:41:"Yes, medicines and surgery are available.";s:11:"question_hi";s:62:"क्या इनका उपचार संभव है?";s:9:"answer_hi";s:84:"हाँ, दवाएं और सर्जरी उपलब्ध हैं।";s:10:"sort_order";i:5;}i:700;a:7:{s:2:"id";i:701;s:10:"disease_id";i:184;s:11:"question_en";s:24:"What is an Ovarian Cyst?";s:9:"answer_en";s:44:"It is a fluid-filled sac in or on the ovary.";s:11:"question_hi";s:58:"ओवेरियन सिस्ट क्या है?";s:9:"answer_hi";s:104:"यह अंडाशय में बनने वाली तरल भरी थैली है।";s:10:"sort_order";i:1;}i:701;a:7:{s:2:"id";i:702;s:10:"disease_id";i:184;s:11:"question_en";s:39:"Do all ovarian cysts require treatment?";s:9:"answer_en";s:37:"Many cysts resolve without treatment.";s:11:"question_hi";s:88:"क्या सभी सिस्ट का उपचार आवश्यक है?";s:9:"answer_hi";s:101:"कई सिस्ट बिना उपचार के ठीक हो जाती हैं।";s:10:"sort_order";i:2;}i:702;a:7:{s:2:"id";i:703;s:10:"disease_id";i:184;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:35:"Pelvic pain and bloating may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:70:"पेल्विक दर्द और पेट फूलना।";s:10:"sort_order";i:3;}i:703;a:7:{s:2:"id";i:704;s:10:"disease_id";i:184;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:28:"Ultrasound is commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:81:"आमतौर पर अल्ट्रासाउंड द्वारा।";s:10:"sort_order";i:4;}i:704;a:7:{s:2:"id";i:705;s:10:"disease_id";i:184;s:11:"question_en";s:38:"Can ovarian cysts cause complications?";s:9:"answer_en";s:49:"Large cysts may occasionally cause complications.";s:11:"question_hi";s:81:"क्या इससे जटिलताएं हो सकती हैं?";s:9:"answer_hi";s:119:"बड़े सिस्ट कभी-कभी जटिलताएं पैदा कर सकते हैं।";s:10:"sort_order";i:5;}i:705;a:7:{s:2:"id";i:706;s:10:"disease_id";i:185;s:11:"question_en";s:36:"What is Pelvic Inflammatory Disease?";s:9:"answer_en";s:49:"It is an infection of female reproductive organs.";s:11:"question_hi";s:92:"पेल्विक इंफ्लेमेटरी डिजीज क्या है?";s:9:"answer_hi";s:96:"यह महिला प्रजनन अंगों का संक्रमण है।";s:10:"sort_order";i:1;}i:706;a:7:{s:2:"id";i:707;s:10:"disease_id";i:185;s:11:"question_en";s:16:"What causes PID?";s:9:"answer_en";s:50:"Sexually transmitted infections are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:111:"यौन संचारित संक्रमण इसके प्रमुख कारण हैं।";s:10:"sort_order";i:2;}i:707;a:7:{s:2:"id";i:708;s:10:"disease_id";i:185;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:53:"Pelvic pain, fever, and abnormal discharge may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:102:"पेल्विक दर्द, बुखार और असामान्य स्राव।";s:10:"sort_order";i:3;}i:708;a:7:{s:2:"id";i:709;s:10:"disease_id";i:185;s:11:"question_en";s:21:"How is PID diagnosed?";s:9:"answer_en";s:49:"Pelvic examination and laboratory tests are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:116:"पेल्विक परीक्षण और प्रयोगशाला जांच द्वारा।";s:10:"sort_order";i:4;}i:709;a:7:{s:2:"id";i:710;s:10:"disease_id";i:185;s:11:"question_en";s:25:"Can PID affect fertility?";s:9:"answer_en";s:35:"Untreated PID may affect fertility.";s:11:"question_hi";s:117:"क्या यह प्रजनन क्षमता को प्रभावित कर सकता है?";s:9:"answer_hi";s:52:"उपचार न होने पर हाँ।";s:10:"sort_order";i:5;}i:710;a:7:{s:2:"id";i:711;s:10:"disease_id";i:186;s:11:"question_en";s:24:"What is Cervical Cancer?";s:9:"answer_en";s:41:"It is cancer that develops in the cervix.";s:11:"question_hi";s:61:"सर्वाइकल कैंसर क्या है?";s:9:"answer_hi";s:128:"यह गर्भाशय ग्रीवा में विकसित होने वाला कैंसर है।";s:10:"sort_order";i:1;}i:711;a:7:{s:2:"id";i:712;s:10:"disease_id";i:186;s:11:"question_en";s:28:"What causes Cervical Cancer?";s:9:"answer_en";s:44:"Persistent HPV infection is the major cause.";s:11:"question_hi";s:68:"इसके प्रमुख कारण क्या हैं?";s:9:"answer_hi";s:114:"लगातार एचपीवी संक्रमण इसका प्रमुख कारण है।";s:10:"sort_order";i:2;}i:712;a:7:{s:2:"id";i:713;s:10:"disease_id";i:186;s:11:"question_en";s:33:"Can Cervical Cancer be prevented?";s:9:"answer_en";s:46:"HPV vaccination and screening help prevention.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:108:"एचपीवी टीकाकरण और नियमित जांच सहायक हैं।";s:10:"sort_order";i:3;}i:713;a:7:{s:2:"id";i:714;s:10:"disease_id";i:186;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:44:"Pap smear, HPV testing, and biopsy are used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:115:"पैप स्मीयर, एचपीवी जांच और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:714;a:7:{s:2:"id";i:715;s:10:"disease_id";i:186;s:11:"question_en";s:29:"Is Cervical Cancer treatable?";s:9:"answer_en";s:44:"Yes, early-stage disease is often treatable.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:100:"हाँ, शुरुआती अवस्था में उपचार संभव है।";s:10:"sort_order";i:5;}i:715;a:7:{s:2:"id";i:716;s:10:"disease_id";i:187;s:11:"question_en";s:23:"What is Ovarian Cancer?";s:9:"answer_en";s:65:"Ovarian cancer is a malignant tumor that develops in the ovaries.";s:11:"question_hi";s:58:"ओवेरियन कैंसर क्या है?";s:9:"answer_hi";s:119:"यह अंडाशय में विकसित होने वाला घातक कैंसर है।";s:10:"sort_order";i:1;}i:716;a:7:{s:2:"id";i:717;s:10:"disease_id";i:187;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:74:"Abdominal bloating, pelvic pain, and loss of appetite are common symptoms.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:101:"पेट फूलना, पेल्विक दर्द और भूख कम लगना।";s:10:"sort_order";i:2;}i:717;a:7:{s:2:"id";i:718;s:10:"disease_id";i:187;s:11:"question_en";s:22:"Who is at higher risk?";s:9:"answer_en";s:64:"Women with family history or genetic mutations have higher risk.";s:11:"question_hi";s:85:"किन लोगों में जोखिम अधिक होता है?";s:9:"answer_hi";s:151:"पारिवारिक इतिहास या आनुवंशिक परिवर्तन वाली महिलाओं में।";s:10:"sort_order";i:3;}i:718;a:7:{s:2:"id";i:719;s:10:"disease_id";i:187;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:50:"Ultrasound, CT scan, and biopsy are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:120:"अल्ट्रासाउंड, सीटी स्कैन और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:719;a:7:{s:2:"id";i:720;s:10:"disease_id";i:187;s:11:"question_en";s:30:"Can Ovarian Cancer be treated?";s:9:"answer_en";s:52:"Yes, surgery and cancer therapies are commonly used.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:100:"हाँ, सर्जरी और कैंसर उपचार उपलब्ध हैं।";s:10:"sort_order";i:5;}i:720;a:7:{s:2:"id";i:721;s:10:"disease_id";i:188;s:11:"question_en";s:27:"What is Endometrial Cancer?";s:9:"answer_en";s:55:"It is cancer that develops in the lining of the uterus.";s:11:"question_hi";s:73:"एंडोमेट्रियल कैंसर क्या है?";s:9:"answer_hi";s:148:"यह गर्भाशय की अंदरूनी परत में विकसित होने वाला कैंसर है।";s:10:"sort_order";i:1;}i:721;a:7:{s:2:"id";i:722;s:10:"disease_id";i:188;s:11:"question_en";s:25:"What is a common symptom?";s:9:"answer_en";s:46:"Abnormal uterine bleeding is a common symptom.";s:11:"question_hi";s:71:"इसका सामान्य लक्षण क्या है?";s:9:"answer_hi";s:77:"असामान्य गर्भाशय रक्तस्राव।";s:10:"sort_order";i:2;}i:722;a:7:{s:2:"id";i:723;s:10:"disease_id";i:188;s:11:"question_en";s:24:"What increases the risk?";s:9:"answer_en";s:45:"Obesity and hormonal imbalance increase risk.";s:11:"question_hi";s:75:"जोखिम किन कारणों से बढ़ता है?";s:9:"answer_hi";s:72:"मोटापा और हार्मोन असंतुलन।";s:10:"sort_order";i:3;}i:723;a:7:{s:2:"id";i:724;s:10:"disease_id";i:188;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:45:"Biopsy and imaging studies are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:75:"बायोप्सी और इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:724;a:7:{s:2:"id";i:725;s:10:"disease_id";i:188;s:11:"question_en";s:16:"Can it be cured?";s:9:"answer_en";s:39:"Early-stage disease is often treatable.";s:11:"question_hi";s:57:"क्या यह ठीक हो सकता है?";s:9:"answer_hi";s:89:"शुरुआती अवस्था में उपचार संभव है।";s:10:"sort_order";i:5;}i:725;a:7:{s:2:"id";i:726;s:10:"disease_id";i:189;s:11:"question_en";s:18:"What is Vaginitis?";s:9:"answer_en";s:53:"Vaginitis is inflammation or infection of the vagina.";s:11:"question_hi";s:51:"वैजिनाइटिस क्या है?";s:9:"answer_hi";s:78:"यह योनि की सूजन या संक्रमण है।";s:10:"sort_order";i:1;}i:726;a:7:{s:2:"id";i:727;s:10:"disease_id";i:189;s:11:"question_en";s:22:"What causes Vaginitis?";s:9:"answer_en";s:61:"Bacterial, fungal, or parasitic infections are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:95:"बैक्टीरियल, फंगल या परजीवी संक्रमण।";s:10:"sort_order";i:2;}i:727;a:7:{s:2:"id";i:728;s:10:"disease_id";i:189;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:55:"Itching, discharge, and irritation are common symptoms.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:52:"खुजली, स्राव और जलन।";s:10:"sort_order";i:3;}i:728;a:7:{s:2:"id";i:729;s:10:"disease_id";i:189;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:51:"Physical examination and laboratory tests are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:94:"परीक्षण और प्रयोगशाला जांच द्वारा।";s:10:"sort_order";i:4;}i:729;a:7:{s:2:"id";i:730;s:10:"disease_id";i:189;s:11:"question_en";s:27:"Can Vaginitis be prevented?";s:9:"answer_en";s:51:"Good hygiene and timely treatment help reduce risk.";s:11:"question_hi";s:59:"क्या इससे बचाव संभव है?";s:9:"answer_hi";s:109:"अच्छी स्वच्छता और समय पर उपचार सहायक हैं।";s:10:"sort_order";i:5;}i:730;a:7:{s:2:"id";i:731;s:10:"disease_id";i:190;s:11:"question_en";s:19:"What is Vulvodynia?";s:9:"answer_en";s:61:"It is chronic pain around the vulva without an obvious cause.";s:11:"question_hi";s:57:"वल्वोडाइनिया क्या है?";s:9:"answer_hi";s:134:"यह वल्वा क्षेत्र में दीर्घकालिक दर्द की स्थिति है।";s:10:"sort_order";i:1;}i:731;a:7:{s:2:"id";i:732;s:10:"disease_id";i:190;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:44:"Burning, stinging, and discomfort may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:55:"जलन, चुभन और असुविधा।";s:10:"sort_order";i:2;}i:732;a:7:{s:2:"id";i:733;s:10:"disease_id";i:190;s:11:"question_en";s:23:"What causes Vulvodynia?";s:9:"answer_en";s:33:"The exact cause is often unknown.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:83:"सटीक कारण अक्सर अज्ञात होता है।";s:10:"sort_order";i:3;}i:733;a:7:{s:2:"id";i:734;s:10:"disease_id";i:190;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:65:"Diagnosis is based on symptoms and exclusion of other conditions.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:116:"अन्य कारणों को बाहर करके निदान किया जाता है।";s:10:"sort_order";i:4;}i:734;a:7:{s:2:"id";i:735;s:10:"disease_id";i:190;s:11:"question_en";s:19:"Can treatment help?";s:9:"answer_en";s:49:"Yes, symptom management strategies are available.";s:11:"question_hi";s:69:"क्या उपचार से लाभ मिलता है?";s:9:"answer_hi";s:103:"हाँ, लक्षण नियंत्रण के उपाय उपलब्ध हैं।";s:10:"sort_order";i:5;}i:735;a:7:{s:2:"id";i:736;s:10:"disease_id";i:191;s:11:"question_en";s:19:"What is Amenorrhea?";s:9:"answer_en";s:47:"Amenorrhea is the absence of menstrual periods.";s:11:"question_hi";s:48:"अमेनोरिया क्या है?";s:9:"answer_hi";s:65:"यह मासिक धर्म का अभाव है।";s:10:"sort_order";i:1;}i:736;a:7:{s:2:"id";i:737;s:10:"disease_id";i:191;s:11:"question_en";s:23:"What causes Amenorrhea?";s:9:"answer_en";s:51:"Hormonal imbalance and pregnancy are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:84:"हार्मोन असंतुलन और गर्भावस्था।";s:10:"sort_order";i:2;}i:737;a:7:{s:2:"id";i:738;s:10:"disease_id";i:191;s:11:"question_en";s:28:"Can stress cause Amenorrhea?";s:9:"answer_en";s:34:"Yes, severe stress may contribute.";s:11:"question_hi";s:79:"क्या तनाव इसका कारण बन सकता है?";s:9:"answer_hi";s:94:"हाँ, अत्यधिक तनाव योगदान कर सकता है।";s:10:"sort_order";i:3;}i:738;a:7:{s:2:"id";i:739;s:10:"disease_id";i:191;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:46:"Hormone tests and medical evaluation are used.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:122:"हार्मोन जांच और चिकित्सकीय मूल्यांकन द्वारा।";s:10:"sort_order";i:4;}i:739;a:7:{s:2:"id";i:740;s:10:"disease_id";i:191;s:11:"question_en";s:26:"Can Amenorrhea be treated?";s:9:"answer_en";s:42:"Treatment depends on the underlying cause.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:88:"हाँ, उपचार कारण पर निर्भर करता है।";s:10:"sort_order";i:5;}i:740;a:7:{s:2:"id";i:741;s:10:"disease_id";i:192;s:11:"question_en";s:21:"What is Dysmenorrhea?";s:9:"answer_en";s:49:"Dysmenorrhea refers to painful menstrual periods.";s:11:"question_hi";s:54:"डिसमेनोरिया क्या है?";s:9:"answer_hi";s:99:"यह दर्दयुक्त मासिक धर्म की स्थिति है।";s:10:"sort_order";i:1;}i:741;a:7:{s:2:"id";i:742;s:10:"disease_id";i:192;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:34:"Lower abdominal cramps are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:51:"निचले पेट में ऐंठन।";s:10:"sort_order";i:2;}i:742;a:7:{s:2:"id";i:743;s:10:"disease_id";i:192;s:11:"question_en";s:25:"What causes Dysmenorrhea?";s:9:"answer_en";s:53:"Hormonal factors and uterine contractions contribute.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:88:"हार्मोनल कारक और गर्भाशय संकुचन।";s:10:"sort_order";i:3;}i:743;a:7:{s:2:"id";i:744;s:10:"disease_id";i:192;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:47:"Diagnosis is based on symptoms and examination.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:80:"लक्षणों और परीक्षण के आधार पर।";s:10:"sort_order";i:4;}i:744;a:7:{s:2:"id";i:745;s:10:"disease_id";i:192;s:11:"question_en";s:18:"Can exercise help?";s:9:"answer_en";s:42:"Yes, regular exercise may reduce symptoms.";s:11:"question_hi";s:64:"क्या व्यायाम लाभदायक है?";s:9:"answer_hi";s:103:"हाँ, नियमित व्यायाम लाभकारी हो सकता है।";s:10:"sort_order";i:5;}i:745;a:7:{s:2:"id";i:746;s:10:"disease_id";i:193;s:11:"question_en";s:20:"What is Menorrhagia?";s:9:"answer_en";s:52:"Menorrhagia is excessively heavy menstrual bleeding.";s:11:"question_hi";s:51:"मेनोरेजिया क्या है?";s:9:"answer_hi";s:108:"यह अत्यधिक मासिक रक्तस्राव की स्थिति है।";s:10:"sort_order";i:1;}i:746;a:7:{s:2:"id";i:747;s:10:"disease_id";i:193;s:11:"question_en";s:24:"What causes Menorrhagia?";s:9:"answer_en";s:59:"Hormonal imbalance and uterine disorders are common causes.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:91:"हार्मोन असंतुलन और गर्भाशय विकार।";s:10:"sort_order";i:2;}i:747;a:7:{s:2:"id";i:748;s:10:"disease_id";i:193;s:11:"question_en";s:29:"Can Menorrhagia cause anemia?";s:9:"answer_en";s:49:"Yes, prolonged heavy bleeding may lead to anemia.";s:11:"question_hi";s:75:"क्या इससे एनीमिया हो सकता है?";s:9:"answer_hi";s:127:"हाँ, लंबे समय तक रक्तस्राव से एनीमिया हो सकता है।";s:10:"sort_order";i:3;}i:748;a:7:{s:2:"id";i:749;s:10:"disease_id";i:193;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:49:"Blood tests and pelvic imaging are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:98:"रक्त जांच और पेल्विक इमेजिंग द्वारा।";s:10:"sort_order";i:4;}i:749;a:7:{s:2:"id";i:750;s:10:"disease_id";i:193;s:11:"question_en";s:18:"Can it be treated?";s:9:"answer_en";s:44:"Yes, medicines and procedures are available.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:99:"हाँ, दवाएं और प्रक्रियाएं उपलब्ध हैं।";s:10:"sort_order";i:5;}i:750;a:7:{s:2:"id";i:751;s:10:"disease_id";i:194;s:11:"question_en";s:30:"What is Premenstrual Syndrome?";s:9:"answer_en";s:57:"PMS is a group of symptoms occurring before menstruation.";s:11:"question_hi";s:91:"प्रीमेंस्ट्रुअल सिंड्रोम क्या है?";s:9:"answer_hi";s:133:"यह मासिक धर्म से पहले होने वाले लक्षणों का समूह है।";s:10:"sort_order";i:1;}i:751;a:7:{s:2:"id";i:752;s:10:"disease_id";i:194;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:47:"Mood changes, bloating, and fatigue are common.";s:11:"question_hi";s:74:"इसके सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:84:"मूड परिवर्तन, पेट फूलना और थकान।";s:10:"sort_order";i:2;}i:752;a:7:{s:2:"id";i:753;s:10:"disease_id";i:194;s:11:"question_en";s:16:"What causes PMS?";s:9:"answer_en";s:56:"Hormonal fluctuations are believed to play a major role.";s:11:"question_hi";s:49:"इसके कारण क्या हैं?";s:9:"answer_hi";s:124:"हार्मोनल उतार-चढ़ाव प्रमुख कारण माने जाते हैं।";s:10:"sort_order";i:3;}i:753;a:7:{s:2:"id";i:754;s:10:"disease_id";i:194;s:11:"question_en";s:21:"How is PMS diagnosed?";s:9:"answer_en";s:49:"Diagnosis is based on recurring symptom patterns.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:97:"बार-बार होने वाले लक्षणों के आधार पर।";s:10:"sort_order";i:4;}i:754;a:7:{s:2:"id";i:755;s:10:"disease_id";i:194;s:11:"question_en";s:27:"Can lifestyle changes help?";s:9:"answer_en";s:51:"Yes, exercise and stress management are beneficial.";s:11:"question_hi";s:91:"क्या जीवनशैली सुधार से लाभ होता है?";s:9:"answer_hi";s:112:"हाँ, व्यायाम और तनाव नियंत्रण लाभकारी हैं।";s:10:"sort_order";i:5;}i:755;a:7:{s:2:"id";i:756;s:10:"disease_id";i:195;s:11:"question_en";s:13:"What is PMDD?";s:9:"answer_en";s:47:"PMDD is a severe form of premenstrual syndrome.";s:11:"question_hi";s:45:"पीएमडीडी क्या है?";s:9:"answer_hi";s:68:"यह पीएमएस का गंभीर रूप है।";s:10:"sort_order";i:1;}i:756;a:7:{s:2:"id";i:757;s:10:"disease_id";i:195;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:60:"Severe mood changes, irritability, and depression may occur.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:111:"गंभीर मूड परिवर्तन, चिड़चिड़ापन और अवसाद।";s:10:"sort_order";i:2;}i:757;a:7:{s:2:"id";i:758;s:10:"disease_id";i:195;s:11:"question_en";s:31:"How is PMDD different from PMS?";s:9:"answer_en";s:43:"PMDD causes more severe emotional symptoms.";s:11:"question_hi";s:63:"यह पीएमएस से कैसे अलग है?";s:9:"answer_hi";s:105:"इसमें मानसिक लक्षण अधिक गंभीर होते हैं।";s:10:"sort_order";i:3;}i:758;a:7:{s:2:"id";i:759;s:10:"disease_id";i:195;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:54:"Diagnosis is based on symptom tracking and evaluation.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:125:"लक्षण रिकॉर्ड और चिकित्सकीय मूल्यांकन द्वारा।";s:10:"sort_order";i:4;}i:759;a:7:{s:2:"id";i:760;s:10:"disease_id";i:195;s:11:"question_en";s:20:"Can PMDD be treated?";s:9:"answer_en";s:47:"Yes, medicines and lifestyle measures may help.";s:11:"question_hi";s:62:"क्या इसका उपचार संभव है?";s:9:"answer_hi";s:103:"हाँ, दवाएं और जीवनशैली सुधार सहायक हैं।";s:10:"sort_order";i:5;}i:760;a:7:{s:2:"id";i:761;s:10:"disease_id";i:196;s:11:"question_en";s:26:"What is Ectopic Pregnancy?";s:9:"answer_en";s:60:"It occurs when a fertilized egg implants outside the uterus.";s:11:"question_hi";s:79:"एक्टोपिक प्रेग्नेंसी क्या है?";s:9:"answer_hi";s:170:"यह स्थिति है जिसमें निषेचित अंडा गर्भाशय के बाहर विकसित होता है।";s:10:"sort_order";i:1;}i:761;a:7:{s:2:"id";i:762;s:10:"disease_id";i:196;s:11:"question_en";s:31:"Is Ectopic Pregnancy dangerous?";s:9:"answer_en";s:39:"Yes, it can become a medical emergency.";s:11:"question_hi";s:46:"क्या यह खतरनाक है?";s:9:"answer_hi";s:104:"हाँ, यह चिकित्सा आपात स्थिति बन सकती है।";s:10:"sort_order";i:2;}i:762;a:7:{s:2:"id";i:763;s:10:"disease_id";i:196;s:11:"question_en";s:20:"What symptoms occur?";s:9:"answer_en";s:56:"Abdominal pain and vaginal bleeding are common symptoms.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:80:"पेट दर्द और योनि से रक्तस्राव।";s:10:"sort_order";i:3;}i:763;a:7:{s:2:"id";i:764;s:10:"disease_id";i:196;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:45:"Ultrasound and blood tests are commonly used.";s:11:"question_hi";s:75:"इसका निदान कैसे किया जाता है?";s:9:"answer_hi";s:91:"अल्ट्रासाउंड और रक्त जांच द्वारा।";s:10:"sort_order";i:4;}i:764;a:7:{s:2:"id";i:765;s:10:"disease_id";i:196;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:37:"Medicines or surgery may be required.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:103:"दवाओं या सर्जरी की आवश्यकता हो सकती है।";s:10:"sort_order";i:5;}i:765;a:7:{s:2:"id";i:766;s:10:"disease_id";i:197;s:11:"question_en";s:20:"What is miscarriage?";s:9:"answer_en";s:53:"Miscarriage is the loss of pregnancy before 20 weeks.";s:11:"question_hi";s:42:"गर्भपात क्या है?";s:9:"answer_hi";s:151:"20 सप्ताह से पहले गर्भ का समाप्त हो जाना गर्भपात कहलाता है।";s:10:"sort_order";i:1;}i:766;a:7:{s:2:"id";i:767;s:10:"disease_id";i:197;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:59:"Bleeding, cramping, and tissue passage are common symptoms.";s:11:"question_hi";s:61:"सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:138:"रक्तस्राव, पेट दर्द और ऊतक निकलना सामान्य लक्षण हैं।";s:10:"sort_order";i:2;}i:767;a:7:{s:2:"id";i:768;s:10:"disease_id";i:197;s:11:"question_en";s:29:"Can miscarriage be prevented?";s:9:"answer_en";s:74:"Not all miscarriages can be prevented, but healthy habits may reduce risk.";s:11:"question_hi";s:75:"क्या गर्भपात रोका जा सकता है?";s:9:"answer_hi";s:185:"सभी गर्भपात नहीं रोके जा सकते, लेकिन स्वस्थ आदतें जोखिम कम कर सकती हैं।";s:10:"sort_order";i:3;}i:768;a:7:{s:2:"id";i:769;s:10:"disease_id";i:197;s:11:"question_en";s:45:"Does one miscarriage affect future pregnancy?";s:9:"answer_en";s:46:"Most women have successful future pregnancies.";s:11:"question_hi";s:151:"क्या एक गर्भपात भविष्य की गर्भावस्था को प्रभावित करता है?";s:9:"answer_hi";s:143:"अधिकांश महिलाओं की भविष्य में सफल गर्भावस्था होती है।";s:10:"sort_order";i:4;}i:769;a:7:{s:2:"id";i:770;s:10:"disease_id";i:197;s:11:"question_en";s:35:"When should medical care be sought?";s:9:"answer_en";s:64:"Heavy bleeding, severe pain, or fever require medical attention.";s:11:"question_hi";s:81:"डॉक्टर से कब संपर्क करना चाहिए?";s:9:"answer_hi";s:110:"अधिक रक्तस्राव, तेज दर्द या बुखार होने पर।";s:10:"sort_order";i:5;}i:770;a:7:{s:2:"id";i:771;s:10:"disease_id";i:198;s:11:"question_en";s:27:"What is female infertility?";s:9:"answer_en";s:57:"It is the inability to conceive after one year of trying.";s:11:"question_hi";s:55:"महिला बांझपन क्या है?";s:9:"answer_hi";s:100:"एक वर्ष प्रयास के बाद गर्भधारण न होना।";s:10:"sort_order";i:1;}i:771;a:7:{s:2:"id";i:772;s:10:"disease_id";i:198;s:11:"question_en";s:24:"What causes infertility?";s:9:"answer_en";s:77:"Ovulation problems, tubal blockage, and hormonal disorders are common causes.";s:11:"question_hi";s:62:"बांझपन के कारण क्या हैं?";s:9:"answer_hi";s:133:"ओव्यूलेशन समस्या, ट्यूब रुकावट और हार्मोनल विकार।";s:10:"sort_order";i:2;}i:772;a:7:{s:2:"id";i:773;s:10:"disease_id";i:198;s:11:"question_en";s:27:"Can infertility be treated?";s:9:"answer_en";s:57:"Many causes can be treated with medication or procedures.";s:11:"question_hi";s:72:"क्या बांझपन का इलाज संभव है?";s:9:"answer_hi";s:135:"कई कारणों का उपचार दवाओं या प्रक्रियाओं से संभव है।";s:10:"sort_order";i:3;}i:773;a:7:{s:2:"id";i:774;s:10:"disease_id";i:198;s:11:"question_en";s:26:"Does age affect fertility?";s:9:"answer_en";s:34:"Yes, fertility decreases with age.";s:11:"question_hi";s:116:"क्या उम्र प्रजनन क्षमता को प्रभावित करती है?";s:9:"answer_hi";s:117:"हाँ, उम्र बढ़ने के साथ प्रजनन क्षमता घटती है।";s:10:"sort_order";i:4;}i:774;a:7:{s:2:"id";i:775;s:10:"disease_id";i:198;s:11:"question_en";s:36:"When should fertility testing begin?";s:9:"answer_en";s:60:"After one year of trying or six months if over 35 years old.";s:11:"question_hi";s:90:"फर्टिलिटी जांच कब शुरू करनी चाहिए?";s:9:"answer_hi";s:148:"एक वर्ष प्रयास के बाद या 35 वर्ष से अधिक होने पर छह माह बाद।";s:10:"sort_order";i:5;}i:775;a:7:{s:2:"id";i:776;s:10:"disease_id";i:199;s:11:"question_en";s:26:"What causes genital warts?";s:9:"answer_en";s:33:"They are caused by HPV infection.";s:11:"question_hi";s:81:"जननांग मस्से किस कारण होते हैं?";s:9:"answer_hi";s:78:"ये HPV संक्रमण के कारण होते हैं।";s:10:"sort_order";i:1;}i:776;a:7:{s:2:"id";i:777;s:10:"disease_id";i:199;s:11:"question_en";s:29:"Are genital warts contagious?";s:9:"answer_en";s:44:"Yes, they can spread through sexual contact.";s:11:"question_hi";s:83:"क्या जननांग मस्से संक्रामक हैं?";s:9:"answer_hi";s:89:"हाँ, वे यौन संपर्क से फैल सकते हैं।";s:10:"sort_order";i:2;}i:777;a:7:{s:2:"id";i:778;s:10:"disease_id";i:199;s:11:"question_en";s:29:"Can HPV vaccine prevent them?";s:9:"answer_en";s:44:"Yes, vaccination reduces risk significantly.";s:11:"question_hi";s:76:"क्या HPV टीका रोकथाम कर सकता है?";s:9:"answer_hi";s:98:"हाँ, टीकाकरण जोखिम को काफी कम करता है।";s:10:"sort_order";i:3;}i:778;a:7:{s:2:"id";i:779;s:10:"disease_id";i:199;s:11:"question_en";s:30:"Do genital warts cause cancer?";s:9:"answer_en";s:55:"The wart-causing HPV types usually do not cause cancer.";s:11:"question_hi";s:107:"क्या जननांग मस्से कैंसर का कारण बनते हैं?";s:9:"answer_hi";s:150:"मस्से पैदा करने वाले HPV प्रकार सामान्यतः कैंसर नहीं करते।";s:10:"sort_order";i:4;}i:779;a:7:{s:2:"id";i:780;s:10:"disease_id";i:199;s:11:"question_en";s:32:"Can they return after treatment?";s:9:"answer_en";s:28:"Yes, recurrence is possible.";s:11:"question_hi";s:86:"क्या उपचार के बाद फिर हो सकते हैं?";s:9:"answer_hi";s:56:"हाँ, पुनः हो सकते हैं।";s:10:"sort_order";i:5;}i:780;a:7:{s:2:"id";i:781;s:10:"disease_id";i:200;s:11:"question_en";s:22:"What is breast cancer?";s:9:"answer_en";s:44:"It is cancer that develops in breast tissue.";s:11:"question_hi";s:49:"स्तन कैंसर क्या है?";s:9:"answer_hi";s:116:"यह स्तन ऊतकों में विकसित होने वाला कैंसर है।";s:10:"sort_order";i:1;}i:781;a:7:{s:2:"id";i:782;s:10:"disease_id";i:200;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:49:"A lump, nipple changes, or breast pain may occur.";s:11:"question_hi";s:61:"सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:108:"गांठ, निप्पल में बदलाव या दर्द हो सकता है।";s:10:"sort_order";i:2;}i:782;a:7:{s:2:"id";i:783;s:10:"disease_id";i:200;s:11:"question_en";s:27:"Can breast cancer be cured?";s:9:"answer_en";s:42:"Early detection greatly improves outcomes.";s:11:"question_hi";s:79:"क्या स्तन कैंसर ठीक हो सकता है?";s:9:"answer_hi";s:112:"जल्दी पहचान होने पर परिणाम बेहतर होते हैं।";s:10:"sort_order";i:3;}i:783;a:7:{s:2:"id";i:784;s:10:"disease_id";i:200;s:11:"question_en";s:22:"Who is at higher risk?";s:9:"answer_en";s:46:"People with family history and increasing age.";s:11:"question_hi";s:62:"किसे अधिक जोखिम होता है?";s:9:"answer_hi";s:115:"पारिवारिक इतिहास और अधिक आयु वाले लोगों को।";s:10:"sort_order";i:4;}i:784;a:7:{s:2:"id";i:785;s:10:"disease_id";i:200;s:11:"question_en";s:35:"How often should screening be done?";s:9:"answer_en";s:53:"Follow medical recommendations based on age and risk.";s:11:"question_hi";s:89:"स्क्रीनिंग कितनी बार करानी चाहिए?";s:9:"answer_hi";s:115:"आयु और जोखिम के अनुसार चिकित्सकीय सलाह लें।";s:10:"sort_order";i:5;}i:785;a:7:{s:2:"id";i:786;s:10:"disease_id";i:201;s:11:"question_en";s:17:"What causes acne?";s:9:"answer_en";s:47:"Oil buildup, bacteria, and hormones contribute.";s:11:"question_hi";s:61:"मुंहासे क्यों होते हैं?";s:9:"answer_hi";s:109:"तेल, बैक्टीरिया और हार्मोन इसके कारण हैं।";s:10:"sort_order";i:1;}i:786;a:7:{s:2:"id";i:787;s:10:"disease_id";i:201;s:11:"question_en";s:23:"Can stress worsen acne?";s:9:"answer_en";s:34:"Yes, stress may trigger flare-ups.";s:11:"question_hi";s:74:"क्या तनाव मुंहासे बढ़ाता है?";s:9:"answer_hi";s:81:"हाँ, तनाव मुंहासे बढ़ा सकता है।";s:10:"sort_order";i:2;}i:787;a:7:{s:2:"id";i:788;s:10:"disease_id";i:201;s:11:"question_en";s:27:"Should pimples be squeezed?";s:9:"answer_en";s:33:"No, squeezing may cause scarring.";s:11:"question_hi";s:77:"क्या मुंहासों को दबाना चाहिए?";s:9:"answer_hi";s:72:"नहीं, इससे दाग पड़ सकते हैं।";s:10:"sort_order";i:3;}i:788;a:7:{s:2:"id";i:789;s:10:"disease_id";i:201;s:11:"question_en";s:22:"Does diet affect acne?";s:9:"answer_en";s:53:"Some individuals notice worsening with certain foods.";s:11:"question_hi";s:103:"क्या भोजन मुंहासों को प्रभावित करता है?";s:9:"answer_hi";s:135:"कुछ लोगों में कुछ खाद्य पदार्थ प्रभाव डाल सकते हैं।";s:10:"sort_order";i:4;}i:789;a:7:{s:2:"id";i:790;s:10:"disease_id";i:201;s:11:"question_en";s:20:"Can acne be treated?";s:9:"answer_en";s:45:"Yes, many effective treatments are available.";s:11:"question_hi";s:78:"क्या मुंहासों का इलाज संभव है?";s:9:"answer_hi";s:110:"हाँ, इसके लिए कई प्रभावी उपचार उपलब्ध हैं।";s:10:"sort_order";i:5;}i:790;a:7:{s:2:"id";i:791;s:10:"disease_id";i:202;s:11:"question_en";s:15:"What is eczema?";s:9:"answer_en";s:67:"Eczema is a chronic skin condition causing itchy and inflamed skin.";s:11:"question_hi";s:42:"एक्जिमा क्या है?";s:9:"answer_hi";s:153:"एक्जिमा त्वचा की दीर्घकालिक खुजली और सूजन वाली बीमारी है।";s:10:"sort_order";i:1;}i:791;a:7:{s:2:"id";i:792;s:10:"disease_id";i:202;s:11:"question_en";s:19:"What causes eczema?";s:9:"answer_en";s:59:"Genetics, allergies, and environmental triggers contribute.";s:11:"question_hi";s:58:"एक्जिमा क्यों होता है?";s:9:"answer_hi";s:146:"आनुवंशिकता, एलर्जी और पर्यावरणीय कारण योगदान देते हैं।";s:10:"sort_order";i:2;}i:792;a:7:{s:2:"id";i:793;s:10:"disease_id";i:202;s:11:"question_en";s:21:"Is eczema contagious?";s:9:"answer_en";s:49:"No, eczema does not spread from person to person.";s:11:"question_hi";s:67:"क्या एक्जिमा संक्रामक है?";s:9:"answer_hi";s:129:"नहीं, एक्जिमा एक व्यक्ति से दूसरे में नहीं फैलता।";s:10:"sort_order";i:3;}i:793;a:7:{s:2:"id";i:794;s:10:"disease_id";i:202;s:11:"question_en";s:20:"Can eczema be cured?";s:9:"answer_en";s:44:"It can be managed effectively but may recur.";s:11:"question_hi";s:95:"क्या एक्जिमा पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:142:"इसे नियंत्रित किया जा सकता है लेकिन दोबारा हो सकता है।";s:10:"sort_order";i:4;}i:794;a:7:{s:2:"id";i:795;s:10:"disease_id";i:202;s:11:"question_en";s:31:"How can flare-ups be prevented?";s:9:"answer_en";s:45:"Avoid triggers and keep the skin moisturized.";s:11:"question_hi";s:98:"एक्जिमा के दौरे कैसे रोके जा सकते हैं?";s:9:"answer_hi";s:97:"ट्रिगर्स से बचें और त्वचा को नम रखें।";s:10:"sort_order";i:5;}i:795;a:7:{s:2:"id";i:796;s:10:"disease_id";i:203;s:11:"question_en";s:18:"What is psoriasis?";s:9:"answer_en";s:68:"Psoriasis is an autoimmune skin disease causing thick scaly patches.";s:11:"question_hi";s:45:"सोरायसिस क्या है?";s:9:"answer_hi";s:188:"सोरायसिस एक ऑटोइम्यून त्वचा रोग है जिसमें मोटी पपड़ीदार त्वचा बनती है।";s:10:"sort_order";i:1;}i:796;a:7:{s:2:"id";i:797;s:10:"disease_id";i:203;s:11:"question_en";s:24:"Is psoriasis contagious?";s:9:"answer_en";s:32:"No, psoriasis is not contagious.";s:11:"question_hi";s:70:"क्या सोरायसिस संक्रामक है?";s:9:"answer_hi";s:86:"नहीं, सोरायसिस संक्रामक नहीं है।";s:10:"sort_order";i:2;}i:797;a:7:{s:2:"id";i:798;s:10:"disease_id";i:203;s:11:"question_en";s:24:"What triggers psoriasis?";s:9:"answer_en";s:60:"Stress, infections, and skin injuries may trigger flare-ups.";s:11:"question_hi";s:74:"सोरायसिस के ट्रिगर क्या हैं?";s:9:"answer_hi";s:133:"तनाव, संक्रमण और त्वचा की चोटें ट्रिगर हो सकती हैं।";s:10:"sort_order";i:3;}i:798;a:7:{s:2:"id";i:799;s:10:"disease_id";i:203;s:11:"question_en";s:28:"Can psoriasis affect joints?";s:9:"answer_en";s:47:"Yes, some patients develop psoriatic arthritis.";s:11:"question_hi";s:116:"क्या सोरायसिस जोड़ों को प्रभावित कर सकता है?";s:9:"answer_hi";s:141:"हाँ, कुछ रोगियों में सोरियाटिक आर्थराइटिस हो सकता है।";s:10:"sort_order";i:4;}i:799;a:7:{s:2:"id";i:800;s:10:"disease_id";i:203;s:11:"question_en";s:31:"Can treatment control symptoms?";s:9:"answer_en";s:42:"Yes, many treatments help reduce symptoms.";s:11:"question_hi";s:110:"क्या उपचार से लक्षण नियंत्रित हो सकते हैं?";s:9:"answer_hi";s:95:"हाँ, कई उपचार लक्षणों को कम करते हैं।";s:10:"sort_order";i:5;}i:800;a:7:{s:2:"id";i:801;s:10:"disease_id";i:204;s:11:"question_en";s:17:"What is vitiligo?";s:9:"answer_en";s:62:"Vitiligo causes loss of skin pigment leading to white patches.";s:11:"question_hi";s:45:"विटिलिगो क्या है?";s:9:"answer_hi";s:142:"विटिलिगो में त्वचा का रंग कम होकर सफेद धब्बे बनते हैं।";s:10:"sort_order";i:1;}i:801;a:7:{s:2:"id";i:802;s:10:"disease_id";i:204;s:11:"question_en";s:21:"What causes vitiligo?";s:9:"answer_en";s:58:"Autoimmune destruction of pigment cells is a common cause.";s:11:"question_hi";s:61:"विटिलिगो क्यों होता है?";s:9:"answer_hi";s:150:"रंग बनाने वाली कोशिकाओं का ऑटोइम्यून विनाश इसका कारण है।";s:10:"sort_order";i:2;}i:802;a:7:{s:2:"id";i:803;s:10:"disease_id";i:204;s:11:"question_en";s:23:"Is vitiligo contagious?";s:9:"answer_en";s:25:"No, it is not contagious.";s:11:"question_hi";s:70:"क्या विटिलिगो संक्रामक है?";s:9:"answer_hi";s:68:"नहीं, यह संक्रामक नहीं है।";s:10:"sort_order";i:3;}i:803;a:7:{s:2:"id";i:804;s:10:"disease_id";i:204;s:11:"question_en";s:20:"Can vitiligo spread?";s:9:"answer_en";s:43:"It may progress slowly in some individuals.";s:11:"question_hi";s:68:"क्या विटिलिगो फैल सकता है?";s:9:"answer_hi";s:101:"कुछ लोगों में यह धीरे-धीरे बढ़ सकता है।";s:10:"sort_order";i:4;}i:804;a:7:{s:2:"id";i:805;s:10:"disease_id";i:204;s:11:"question_en";s:19:"Can treatment help?";s:9:"answer_en";s:54:"Treatment may improve appearance and slow progression.";s:11:"question_hi";s:59:"क्या उपचार मदद करता है?";s:9:"answer_hi";s:120:"उपचार से त्वचा की स्थिति में सुधार हो सकता है।";s:10:"sort_order";i:5;}i:805;a:7:{s:2:"id";i:806;s:10:"disease_id";i:205;s:11:"question_en";s:16:"What is rosacea?";s:9:"answer_en";s:59:"Rosacea is a chronic facial skin condition causing redness.";s:11:"question_hi";s:45:"रोसैशिया क्या है?";s:9:"answer_hi";s:141:"रोसैशिया चेहरे की लालिमा पैदा करने वाला त्वचा रोग है।";s:10:"sort_order";i:1;}i:806;a:7:{s:2:"id";i:807;s:10:"disease_id";i:205;s:11:"question_en";s:22:"What triggers rosacea?";s:9:"answer_en";s:60:"Sunlight, heat, spicy foods, and stress are common triggers.";s:11:"question_hi";s:74:"रोसैशिया के ट्रिगर क्या हैं?";s:9:"answer_hi";s:139:"धूप, गर्मी, मसालेदार भोजन और तनाव सामान्य ट्रिगर हैं।";s:10:"sort_order";i:2;}i:807;a:7:{s:2:"id";i:808;s:10:"disease_id";i:205;s:11:"question_en";s:28:"Can rosacea affect the eyes?";s:9:"answer_en";s:40:"Yes, ocular rosacea can affect the eyes.";s:11:"question_hi";s:113:"क्या रोसैशिया आंखों को प्रभावित कर सकता है?";s:9:"answer_hi";s:102:"हाँ, यह आंखों को भी प्रभावित कर सकता है।";s:10:"sort_order";i:3;}i:808;a:7:{s:2:"id";i:809;s:10:"disease_id";i:205;s:11:"question_en";s:19:"Is rosacea curable?";s:9:"answer_en";s:48:"There is no cure but symptoms can be controlled.";s:11:"question_hi";s:98:"क्या रोसैशिया पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:129:"इसका स्थायी इलाज नहीं है, लेकिन नियंत्रण संभव है।";s:10:"sort_order";i:4;}i:809;a:7:{s:2:"id";i:810;s:10:"disease_id";i:205;s:11:"question_en";s:29:"How can flare-ups be reduced?";s:9:"answer_en";s:52:"Avoid known triggers and protect skin from sunlight.";s:11:"question_hi";s:62:"लक्षणों को कैसे कम करें?";s:9:"answer_hi";s:106:"ट्रिगर्स से बचें और धूप से सुरक्षा करें।";s:10:"sort_order";i:5;}i:810;a:7:{s:2:"id";i:811;s:10:"disease_id";i:206;s:11:"question_en";s:19:"What is dermatitis?";s:9:"answer_en";s:39:"Dermatitis is inflammation of the skin.";s:11:"question_hi";s:54:"डर्मेटाइटिस क्या है?";s:9:"answer_hi";s:79:"डर्मेटाइटिस त्वचा की सूजन है।";s:10:"sort_order";i:1;}i:811;a:7:{s:2:"id";i:812;s:10:"disease_id";i:206;s:11:"question_en";s:23:"What causes dermatitis?";s:9:"answer_en";s:61:"Allergens, irritants, and immune reactions are common causes.";s:11:"question_hi";s:70:"डर्मेटाइटिस क्यों होता है?";s:9:"answer_hi";s:159:"एलर्जी, रसायन और प्रतिरक्षा प्रतिक्रियाएं कारण हो सकती हैं।";s:10:"sort_order";i:2;}i:812;a:7:{s:2:"id";i:813;s:10:"disease_id";i:206;s:11:"question_en";s:25:"Is dermatitis contagious?";s:9:"answer_en";s:33:"No, dermatitis is not contagious.";s:11:"question_hi";s:79:"क्या डर्मेटाइटिस संक्रामक है?";s:9:"answer_hi";s:68:"नहीं, यह संक्रामक नहीं है।";s:10:"sort_order";i:3;}i:813;a:7:{s:2:"id";i:814;s:10:"disease_id";i:206;s:11:"question_en";s:26:"How is dermatitis treated?";s:9:"answer_en";s:71:"Treatment includes avoiding triggers and using medications when needed.";s:11:"question_hi";s:87:"डर्मेटाइटिस का इलाज कैसे होता है?";s:9:"answer_hi";s:145:"ट्रिगर्स से बचाव और आवश्यक दवाओं से उपचार किया जाता है।";s:10:"sort_order";i:4;}i:814;a:7:{s:2:"id";i:815;s:10:"disease_id";i:206;s:11:"question_en";s:21:"Can dermatitis recur?";s:9:"answer_en";s:44:"Yes, flare-ups can occur if triggers return.";s:11:"question_hi";s:93:"क्या डर्मेटाइटिस दोबारा हो सकता है?";s:9:"answer_hi";s:101:"हाँ, ट्रिगर मिलने पर दोबारा हो सकता है।";s:10:"sort_order";i:5;}i:815;a:7:{s:2:"id";i:816;s:10:"disease_id";i:207;s:11:"question_en";s:30:"What is seborrheic dermatitis?";s:9:"answer_en";s:58:"A chronic skin condition causing flaky scales and redness.";s:11:"question_hi";s:76:"सेबोरिक डर्मेटाइटिस क्या है?";s:9:"answer_hi";s:177:"यह त्वचा की एक दीर्घकालिक बीमारी है जिसमें पपड़ी और लालिमा होती है।";s:10:"sort_order";i:1;}i:816;a:7:{s:2:"id";i:817;s:10:"disease_id";i:207;s:11:"question_en";s:34:"Which areas are commonly affected?";s:9:"answer_en";s:55:"Scalp, face, eyebrows, and chest are commonly affected.";s:11:"question_hi";s:84:"कौन से हिस्से प्रभावित होते हैं?";s:9:"answer_hi";s:121:"सिर, चेहरा, भौहें और छाती प्रभावित हो सकते हैं।";s:10:"sort_order";i:2;}i:817;a:7:{s:2:"id";i:818;s:10:"disease_id";i:207;s:11:"question_en";s:17:"Is it contagious?";s:9:"answer_en";s:25:"No, it is not contagious.";s:11:"question_hi";s:52:"क्या यह संक्रामक है?";s:9:"answer_hi";s:68:"नहीं, यह संक्रामक नहीं है।";s:10:"sort_order";i:3;}i:818;a:7:{s:2:"id";i:819;s:10:"disease_id";i:207;s:11:"question_en";s:27:"Can stress worsen symptoms?";s:9:"answer_en";s:34:"Yes, stress may trigger flare-ups.";s:11:"question_hi";s:68:"क्या तनाव लक्षण बढ़ाता है?";s:9:"answer_hi";s:75:"हाँ, तनाव लक्षण बढ़ा सकता है।";s:10:"sort_order";i:4;}i:819;a:7:{s:2:"id";i:820;s:10:"disease_id";i:207;s:11:"question_en";s:28:"Can it be cured permanently?";s:9:"answer_en";s:35:"It can be controlled but may recur.";s:11:"question_hi";s:80:"क्या यह पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:142:"इसे नियंत्रित किया जा सकता है लेकिन दोबारा हो सकता है।";s:10:"sort_order";i:5;}i:820;a:7:{s:2:"id";i:821;s:10:"disease_id";i:208;s:11:"question_en";s:27:"What is contact dermatitis?";s:9:"answer_en";s:64:"Skin inflammation caused by contact with allergens or irritants.";s:11:"question_hi";s:82:"कॉन्टैक्ट डर्मेटाइटिस क्या है?";s:9:"answer_hi";s:118:"एलर्जी या उत्तेजक पदार्थों से त्वचा की सूजन।";s:10:"sort_order";i:1;}i:821;a:7:{s:2:"id";i:822;s:10:"disease_id";i:208;s:11:"question_en";s:25:"What are common triggers?";s:9:"answer_en";s:40:"Soaps, cosmetics, metals, and chemicals.";s:11:"question_hi";s:64:"सामान्य ट्रिगर क्या हैं?";s:9:"answer_hi";s:96:"साबुन, कॉस्मेटिक्स, धातुएं और रसायन।";s:10:"sort_order";i:2;}i:822;a:7:{s:2:"id";i:823;s:10:"disease_id";i:208;s:11:"question_en";s:17:"Is it contagious?";s:9:"answer_en";s:25:"No, it is not contagious.";s:11:"question_hi";s:52:"क्या यह संक्रामक है?";s:9:"answer_hi";s:68:"नहीं, यह संक्रामक नहीं है।";s:10:"sort_order";i:3;}i:823;a:7:{s:2:"id";i:824;s:10:"disease_id";i:208;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:48:"Through examination and patch testing if needed.";s:11:"question_hi";s:62:"इसका निदान कैसे होता है?";s:9:"answer_hi";s:108:"परीक्षण और आवश्यकता अनुसार पैच टेस्ट से।";s:10:"sort_order";i:4;}i:824;a:7:{s:2:"id";i:825;s:10:"disease_id";i:208;s:11:"question_en";s:20:"Can it be prevented?";s:9:"answer_en";s:41:"Avoiding known triggers helps prevention.";s:11:"question_hi";s:63:"क्या इसे रोका जा सकता है?";s:9:"answer_hi";s:116:"ज्ञात ट्रिगर्स से बचकर रोकथाम की जा सकती है।";s:10:"sort_order";i:5;}i:825;a:7:{s:2:"id";i:826;s:10:"disease_id";i:209;s:11:"question_en";s:18:"What is urticaria?";s:9:"answer_en";s:50:"Urticaria is an itchy skin rash also called hives.";s:11:"question_hi";s:54:"अर्टिकेरिया क्या है?";s:9:"answer_hi";s:146:"खुजलीदार त्वचा पर उभरे चकत्ते जिन्हें पित्ती कहते हैं।";s:10:"sort_order";i:1;}i:826;a:7:{s:2:"id";i:827;s:10:"disease_id";i:209;s:11:"question_en";s:18:"What causes hives?";s:9:"answer_en";s:46:"Allergies, infections, medications, or stress.";s:11:"question_hi";s:55:"पित्ती क्यों होती है?";s:9:"answer_hi";s:81:"एलर्जी, संक्रमण, दवाएं या तनाव।";s:10:"sort_order";i:2;}i:827;a:7:{s:2:"id";i:828;s:10:"disease_id";i:209;s:11:"question_en";s:23:"How long do hives last?";s:9:"answer_en";s:57:"They may last from hours to weeks depending on the cause.";s:11:"question_hi";s:72:"पित्ती कितने समय तक रहती है?";s:9:"answer_hi";s:104:"कारण के अनुसार कुछ घंटे से कई सप्ताह तक।";s:10:"sort_order";i:3;}i:828;a:7:{s:2:"id";i:829;s:10:"disease_id";i:209;s:11:"question_en";s:29:"Can stress trigger urticaria?";s:9:"answer_en";s:32:"Yes, stress can worsen symptoms.";s:11:"question_hi";s:78:"क्या तनाव पित्ती बढ़ा सकता है?";s:9:"answer_hi";s:75:"हाँ, तनाव लक्षण बढ़ा सकता है।";s:10:"sort_order";i:4;}i:829;a:7:{s:2:"id";i:830;s:10:"disease_id";i:209;s:11:"question_en";s:35:"When should medical help be sought?";s:9:"answer_en";s:48:"If swelling affects breathing or becomes severe.";s:11:"question_hi";s:65:"डॉक्टर से कब मिलना चाहिए?";s:9:"answer_hi";s:84:"यदि सूजन सांस लेने में बाधा बने।";s:10:"sort_order";i:5;}i:830;a:7:{s:2:"id";i:831;s:10:"disease_id";i:210;s:11:"question_en";s:19:"What is cellulitis?";s:9:"answer_en";s:44:"A bacterial infection of deeper skin layers.";s:11:"question_hi";s:51:"सेलुलाइटिस क्या है?";s:9:"answer_hi";s:102:"त्वचा की गहरी परतों का जीवाणु संक्रमण।";s:10:"sort_order";i:1;}i:831;a:7:{s:2:"id";i:832;s:10:"disease_id";i:210;s:11:"question_en";s:22:"What are the symptoms?";s:9:"answer_en";s:36:"Redness, swelling, warmth, and pain.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:78:"लालिमा, सूजन, गर्माहट और दर्द।";s:10:"sort_order";i:2;}i:832;a:7:{s:2:"id";i:833;s:10:"disease_id";i:210;s:11:"question_en";s:22:"Is cellulitis serious?";s:9:"answer_en";s:45:"Yes, untreated cellulitis can become serious.";s:11:"question_hi";s:67:"क्या सेलुलाइटिस गंभीर है?";s:9:"answer_hi";s:96:"हाँ, बिना इलाज के यह गंभीर हो सकता है।";s:10:"sort_order";i:3;}i:833;a:7:{s:2:"id";i:834;s:10:"disease_id";i:210;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:40:"Usually with antibiotics and wound care.";s:11:"question_hi";s:72:"इसका इलाज कैसे किया जाता है?";s:9:"answer_hi";s:109:"आमतौर पर एंटीबायोटिक और घाव की देखभाल से।";s:10:"sort_order";i:4;}i:834;a:7:{s:2:"id";i:835;s:10:"disease_id";i:210;s:11:"question_en";s:20:"Can it be prevented?";s:9:"answer_en";s:35:"Proper wound care helps prevention.";s:11:"question_hi";s:63:"क्या इसे रोका जा सकता है?";s:9:"answer_hi";s:81:"घाव की उचित देखभाल मदद करती है।";s:10:"sort_order";i:5;}i:835;a:7:{s:2:"id";i:836;s:10:"disease_id";i:211;s:11:"question_en";s:17:"What is impetigo?";s:9:"answer_en";s:38:"A contagious bacterial skin infection.";s:11:"question_hi";s:48:"इम्पेटिगो क्या है?";s:9:"answer_hi";s:91:"एक संक्रामक जीवाणु त्वचा संक्रमण।";s:10:"sort_order";i:1;}i:836;a:7:{s:2:"id";i:837;s:10:"disease_id";i:211;s:11:"question_en";s:27:"Who commonly gets impetigo?";s:9:"answer_en";s:30:"It is most common in children.";s:11:"question_hi";s:59:"यह किसमें अधिक होता है?";s:9:"answer_hi";s:84:"यह बच्चों में अधिक पाया जाता है।";s:10:"sort_order";i:2;}i:837;a:7:{s:2:"id";i:838;s:10:"disease_id";i:211;s:11:"question_en";s:19:"How does it spread?";s:9:"answer_en";s:42:"Through direct contact with infected skin.";s:11:"question_hi";s:43:"यह कैसे फैलता है?";s:9:"answer_hi";s:76:"संक्रमित त्वचा के संपर्क से।";s:10:"sort_order";i:3;}i:838;a:7:{s:2:"id";i:839;s:10:"disease_id";i:211;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:36:"Honey-colored crusts and skin sores.";s:11:"question_hi";s:61:"सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:60:"शहद जैसे पपड़ीदार घाव।";s:10:"sort_order";i:4;}i:839;a:7:{s:2:"id";i:840;s:10:"disease_id";i:211;s:11:"question_en";s:22:"Can impetigo be cured?";s:9:"answer_en";s:27:"Yes, with proper treatment.";s:11:"question_hi";s:78:"क्या इम्पेटिगो ठीक हो सकता है?";s:9:"answer_hi";s:49:"हाँ, उचित उपचार से।";s:10:"sort_order";i:5;}i:840;a:7:{s:2:"id";i:841;s:10:"disease_id";i:212;s:11:"question_en";s:16:"What is scabies?";s:9:"answer_en";s:35:"A skin infestation caused by mites.";s:11:"question_hi";s:42:"स्केबीज क्या है?";s:9:"answer_hi";s:104:"माइट्स द्वारा होने वाला त्वचा संक्रमण।";s:10:"sort_order";i:1;}i:841;a:7:{s:2:"id";i:842;s:10:"disease_id";i:212;s:11:"question_en";s:25:"What is the main symptom?";s:9:"answer_en";s:36:"Severe itching, especially at night.";s:11:"question_hi";s:52:"मुख्य लक्षण क्या है?";s:9:"answer_hi";s:51:"रात में अधिक खुजली।";s:10:"sort_order";i:2;}i:842;a:7:{s:2:"id";i:843;s:10:"disease_id";i:212;s:11:"question_en";s:22:"Is scabies contagious?";s:9:"answer_en";s:38:"Yes, it spreads through close contact.";s:11:"question_hi";s:67:"क्या स्केबीज संक्रामक है?";s:9:"answer_hi";s:69:"हाँ, यह संपर्क से फैलता है।";s:10:"sort_order";i:3;}i:843;a:7:{s:2:"id";i:844;s:10:"disease_id";i:212;s:11:"question_en";s:31:"Can family members be affected?";s:9:"answer_en";s:44:"Yes, close contacts often require treatment.";s:11:"question_hi";s:84:"क्या परिवार प्रभावित हो सकता है?";s:9:"answer_hi";s:134:"हाँ, करीबी लोगों को भी उपचार की आवश्यकता हो सकती है।";s:10:"sort_order";i:4;}i:844;a:7:{s:2:"id";i:845;s:10:"disease_id";i:212;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:41:"With prescribed anti-scabies medications.";s:11:"question_hi";s:72:"इसका इलाज कैसे किया जाता है?";s:9:"answer_hi";s:41:"विशेष दवाओं से।";s:10:"sort_order";i:5;}i:845;a:7:{s:2:"id";i:846;s:10:"disease_id";i:213;s:11:"question_en";s:17:"What is ringworm?";s:9:"answer_en";s:31:"A fungal infection of the skin.";s:11:"question_hi";s:30:"दाद क्या है?";s:9:"answer_hi";s:60:"त्वचा का फंगल संक्रमण।";s:10:"sort_order";i:1;}i:846;a:7:{s:2:"id";i:847;s:10:"disease_id";i:213;s:11:"question_en";s:28:"Is ringworm caused by worms?";s:9:"answer_en";s:26:"No, it is caused by fungi.";s:11:"question_hi";s:66:"क्या दाद कीड़े से होता है?";s:9:"answer_hi";s:63:"नहीं, यह फंगस से होता है।";s:10:"sort_order";i:2;}i:847;a:7:{s:2:"id";i:848;s:10:"disease_id";i:213;s:11:"question_en";s:17:"Is it contagious?";s:9:"answer_en";s:35:"Yes, it can spread through contact.";s:11:"question_hi";s:52:"क्या यह संक्रामक है?";s:9:"answer_hi";s:76:"हाँ, यह संपर्क से फैल सकता है।";s:10:"sort_order";i:3;}i:848;a:7:{s:2:"id";i:849;s:10:"disease_id";i:213;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:22:"Circular itchy rashes.";s:11:"question_hi";s:61:"सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:56:"गोल खुजलीदार चकत्ते।";s:10:"sort_order";i:4;}i:849;a:7:{s:2:"id";i:850;s:10:"disease_id";i:213;s:11:"question_en";s:20:"Can it be prevented?";s:9:"answer_en";s:35:"Maintain hygiene and keep skin dry.";s:11:"question_hi";s:63:"क्या इसे रोका जा सकता है?";s:9:"answer_hi";s:96:"स्वच्छता रखें और त्वचा को सूखा रखें।";s:10:"sort_order";i:5;}i:850;a:7:{s:2:"id";i:851;s:10:"disease_id";i:214;s:11:"question_en";s:23:"What is athlete's foot?";s:9:"answer_en";s:38:"A fungal infection affecting the feet.";s:11:"question_hi";s:46:"एथलीट फुट क्या है?";s:9:"answer_hi";s:60:"पैरों का फंगल संक्रमण।";s:10:"sort_order";i:1;}i:851;a:7:{s:2:"id";i:852;s:10:"disease_id";i:214;s:11:"question_en";s:28:"Where does it usually occur?";s:9:"answer_en";s:17:"Between the toes.";s:11:"question_hi";s:40:"यह कहाँ होता है?";s:9:"answer_hi";s:61:"पैर की उंगलियों के बीच।";s:10:"sort_order";i:2;}i:852;a:7:{s:2:"id";i:853;s:10:"disease_id";i:214;s:11:"question_en";s:15:"What causes it?";s:9:"answer_en";s:48:"Warm and moist environments favor fungal growth.";s:11:"question_hi";s:43:"यह क्यों होता है?";s:9:"answer_hi";s:71:"गर्म और नम वातावरण के कारण।";s:10:"sort_order";i:3;}i:853;a:7:{s:2:"id";i:854;s:10:"disease_id";i:214;s:11:"question_en";s:14:"Can it spread?";s:9:"answer_en";s:35:"Yes, to other body parts or people.";s:11:"question_hi";s:50:"क्या यह फैल सकता है?";s:9:"answer_hi";s:95:"हाँ, शरीर के अन्य भागों या लोगों में।";s:10:"sort_order";i:4;}i:854;a:7:{s:2:"id";i:855;s:10:"disease_id";i:214;s:11:"question_en";s:24:"How can it be prevented?";s:9:"answer_en";s:24:"Keep feet clean and dry.";s:11:"question_hi";s:45:"रोकथाम कैसे करें?";s:9:"answer_hi";s:68:"पैरों को साफ और सूखा रखें।";s:10:"sort_order";i:5;}i:855;a:7:{s:2:"id";i:856;s:10:"disease_id";i:215;s:11:"question_en";s:20:"What is nail fungus?";s:9:"answer_en";s:32:"A fungal infection of the nails.";s:11:"question_hi";s:49:"नाखून फंगस क्या है?";s:9:"answer_hi";s:66:"नाखूनों का फंगल संक्रमण।";s:10:"sort_order";i:1;}i:856;a:7:{s:2:"id";i:857;s:10:"disease_id";i:215;s:11:"question_en";s:22:"What are the symptoms?";s:9:"answer_en";s:40:"Discolored, thickened, or brittle nails.";s:11:"question_hi";s:52:"इसके लक्षण क्या हैं?";s:9:"answer_hi";s:94:"रंग बदला हुआ, मोटा या भुरभुरा नाखून।";s:10:"sort_order";i:2;}i:857;a:7:{s:2:"id";i:858;s:10:"disease_id";i:215;s:11:"question_en";s:22:"Who is at higher risk?";s:9:"answer_en";s:38:"Older adults and people with diabetes.";s:11:"question_hi";s:49:"किसे अधिक जोखिम है?";s:9:"answer_hi";s:85:"बुजुर्गों और मधुमेह रोगियों को।";s:10:"sort_order";i:3;}i:858;a:7:{s:2:"id";i:859;s:10:"disease_id";i:215;s:11:"question_en";s:14:"Can it spread?";s:9:"answer_en";s:29:"Yes, to nearby nails or skin.";s:11:"question_hi";s:50:"क्या यह फैल सकता है?";s:9:"answer_hi";s:81:"हाँ, अन्य नाखूनों या त्वचा में।";s:10:"sort_order";i:4;}i:859;a:7:{s:2:"id";i:860;s:10:"disease_id";i:215;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:28:"With antifungal medications.";s:11:"question_hi";s:72:"इसका इलाज कैसे किया जाता है?";s:9:"answer_hi";s:50:"एंटीफंगल दवाओं से।";s:10:"sort_order";i:5;}i:860;a:7:{s:2:"id";i:861;s:10:"disease_id";i:216;s:11:"question_en";s:21:"What is folliculitis?";s:9:"answer_en";s:31:"Inflammation of hair follicles.";s:11:"question_hi";s:57:"फॉलिकुलाइटिस क्या है?";s:9:"answer_hi";s:61:"बालों की जड़ों की सूजन।";s:10:"sort_order";i:1;}i:861;a:7:{s:2:"id";i:862;s:10:"disease_id";i:216;s:11:"question_en";s:25:"What causes folliculitis?";s:9:"answer_en";s:31:"Bacteria, fungi, or irritation.";s:11:"question_hi";s:43:"यह क्यों होता है?";s:9:"answer_hi";s:84:"बैक्टीरिया, फंगस या जलन के कारण।";s:10:"sort_order";i:2;}i:862;a:7:{s:2:"id";i:863;s:10:"disease_id";i:216;s:11:"question_en";s:25:"What are common symptoms?";s:9:"answer_en";s:28:"Small red bumps and itching.";s:11:"question_hi";s:61:"सामान्य लक्षण क्या हैं?";s:9:"answer_hi";s:61:"छोटे लाल दाने और खुजली।";s:10:"sort_order";i:3;}i:863;a:7:{s:2:"id";i:864;s:10:"disease_id";i:216;s:11:"question_en";s:31:"Can shaving cause folliculitis?";s:9:"answer_en";s:28:"Yes, shaving may trigger it.";s:11:"question_hi";s:73:"क्या शेविंग से यह हो सकता है?";s:9:"answer_hi";s:95:"हाँ, शेविंग इसके कारणों में से एक है।";s:10:"sort_order";i:4;}i:864;a:7:{s:2:"id";i:865;s:10:"disease_id";i:216;s:11:"question_en";s:24:"How can it be prevented?";s:9:"answer_en";s:38:"Maintain hygiene and avoid irritation.";s:11:"question_hi";s:45:"रोकथाम कैसे करें?";s:9:"answer_hi";s:77:"स्वच्छता रखें और जलन से बचें।";s:10:"sort_order";i:5;}i:865;a:7:{s:2:"id";i:866;s:10:"disease_id";i:217;s:11:"question_en";s:15:"What is a boil?";s:9:"answer_en";s:68:"A boil is a painful bacterial skin infection around a hair follicle.";s:11:"question_hi";s:36:"फोड़ा क्या है?";s:9:"answer_hi";s:128:"फोड़ा बालों की जड़ का दर्दनाक जीवाणु संक्रमण है।";s:10:"sort_order";i:1;}i:866;a:7:{s:2:"id";i:867;s:10:"disease_id";i:217;s:11:"question_en";s:18:"What causes boils?";s:9:"answer_en";s:49:"Most boils are caused by Staphylococcus bacteria.";s:11:"question_hi";s:55:"फोड़े क्यों होते हैं?";s:9:"answer_hi";s:138:"अधिकांश फोड़े स्टैफिलोकोकस बैक्टीरिया से होते हैं।";s:10:"sort_order";i:2;}i:867;a:7:{s:2:"id";i:868;s:10:"disease_id";i:217;s:11:"question_en";s:21:"Are boils contagious?";s:9:"answer_en";s:39:"They can spread through direct contact.";s:11:"question_hi";s:64:"क्या फोड़े संक्रामक हैं?";s:9:"answer_hi";s:85:"हाँ, सीधे संपर्क से फैल सकते हैं।";s:10:"sort_order";i:3;}i:868;a:7:{s:2:"id";i:869;s:10:"disease_id";i:217;s:11:"question_en";s:28:"Can boils heal on their own?";s:9:"answer_en";s:41:"Small boils may drain and heal naturally.";s:11:"question_hi";s:85:"क्या फोड़े स्वयं ठीक हो सकते हैं?";s:9:"answer_hi";s:87:"छोटे फोड़े स्वयं ठीक हो सकते हैं।";s:10:"sort_order";i:4;}i:869;a:7:{s:2:"id";i:870;s:10:"disease_id";i:217;s:11:"question_en";s:27:"When should I see a doctor?";s:9:"answer_en";s:53:"If fever, severe pain, or spreading infection occurs.";s:11:"question_hi";s:65:"डॉक्टर से कब मिलना चाहिए?";s:9:"answer_hi";s:97:"बुखार, अधिक दर्द या संक्रमण फैलने पर।";s:10:"sort_order";i:5;}i:870;a:7:{s:2:"id";i:871;s:10:"disease_id";i:218;s:11:"question_en";s:20:"What is a carbuncle?";s:9:"answer_en";s:44:"A carbuncle is a cluster of connected boils.";s:11:"question_hi";s:45:"कार्बंकल क्या है?";s:9:"answer_hi";s:80:"कार्बंकल कई फोड़ों का समूह है।";s:10:"sort_order";i:1;}i:871;a:7:{s:2:"id";i:872;s:10:"disease_id";i:218;s:11:"question_en";s:23:"What causes carbuncles?";s:9:"answer_en";s:50:"Usually bacterial infection of multiple follicles.";s:11:"question_hi";s:61:"कार्बंकल क्यों होता है?";s:9:"answer_hi";s:103:"कई बालों की जड़ों के जीवाणु संक्रमण से।";s:10:"sort_order";i:2;}i:872;a:7:{s:2:"id";i:873;s:10:"disease_id";i:218;s:11:"question_en";s:21:"Is carbuncle serious?";s:9:"answer_en";s:33:"It may require medical treatment.";s:11:"question_hi";s:61:"क्या कार्बंकल गंभीर है?";s:9:"answer_hi";s:88:"हाँ, उपचार की आवश्यकता हो सकती है।";s:10:"sort_order";i:3;}i:873;a:7:{s:2:"id";i:874;s:10:"disease_id";i:218;s:11:"question_en";s:15:"Who is at risk?";s:9:"answer_en";s:38:"People with diabetes or weak immunity.";s:11:"question_hi";s:49:"किसे अधिक जोखिम है?";s:9:"answer_hi";s:111:"मधुमेह और कमजोर प्रतिरक्षा वाले लोगों को।";s:10:"sort_order";i:4;}i:874;a:7:{s:2:"id";i:875;s:10:"disease_id";i:218;s:11:"question_en";s:13:"Can it recur?";s:9:"answer_en";s:28:"Yes, recurrence is possible.";s:11:"question_hi";s:66:"क्या यह दोबारा हो सकता है?";s:9:"answer_hi";s:60:"हाँ, यह पुनः हो सकता है।";s:10:"sort_order";i:5;}i:875;a:7:{s:2:"id";i:876;s:10:"disease_id";i:219;s:11:"question_en";s:15:"What are warts?";s:9:"answer_en";s:47:"Warts are skin growths caused by HPV infection.";s:11:"question_hi";s:39:"मस्से क्या हैं?";s:9:"answer_hi";s:96:"HPV संक्रमण से होने वाली त्वचा वृद्धि।";s:10:"sort_order";i:1;}i:876;a:7:{s:2:"id";i:877;s:10:"disease_id";i:219;s:11:"question_en";s:21:"Are warts contagious?";s:9:"answer_en";s:37:"Yes, they can spread through contact.";s:11:"question_hi";s:64:"क्या मस्से संक्रामक हैं?";s:9:"answer_hi";s:72:"हाँ, संपर्क से फैल सकते हैं।";s:10:"sort_order";i:2;}i:877;a:7:{s:2:"id";i:878;s:10:"disease_id";i:219;s:11:"question_en";s:28:"Do all warts need treatment?";s:9:"answer_en";s:33:"Some disappear without treatment.";s:11:"question_hi";s:85:"क्या सभी मस्सों का इलाज जरूरी है?";s:9:"answer_hi";s:101:"कुछ मस्से बिना इलाज के भी चले जाते हैं।";s:10:"sort_order";i:3;}i:878;a:7:{s:2:"id";i:879;s:10:"disease_id";i:219;s:11:"question_en";s:17:"Can warts return?";s:9:"answer_en";s:28:"Yes, recurrence is possible.";s:11:"question_hi";s:78:"क्या मस्से दोबारा हो सकते हैं?";s:9:"answer_hi";s:56:"हाँ, पुनः हो सकते हैं।";s:10:"sort_order";i:4;}i:879;a:7:{s:2:"id";i:880;s:10:"disease_id";i:219;s:11:"question_en";s:22:"How are warts removed?";s:9:"answer_en";s:51:"Through medications, freezing, or minor procedures.";s:11:"question_hi";s:65:"मस्से कैसे हटाए जाते हैं?";s:9:"answer_hi";s:105:"दवा, फ्रीजिंग या छोटी प्रक्रिया द्वारा।";s:10:"sort_order";i:5;}i:880;a:7:{s:2:"id";i:881;s:10:"disease_id";i:220;s:11:"question_en";s:23:"What is genital herpes?";s:9:"answer_en";s:39:"A sexually transmitted viral infection.";s:11:"question_hi";s:58:"जननांग हर्पीज क्या है?";s:9:"answer_hi";s:79:"एक यौन संचारित वायरल संक्रमण।";s:10:"sort_order";i:1;}i:881;a:7:{s:2:"id";i:882;s:10:"disease_id";i:220;s:11:"question_en";s:27:"What causes genital herpes?";s:9:"answer_en";s:42:"Herpes simplex virus causes the infection.";s:11:"question_hi";s:74:"जननांग हर्पीज क्यों होता है?";s:9:"answer_hi";s:91:"हर्पीज सिम्प्लेक्स वायरस के कारण।";s:10:"sort_order";i:2;}i:882;a:7:{s:2:"id";i:883;s:10:"disease_id";i:220;s:11:"question_en";s:28:"Can genital herpes be cured?";s:9:"answer_en";s:59:"There is no permanent cure, but symptoms can be controlled.";s:11:"question_hi";s:80:"क्या यह पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:116:"स्थायी इलाज नहीं है, लेकिन नियंत्रण संभव है।";s:10:"sort_order";i:3;}i:883;a:7:{s:2:"id";i:884;s:10:"disease_id";i:220;s:11:"question_en";s:19:"How does it spread?";s:9:"answer_en";s:23:"Through sexual contact.";s:11:"question_hi";s:43:"यह कैसे फैलता है?";s:9:"answer_hi";s:50:"यौन संपर्क द्वारा।";s:10:"sort_order";i:4;}i:884;a:7:{s:2:"id";i:885;s:10:"disease_id";i:220;s:11:"question_en";s:13:"Can it recur?";s:9:"answer_en";s:25:"Yes, outbreaks may recur.";s:11:"question_hi";s:66:"क्या यह दोबारा हो सकता है?";s:9:"answer_hi";s:94:"हाँ, इसके प्रकोप दोबारा हो सकते हैं।";s:10:"sort_order";i:5;}i:885;a:7:{s:2:"id";i:886;s:10:"disease_id";i:221;s:11:"question_en";s:20:"What are cold sores?";s:9:"answer_en";s:47:"Small painful blisters usually around the lips.";s:11:"question_hi";s:55:"कोल्ड सोर्स क्या हैं?";s:9:"answer_hi";s:95:"होंठों के आसपास छोटे दर्दनाक फफोले।";s:10:"sort_order";i:1;}i:886;a:7:{s:2:"id";i:887;s:10:"disease_id";i:221;s:11:"question_en";s:23:"What causes cold sores?";s:9:"answer_en";s:36:"Usually herpes simplex virus type 1.";s:11:"question_hi";s:71:"कोल्ड सोर्स क्यों होते हैं?";s:9:"answer_hi";s:67:"आमतौर पर HSV-1 वायरस के कारण।";s:10:"sort_order";i:2;}i:887;a:7:{s:2:"id";i:888;s:10:"disease_id";i:221;s:11:"question_en";s:26:"Are cold sores contagious?";s:9:"answer_en";s:40:"Yes, especially during active outbreaks.";s:11:"question_hi";s:80:"क्या कोल्ड सोर्स संक्रामक हैं?";s:9:"answer_hi";s:77:"हाँ, विशेषकर प्रकोप के दौरान।";s:10:"sort_order";i:3;}i:888;a:7:{s:2:"id";i:889;s:10:"disease_id";i:221;s:11:"question_en";s:24:"What triggers outbreaks?";s:9:"answer_en";s:39:"Stress, illness, and sunlight exposure.";s:11:"question_hi";s:68:"प्रकोप के ट्रिगर क्या हैं?";s:9:"answer_hi";s:52:"तनाव, बीमारी और धूप।";s:10:"sort_order";i:4;}i:889;a:7:{s:2:"id";i:890;s:10:"disease_id";i:221;s:11:"question_en";s:22:"Can cold sores return?";s:9:"answer_en";s:36:"Yes, recurrent outbreaks are common.";s:11:"question_hi";s:69:"क्या यह दोबारा हो सकते हैं?";s:9:"answer_hi";s:77:"हाँ, पुनः प्रकोप सामान्य हैं।";s:10:"sort_order";i:5;}i:890;a:7:{s:2:"id";i:891;s:10:"disease_id";i:222;s:11:"question_en";s:17:"What is melanoma?";s:9:"answer_en";s:71:"Melanoma is a serious skin cancer arising from pigment-producing cells.";s:11:"question_hi";s:45:"मेलानोमा क्या है?";s:9:"answer_hi";s:108:"मेलानोमा त्वचा कैंसर का गंभीर प्रकार है।";s:10:"sort_order";i:1;}i:891;a:7:{s:2:"id";i:892;s:10:"disease_id";i:222;s:11:"question_en";s:21:"What causes melanoma?";s:9:"answer_en";s:53:"Excess UV exposure and genetic factors increase risk.";s:11:"question_hi";s:61:"मेलानोमा क्यों होता है?";s:9:"answer_hi";s:127:"अधिक UV किरणें और आनुवंशिक कारण जोखिम बढ़ाते हैं।";s:10:"sort_order";i:2;}i:892;a:7:{s:2:"id";i:893;s:10:"disease_id";i:222;s:11:"question_en";s:20:"Can melanoma spread?";s:9:"answer_en";s:54:"Yes, melanoma can spread to other organs if untreated.";s:11:"question_hi";s:68:"क्या मेलानोमा फैल सकता है?";s:9:"answer_hi";s:102:"हाँ, बिना उपचार यह शरीर में फैल सकता है।";s:10:"sort_order";i:3;}i:893;a:7:{s:2:"id";i:894;s:10:"disease_id";i:222;s:11:"question_en";s:26:"How is melanoma diagnosed?";s:9:"answer_en";s:38:"Diagnosis is confirmed through biopsy.";s:11:"question_hi";s:81:"मेलानोमा का निदान कैसे होता है?";s:9:"answer_hi";s:92:"बायोप्सी द्वारा पुष्टि की जाती है।";s:10:"sort_order";i:4;}i:894;a:7:{s:2:"id";i:895;s:10:"disease_id";i:222;s:11:"question_en";s:26:"Can melanoma be prevented?";s:9:"answer_en";s:55:"Sun protection and regular skin checks help prevention.";s:11:"question_hi";s:78:"क्या मेलानोमा रोका जा सकता है?";s:9:"answer_hi";s:94:"धूप से बचाव और नियमित जांच सहायक है।";s:10:"sort_order";i:5;}i:895;a:7:{s:2:"id";i:896;s:10:"disease_id";i:223;s:11:"question_en";s:29:"What is basal cell carcinoma?";s:9:"answer_en";s:42:"It is the most common form of skin cancer.";s:11:"question_hi";s:74:"बेसल सेल कार्सिनोमा क्या है?";s:9:"answer_hi";s:109:"यह त्वचा कैंसर का सबसे सामान्य प्रकार है।";s:10:"sort_order";i:1;}i:896;a:7:{s:2:"id";i:897;s:10:"disease_id";i:223;s:11:"question_en";s:33:"What causes basal cell carcinoma?";s:9:"answer_en";s:41:"Long-term sun exposure is the main cause.";s:11:"question_hi";s:43:"यह क्यों होता है?";s:9:"answer_hi";s:72:"लंबे समय तक धूप में रहने से।";s:10:"sort_order";i:2;}i:897;a:7:{s:2:"id";i:898;s:10:"disease_id";i:223;s:11:"question_en";s:23:"Does it spread quickly?";s:9:"answer_en";s:43:"It usually grows slowly and rarely spreads.";s:11:"question_hi";s:63:"क्या यह तेजी से फैलता है?";s:9:"answer_hi";s:73:"यह सामान्यतः धीरे बढ़ता है।";s:10:"sort_order";i:3;}i:898;a:7:{s:2:"id";i:899;s:10:"disease_id";i:223;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:42:"Treatment often involves surgical removal.";s:11:"question_hi";s:75:"इसका उपचार कैसे किया जाता है?";s:9:"answer_hi";s:75:"अक्सर शल्य चिकित्सा द्वारा।";s:10:"sort_order";i:4;}i:899;a:7:{s:2:"id";i:900;s:10:"disease_id";i:223;s:11:"question_en";s:13:"Can it recur?";s:9:"answer_en";s:28:"Yes, recurrence is possible.";s:11:"question_hi";s:66:"क्या यह दोबारा हो सकता है?";s:9:"answer_hi";s:53:"हाँ, पुनः हो सकता है।";s:10:"sort_order";i:5;}i:900;a:7:{s:2:"id";i:901;s:10:"disease_id";i:224;s:11:"question_en";s:32:"What is squamous cell carcinoma?";s:9:"answer_en";s:49:"A common skin cancer arising from squamous cells.";s:11:"question_hi";s:86:"स्क्वैमस सेल कार्सिनोमा क्या है?";s:9:"answer_hi";s:89:"त्वचा कैंसर का एक सामान्य प्रकार।";s:10:"sort_order";i:1;}i:901;a:7:{s:2:"id";i:902;s:10:"disease_id";i:224;s:11:"question_en";s:15:"What causes it?";s:9:"answer_en";s:37:"UV radiation and chronic skin damage.";s:11:"question_hi";s:43:"यह क्यों होता है?";s:9:"answer_hi";s:83:"UV विकिरण और त्वचा क्षति के कारण।";s:10:"sort_order";i:2;}i:902;a:7:{s:2:"id";i:903;s:10:"disease_id";i:224;s:11:"question_en";s:14:"Can it spread?";s:9:"answer_en";s:31:"Yes, advanced cases may spread.";s:11:"question_hi";s:50:"क्या यह फैल सकता है?";s:9:"answer_hi";s:88:"हाँ, उन्नत अवस्था में फैल सकता है।";s:10:"sort_order";i:3;}i:903;a:7:{s:2:"id";i:904;s:10:"disease_id";i:224;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:31:"Through examination and biopsy.";s:11:"question_hi";s:49:"निदान कैसे होता है?";s:9:"answer_hi";s:63:"परीक्षण और बायोप्सी से।";s:10:"sort_order";i:4;}i:904;a:7:{s:2:"id";i:905;s:10:"disease_id";i:224;s:11:"question_en";s:20:"Can it be prevented?";s:9:"answer_en";s:28:"Sun protection reduces risk.";s:11:"question_hi";s:63:"क्या इसे रोका जा सकता है?";s:9:"answer_hi";s:75:"धूप से बचाव जोखिम कम करता है।";s:10:"sort_order";i:5;}i:905;a:7:{s:2:"id";i:906;s:10:"disease_id";i:225;s:11:"question_en";s:20:"What is skin cancer?";s:9:"answer_en";s:45:"Skin cancer is abnormal growth of skin cells.";s:11:"question_hi";s:52:"त्वचा कैंसर क्या है?";s:9:"answer_hi";s:94:"त्वचा कोशिकाओं की असामान्य वृद्धि।";s:10:"sort_order";i:1;}i:906;a:7:{s:2:"id";i:907;s:10:"disease_id";i:225;s:11:"question_en";s:29:"What is the main risk factor?";s:9:"answer_en";s:45:"Excessive UV exposure is a major risk factor.";s:11:"question_hi";s:65:"मुख्य जोखिम कारक क्या है?";s:9:"answer_hi";s:63:"अधिक UV किरणों का संपर्क।";s:10:"sort_order";i:2;}i:907;a:7:{s:2:"id";i:908;s:10:"disease_id";i:225;s:11:"question_en";s:25:"Can skin cancer be cured?";s:9:"answer_en";s:42:"Early detection greatly improves outcomes.";s:11:"question_hi";s:82:"क्या त्वचा कैंसर ठीक हो सकता है?";s:9:"answer_hi";s:99:"जल्दी पहचान से परिणाम बेहतर होते हैं।";s:10:"sort_order";i:3;}i:908;a:7:{s:2:"id";i:909;s:10:"disease_id";i:225;s:11:"question_en";s:20:"How is it diagnosed?";s:9:"answer_en";s:36:"Through skin examination and biopsy.";s:11:"question_hi";s:49:"निदान कैसे होता है?";s:9:"answer_hi";s:91:"त्वचा परीक्षण और बायोप्सी द्वारा।";s:10:"sort_order";i:4;}i:909;a:7:{s:2:"id";i:910;s:10:"disease_id";i:225;s:11:"question_en";s:24:"How can it be prevented?";s:9:"answer_en";s:47:"Use sunscreen and avoid excessive sun exposure.";s:11:"question_hi";s:45:"रोकथाम कैसे करें?";s:9:"answer_hi";s:103:"सनस्क्रीन का उपयोग करें और धूप से बचें।";s:10:"sort_order";i:5;}i:910;a:7:{s:2:"id";i:911;s:10:"disease_id";i:226;s:11:"question_en";s:24:"What is alopecia areata?";s:9:"answer_en";s:49:"An autoimmune condition causing patchy hair loss.";s:11:"question_hi";s:70:"एलोपेसिया एरियाटा क्या है?";s:9:"answer_hi";s:95:"ऑटोइम्यून रोग जिसमें बाल झड़ते हैं।";s:10:"sort_order";i:1;}i:911;a:7:{s:2:"id";i:912;s:10:"disease_id";i:226;s:11:"question_en";s:28:"What causes alopecia areata?";s:9:"answer_en";s:41:"The immune system attacks hair follicles.";s:11:"question_hi";s:43:"यह क्यों होता है?";s:9:"answer_hi";s:134:"प्रतिरक्षा प्रणाली बालों की जड़ों पर हमला करती है।";s:10:"sort_order";i:2;}i:912;a:7:{s:2:"id";i:913;s:10:"disease_id";i:226;s:11:"question_en";s:23:"Is hair loss permanent?";s:9:"answer_en";s:30:"Hair may regrow in many cases.";s:11:"question_hi";s:92:"क्या बाल स्थायी रूप से झड़ जाते हैं?";s:9:"answer_hi";s:97:"कई मामलों में बाल दोबारा उग सकते हैं।";s:10:"sort_order";i:3;}i:913;a:7:{s:2:"id";i:914;s:10:"disease_id";i:226;s:11:"question_en";s:21:"Can stress worsen it?";s:9:"answer_en";s:38:"Stress may trigger or worsen episodes.";s:11:"question_hi";s:69:"क्या तनाव इसे बढ़ा सकता है?";s:9:"answer_hi";s:69:"हाँ, तनाव इसे बढ़ा सकता है।";s:10:"sort_order";i:4;}i:914;a:7:{s:2:"id";i:915;s:10:"disease_id";i:226;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:54:"Treatment may include topical or injectable therapies.";s:11:"question_hi";s:62:"इसका उपचार कैसे होता है?";s:9:"answer_hi";s:112:"स्थानीय या इंजेक्शन उपचार दिए जा सकते हैं।";s:10:"sort_order";i:5;}i:915;a:7:{s:2:"id";i:916;s:10:"disease_id";i:227;s:11:"question_en";s:30:"What is androgenetic alopecia?";s:9:"answer_en";s:51:"It is the most common form of hereditary hair loss.";s:11:"question_hi";s:88:"एंड्रोजेनेटिक एलोपेसिया क्या है?";s:9:"answer_hi";s:128:"यह आनुवंशिक बाल झड़ने का सबसे सामान्य प्रकार है।";s:10:"sort_order";i:1;}i:916;a:7:{s:2:"id";i:917;s:10:"disease_id";i:227;s:11:"question_en";s:16:"Who is affected?";s:9:"answer_en";s:35:"Both men and women can be affected.";s:11:"question_hi";s:65:"यह किसे प्रभावित करता है?";s:9:"answer_hi";s:118:"पुरुष और महिलाएं दोनों प्रभावित हो सकते हैं।";s:10:"sort_order";i:2;}i:917;a:7:{s:2:"id";i:918;s:10:"disease_id";i:227;s:11:"question_en";s:16:"Is it permanent?";s:9:"answer_en";s:51:"Hair loss may gradually progress without treatment.";s:11:"question_hi";s:46:"क्या यह स्थायी है?";s:9:"answer_hi";s:87:"बिना उपचार बाल झड़ना बढ़ सकता है।";s:10:"sort_order";i:3;}i:918;a:7:{s:2:"id";i:919;s:10:"disease_id";i:227;s:11:"question_en";s:19:"Can treatment help?";s:9:"answer_en";s:48:"Treatment may slow hair loss and improve growth.";s:11:"question_hi";s:59:"क्या उपचार मदद करता है?";s:9:"answer_hi";s:78:"उपचार बाल झड़ना कम कर सकता है।";s:10:"sort_order";i:4;}i:919;a:7:{s:2:"id";i:920;s:10:"disease_id";i:227;s:11:"question_en";s:16:"Is it inherited?";s:9:"answer_en";s:38:"Family history is a major risk factor.";s:11:"question_hi";s:52:"क्या यह आनुवंशिक है?";s:9:"answer_hi";s:111:"पारिवारिक इतिहास एक प्रमुख जोखिम कारक है।";s:10:"sort_order";i:5;}i:920;a:7:{s:2:"id";i:921;s:10:"disease_id";i:228;s:11:"question_en";s:17:"What is dandruff?";s:9:"answer_en";s:37:"Dandruff causes flaking of the scalp.";s:11:"question_hi";s:33:"रूसी क्या है?";s:9:"answer_hi";s:117:"रूसी सिर की त्वचा की पपड़ी बनने की समस्या है।";s:10:"sort_order";i:1;}i:921;a:7:{s:2:"id";i:922;s:10:"disease_id";i:228;s:11:"question_en";s:21:"What causes dandruff?";s:9:"answer_en";s:56:"Oiliness, fungal growth, and skin irritation contribute.";s:11:"question_hi";s:49:"रूसी क्यों होती है?";s:9:"answer_hi";s:109:"तेल, फंगस और त्वचा की जलन कारण हो सकते हैं।";s:10:"sort_order";i:2;}i:922;a:7:{s:2:"id";i:923;s:10:"disease_id";i:228;s:11:"question_en";s:23:"Is dandruff contagious?";s:9:"answer_en";s:31:"No, dandruff is not contagious.";s:11:"question_hi";s:58:"क्या रूसी संक्रामक है?";s:9:"answer_hi";s:74:"नहीं, रूसी संक्रामक नहीं है।";s:10:"sort_order";i:3;}i:923;a:7:{s:2:"id";i:924;s:10:"disease_id";i:228;s:11:"question_en";s:27:"Can stress worsen dandruff?";s:9:"answer_en";s:32:"Yes, stress may worsen symptoms.";s:11:"question_hi";s:65:"क्या तनाव रूसी बढ़ाता है?";s:9:"answer_hi";s:75:"हाँ, तनाव लक्षण बढ़ा सकता है।";s:10:"sort_order";i:4;}i:924;a:7:{s:2:"id";i:925;s:10:"disease_id";i:228;s:11:"question_en";s:31:"How can dandruff be controlled?";s:9:"answer_en";s:47:"Regular scalp care and medicated shampoos help.";s:11:"question_hi";s:74:"रूसी को कैसे नियंत्रित करें?";s:9:"answer_hi";s:102:"नियमित सफाई और औषधीय शैम्पू सहायक हैं।";s:10:"sort_order";i:5;}i:925;a:7:{s:2:"id";i:926;s:10:"disease_id";i:229;s:11:"question_en";s:22:"What is hyperhidrosis?";s:9:"answer_en";s:45:"It is excessive sweating beyond normal needs.";s:11:"question_hi";s:66:"हाइपरहाइड्रोसिस क्या है?";s:9:"answer_hi";s:110:"यह सामान्य से अधिक पसीना आने की स्थिति है।";s:10:"sort_order";i:1;}i:926;a:7:{s:2:"id";i:927;s:10:"disease_id";i:229;s:11:"question_en";s:30:"Which body parts are affected?";s:9:"answer_en";s:50:"Hands, feet, underarms, and face are common sites.";s:11:"question_hi";s:75:"कौन से अंग प्रभावित होते हैं?";s:9:"answer_hi";s:105:"हाथ, पैर, बगल और चेहरा सामान्य स्थान हैं।";s:10:"sort_order";i:2;}i:927;a:7:{s:2:"id";i:928;s:10:"disease_id";i:229;s:11:"question_en";s:27:"Is hyperhidrosis dangerous?";s:9:"answer_en";s:59:"It is usually not dangerous but may affect quality of life.";s:11:"question_hi";s:46:"क्या यह खतरनाक है?";s:9:"answer_hi";s:145:"आमतौर पर नहीं, लेकिन जीवन गुणवत्ता प्रभावित हो सकती है।";s:10:"sort_order";i:3;}i:928;a:7:{s:2:"id";i:929;s:10:"disease_id";i:229;s:11:"question_en";s:28:"Can stress trigger sweating?";s:9:"answer_en";s:32:"Yes, stress may worsen sweating.";s:11:"question_hi";s:68:"क्या तनाव पसीना बढ़ाता है?";s:9:"answer_hi";s:69:"हाँ, तनाव इसे बढ़ा सकता है।";s:10:"sort_order";i:4;}i:929;a:7:{s:2:"id";i:930;s:10:"disease_id";i:229;s:11:"question_en";s:18:"How is it treated?";s:9:"answer_en";s:55:"Treatment includes antiperspirants and other therapies.";s:11:"question_hi";s:62:"इसका उपचार कैसे होता है?";s:9:"answer_hi";s:136:"उपचार में एंटीपर्सपिरेंट और अन्य थेरेपी शामिल हैं।";s:10:"sort_order";i:5;}i:930;a:7:{s:2:"id";i:931;s:10:"disease_id";i:230;s:11:"question_en";s:33:"What is hidradenitis suppurativa?";s:9:"answer_en";s:47:"A chronic skin disease causing painful nodules.";s:11:"question_hi";s:100:"हाइड्राडेनाइटिस सप्पुरेटिवा क्या है?";s:9:"answer_hi";s:136:"यह दर्दनाक गांठों वाली दीर्घकालिक त्वचा बीमारी है।";s:10:"sort_order";i:1;}i:931;a:7:{s:2:"id";i:932;s:10:"disease_id";i:230;s:11:"question_en";s:20:"Where does it occur?";s:9:"answer_en";s:36:"Commonly in armpits and groin areas.";s:11:"question_hi";s:40:"यह कहाँ होता है?";s:9:"answer_hi";s:119:"अक्सर बगल और जांघ के जोड़ वाले क्षेत्रों में।";s:10:"sort_order";i:2;}i:932;a:7:{s:2:"id";i:933;s:10:"disease_id";i:230;s:11:"question_en";s:17:"Is it contagious?";s:9:"answer_en";s:25:"No, it is not contagious.";s:11:"question_hi";s:52:"क्या यह संक्रामक है?";s:9:"answer_hi";s:68:"नहीं, यह संक्रामक नहीं है।";s:10:"sort_order";i:3;}i:933;a:7:{s:2:"id";i:934;s:10:"disease_id";i:230;s:11:"question_en";s:22:"Can smoking worsen it?";s:9:"answer_en";s:36:"Yes, smoking is a known risk factor.";s:11:"question_hi";s:74:"क्या धूम्रपान इसे बढ़ाता है?";s:9:"answer_hi";s:81:"हाँ, धूम्रपान एक जोखिम कारक है।";s:10:"sort_order";i:4;}i:934;a:7:{s:2:"id";i:935;s:10:"disease_id";i:230;s:11:"question_en";s:16:"Can it be cured?";s:9:"answer_en";s:32:"It can be managed but may recur.";s:11:"question_hi";s:80:"क्या यह पूरी तरह ठीक हो सकता है?";s:9:"answer_hi";s:136:"इसे नियंत्रित किया जा सकता है लेकिन पुनः हो सकता है।";s:10:"sort_order";i:5;}i:935;a:7:{s:2:"id";i:936;s:10:"disease_id";i:231;s:11:"question_en";s:17:"What is a keloid?";s:9:"answer_en";s:51:"A raised scar that grows beyond the original wound.";s:11:"question_hi";s:39:"कीलॉइड क्या है?";s:9:"answer_hi";s:71:"घाव से बड़ा बढ़ा हुआ निशान।";s:10:"sort_order";i:1;}i:936;a:7:{s:2:"id";i:937;s:10:"disease_id";i:231;s:11:"question_en";s:20:"What causes keloids?";s:9:"answer_en";s:42:"Abnormal scar formation after skin injury.";s:11:"question_hi";s:55:"कीलॉइड क्यों बनता है?";s:9:"answer_hi";s:106:"त्वचा चोट के बाद असामान्य निशान बनने से।";s:10:"sort_order";i:2;}i:937;a:7:{s:2:"id";i:938;s:10:"disease_id";i:231;s:11:"question_en";s:20:"Are keloids harmful?";s:9:"answer_en";s:45:"Usually not harmful but may cause discomfort.";s:11:"question_hi";s:64:"क्या कीलॉइड हानिकारक है?";s:9:"answer_hi";s:104:"आमतौर पर नहीं, लेकिन असुविधा हो सकती है।";s:10:"sort_order";i:3;}i:938;a:7:{s:2:"id";i:939;s:10:"disease_id";i:231;s:11:"question_en";s:35:"Can keloids return after treatment?";s:9:"answer_en";s:28:"Yes, recurrence is possible.";s:11:"question_hi";s:92:"क्या उपचार के बाद दोबारा हो सकता है?";s:9:"answer_hi";s:53:"हाँ, पुनः हो सकता है।";s:10:"sort_order";i:4;}i:939;a:7:{s:2:"id";i:940;s:10:"disease_id";i:231;s:11:"question_en";s:25:"Can keloids be prevented?";s:9:"answer_en";s:34:"Proper wound care may reduce risk.";s:11:"question_hi";s:72:"क्या कीलॉइड रोका जा सकता है?";s:9:"answer_hi";s:94:"उचित घाव देखभाल जोखिम कम कर सकती है।";s:10:"sort_order";i:5;}i:940