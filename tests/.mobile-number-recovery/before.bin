  `form_id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `substance_id` bigint(20) unsigned NOT NULL,
  `form_name` varchar(255) NOT NULL,
  `form_name_normalized` varchar(255) NOT NULL,
