 SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Medicine provisional history is immutable';
END";s:20:"character_set_client";s:7:"utf8mb4";s:20:"collation_connection";s:18:"utf8mb4_general_ci";s:18:"Database Collation";s:18:"utf8mb4_general_ci";}}s:4:"mode";a:2:{s:12:"session_mode";s:51:"NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION";s:11:"global_mode";s:51:"NO_ZERO_IN_DATE,NO_ZERO_DATE,NO_ENGINE_SUBSTITUTION";}s:17:"database_defaults";a:2:{s:26:"DEFAULT_CHARACTER_SET_NAME";s:7:"utf8mb4";s:22:"DEFAULT_COLLATION_NAME";s:18:"utf8mb4_general_ci";}}