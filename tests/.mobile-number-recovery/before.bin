  `medicine_identity_id` bigint(20) unsigned NOT NULL,
  `key_version` smallint(5) unsigned NOT NULL DEFAULT 1,
  `presentation_hash` binary(32) NOT NULL,
  `presentation_key` text CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `dosage_form_code` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `route_code` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `release_code` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `display_name` varchar(500) DEFAULT NULL,
  `identity_status` varchar(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL DEFAULT 'candidate',
  `metadata_revision` int(10) unsigned NOT NULL DEFAULT 1,
  `created_by` int(11) NOT NULL,
  `created_at` datetime(6) NOT NULL,
  `updated_at` datetime(6) NOT NULL,
  `verified_by` int(11) DEFAULT NULL,
  `verified_at` datetime(6) DEFAULT NULL,
  `verification_reference` text DEFAULT NULL,
  `retired_by` int(11) DEFAULT NULL,
  `retired_at` datetime(6) DEFAULT NULL,
  `retirement_reason` text DEFAULT NULL,
  PRIMARY KEY (`medicine_presentation_id`),
  UNIQUE KEY `uq_medicine_presentation_hash` (`presentation_hash`),
  UNIQUE KEY `uq_medicine_presentation_scope` (`medicine_identity_id`,`medicine_presentation_id`),
  KEY `idx_medicine_presentation_identity` (`medicine_identity_id`,`identity_status`,`medicine_presentation_id`),
  KEY `idx_medicine_presentation_status` (`identity_status`,`medicine_presentation_id`),
  KEY `idx_medicine_presentation_created_by` (`created_by`),
  KEY `idx_medicine_presentation_verified_by` (`verified_by`),
  KEY `idx_medicine_presentation_retired_by` (`retired_by`),
  CONSTRAINT `fk_medicine_presentation_created_by` FOREIGN KEY (`created_by`) REFERENCES `users` (`id`),
  CONSTRAINT `fk_medicine_presentation_identity` FOREIGN KEY (`medicine_identity_id`) REFERENCES `kobi_medicine_identities` (`medicine_identity_id`),
  CONSTRAINT `fk_medicine_presentation_retired_by` FOREIGN KEY (`retired_by`) REFERENCES `users` (`id`),
  CONSTRAINT `fk_medicine_presentation_verified_by` FOREIGN KEY (`verified_by`) REFERENCES `users` (`id`),
  CONSTRAINT `chk_medicine_presentation_version` CHECK (`key_version` = 1),
  CONSTRAINT `chk_medicine_presentation_key` CHECK (json_valid(`presentation_key`) and octet_length(`presentation_key`) <= 16384),
  CONSTRAINT `chk_medicine_presentation_form` CHECK (cast(`dosage_form_code` as char charset binary) in (cast('tablet' as char charset binary),cast('capsule' as char charset binary),cast('solution' as char charset binary),cast('suspension' as char charset binary),cast('cream' as char charset binary),cast('ointment' as char charset binary))),
  CONSTRAINT `chk_medicine_presentation_route` CHECK (cast(`route_code` as char charset binary) in (cast('oral' as char charset binary),cast('cutaneous' as char charset binary))),
  CONSTRAINT `chk_medicine_presentation_release` CHECK (cast(`release_code` as char charset binary) in (cast('immediate' as char charset binary),cast('delayed' as char charset binary),cast('extended' as char charset binary),cast('not_applicable' as char charset binary))),
  CONSTRAINT `chk_medicine_presentation_form_route` CHECK (cast(`dosage_form_code` as char charset binary) in (cast('tablet' as char charset binary),cast('capsule' as char charset binary),cast('solution' as char charset binary),cast('suspension' as char charset binary)) and cast(`route_code` as char charset binary) = cast('oral' as char charset binary) or cast(`dosage_form_code` as char charset binary) in (cast('cream' as char charset binary),cast('ointment' as char charset binary)) and cast(`route_code` as char charset binary) = cast('cutaneous' as char charset binary)),
  CONSTRAINT `chk_medicine_presentation_form_release` CHECK (cast(`dosage_form_code` as char charset binary) in (cast('tablet' as char charset binary),cast('capsule' as char charset binary)) and cast(`release_code` as char charset binary) in (cast('immediate' as char charset binary),cast('delayed' as char charset binary),cast('extended' as char charset binary)) or cast(`dosage_form_code` as char charset binary) in (cast('solution' as char charset binary),cast('suspension' as char charset binary),cast('cream' as char charset binary),cast('ointment' as char charset binary)) and cast(`release_code` as char charset binary) = cast('not_applicable' as char charset binary)),
  CONSTRAINT `chk_medicine_presentation_status` CHECK (cast(`identity_status` as char charset binary) in (cast('candidate' as char charset binary),cast('verified' as char charset binary),cast('retired' as char charset binary))),
  CONSTRAINT `chk_medicine_presentation_revision` CHECK (`metadata_revision` >= 1),
  CONSTRAINT `chk_medicine_presentation_verification` CHECK (`verified_by` is null and `verified_at` is null and `verification_reference` is null or `verified_by` is not null and `verified_at` is not null and `verification_reference` is not null and char_length(trim(`verification_reference`)) > 0),
  CONSTRAINT `chk_medicine_presentation_verified` CHECK (cast(`identity_status` as char charset binary) <> cast('verified' as char charset binary) or `verified_by` is not null),
