  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `user_id` int(11) NOT NULL,
  `capability` varchar(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `scope` varchar(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `is_active` tinyint(3) unsigned NOT NULL DEFAULT 1,
  `qualification_reference` text DEFAULT NULL,
  `qualification_assessed_by` int(11) DEFAULT NULL,
  `qualification_scope` varchar(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL,
  `granted_by` int(11) NOT NULL,
  `granted_at` datetime(6) NOT NULL,
  `expires_at` datetime(6) DEFAULT NULL,
  `revoked_by` int(11) DEFAULT NULL,
  `revoked_at` datetime(6) DEFAULT NULL,
  `revocation_reason` text DEFAULT NULL,
  `active_slot` tinyint(4) GENERATED ALWAYS AS (case when `revoked_at` is null then 1 else NULL end) STORED,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_medicine_active_grant` (`user_id`,`capability`,`scope`,`active_slot`),
  KEY `idx_medicine_grant_actor` (`user_id`,`is_active`,`expires_at`),
  KEY `fk_medicine_grant_authorizer` (`granted_by`),
  KEY `fk_medicine_grant_qualification` (`qualification_assessed_by`),
  KEY `fk_medicine_grant_revoker` (`revoked_by`),
  CONSTRAINT `fk_medicine_grant_authorizer` FOREIGN KEY (`granted_by`) REFERENCES `users` (`id`),
  CONSTRAINT `fk_medicine_grant_qualification` FOREIGN KEY (`qualification_assessed_by`) REFERENCES `users` (`id`),
  CONSTRAINT `fk_medicine_grant_revoker` FOREIGN KEY (`revoked_by`) REFERENCES `users` (`id`),
  CONSTRAINT `fk_medicine_grant_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`),
  CONSTRAINT `chk_medicine_grant_codes` CHECK (cast(`capability` as char charset binary) in (cast('contributor' as char charset binary),cast('editor' as char charset binary),cast('reviewer' as char charset binary),cast('publisher' as char charset binary),cast('steward' as char charset binary),cast('administrator' as char charset binary),cast('registry' as char charset binary),cast('deployment' as char charset binary)) and cast(`scope` as char charset binary) in (cast('chemical' as char charset binary),cast('composition' as char charset binary),cast('presentation' as char charset binary),cast('catalog' as char charset binary))),
  CONSTRAINT `chk_medicine_grant_qualification_tuple` CHECK (`qualification_reference` is null and `qualification_assessed_by` is null and `qualification_scope` is null or `qualification_reference` is not null and char_length(trim(`qualification_reference`)) > 0 and `qualification_assessed_by` is not null and `qualification_scope` is not null and cast(`qualification_scope` as char charset binary) in (cast('chemical' as char charset binary),cast('composition' as char charset binary),cast('presentation' as char charset binary),cast('catalog' as char charset binary))),
  CONSTRAINT `chk_medicine_grant_reviewer` CHECK (cast(`capability` as char charset binary) <> cast('reviewer' as char charset binary) or `qualification_reference` is not null),
  CONSTRAINT `chk_medicine_grant_revocation` CHECK (`revoked_by` is null and `revoked_at` is null and `revocation_reason` is null or `revoked_by` is not null and `revoked_at` is not null and `revocation_reason` is not null and char_length(trim(`revocation_reason`)) > 0 and `is_active` = 0),
  CONSTRAINT `chk_medicine_grant_active` CHECK (`is_active` in (0,1) and (`expires_at` is not null and `expires_at` > `granted_at` or `expires_at` is null and cast(`capability` as char charset binary) = cast('administrator' as char charset binary) and cast(`scope` as char charset binary) = cast('catalog' as char charset binary) and `user_id` = `granted_by` and `qualification_reference` is null and `qualification_assessed_by` is null and `qualification_scope` is null))
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci";s:7:"columns";a:15:{i:0;a:9:{s:5:"Field";s:2:"id";s:4:"Type";s:19:"bigint(20) unsigned";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:3:"PRI";s:7:"Default";N;s:5:"Extra";s:14:"auto_increment";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:1;a:9:{s:5:"Field";s:7:"user_id";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:3:"MUL";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:2;a:9:{s:5:"Field";s:10:"capability";s:4:"Type";s:11:"varchar(16)";s:9:"Collation";s:11:"utf8mb4_bin";s:4:"Null";s:2:"NO";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:3;a:9:{s:5:"Field";s:5:"scope";s:4:"Type";s:11:"varchar(16)";s:9:"Collation";s:11:"utf8mb4_bin";s:4:"Null";s:2:"NO";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:4;a:9:{s:5:"Field";s:9:"is_active";s:4:"Type";s:19:"tinyint(3) unsigned";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:0:"";s:7:"Default";s:1:"1";s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:5;a:9:{s:5:"Field";s:23:"qualification_reference";s:4:"Type";s:4:"text";s:9:"Collation";s:18:"utf8mb4_unicode_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:6;a:9:{s:5:"Field";s:25:"qualification_assessed_by";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:3:"YES";s:3:"Key";s:3:"MUL";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:7;a:9:{s:5:"Field";s:19:"qualification_scope";s:4:"Type";s:11:"varchar(16)";s:9:"Collation";s:11:"utf8mb4_bin";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:8;a:9:{s:5:"Field";s:10:"granted_by";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:3:"MUL";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:9;a:9:{s:5:"Field";s:10:"granted_at";s:4:"Type";s:11:"datetime(6)";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:10;a:9:{s:5:"Field";s:10:"expires_at";s:4:"Type";s:11:"datetime(6)";s:9:"Collation";N;s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:11;a:9:{s:5:"Field";s:10:"revoked_by";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:3:"YES";s:3:"Key";s:3:"MUL";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:12;a:9:{s:5:"Field";s:10:"revoked_at";s:4:"Type";s:11:"datetime(6)";s:9:"Collation";N;s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:13;a:9:{s:5:"Field";s:17:"revocation_reason";s:4:"Type";s:4:"text";s:9:"Collation";s:18:"utf8mb4_unicode_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:14;a:9:{s:5:"Field";s:11:"active_slot";s:4:"Type";s:10:"tinyint(4)";s:9:"Collation";N;s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:16:"STORED GENERATED";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}}s:4:"rows";a:1:{i:0;a:15:{s:2:"id";i:1;s:7:"user_id";i:1;s:10:"capability";s:13:"administrator";s:5:"scope";s:7:"catalog";s:9:"is_active";i:1;s:23:"qualification_reference";N;s:25:"qualification_assessed_by";N;s:19:"qualification_scope";N;s:10:"granted_by";i:1;s:10:"granted_at";s:26:"2026-10-10 19:30:25.594320";s:10:"expires_at";N;s:10:"revoked_by";N;s:10:"revoked_at";N;s:17:"revocation_reason";N;s:11:"active_slot";i:1;}}}s:28:"medicine_evidence_appraisals";a:3:{s:3:"ddl";s:2939:"CREATE TABLE `medicine_evidence_appraisals` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `substance_id` bigint(20) unsigned NOT NULL,
  `provisional_revision` int(10) unsigned NOT NULL,
  `decision_revision` int(10) unsigned NOT NULL,
  `state` varchar(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `reviewer_id` int(11) NOT NULL,
  `qualification_event_id` bigint(20) unsigned NOT NULL,
  `authority_grant_id` bigint(20) unsigned NOT NULL,
  `snapshot_json` mediumtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `snapshot_hash` binary(32) NOT NULL,
  `occurred_at` datetime(6) NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_medicine_appraisal_revision` (`substance_id`,`provisional_revision`,`decision_revision`),
  KEY `idx_medicine_appraisal_qualification` (`qualification_event_id`,`reviewer_id`),
  KEY `fk_medicine_appraisal_grant` (`authority_grant_id`),
  CONSTRAINT `fk_medicine_appraisal_grant` FOREIGN KEY (`authority_grant_id`) REFERENCES `medicine_authority_grants` (`id`),
  CONSTRAINT `fk_medicine_appraisal_qualification` FOREIGN KEY (`qualification_event_id`, `reviewer_id`) REFERENCES `medicine_reviewer_qualifications` (`id`, `user_id`),
  CONSTRAINT `fk_medicine_appraisal_target` FOREIGN KEY (`substance_id`, `provisional_revision`) REFERENCES `medicine_provisional_identity_revisions` (`substance_id`, `revision`),
  CONSTRAINT `chk_medicine_appraisal_state` CHECK (cast(`state` as char charset binary) in (cast('pending' as char charset binary),cast('accepted' as char charset binary),cast('rejected' as char charset binary),cast('withdrawn' as char charset binary))),
  CONSTRAINT `chk_medicine_appraisal_shape` CHECK (`decision_revision` >= 1 and json_valid(`snapshot_json`) and octet_length(`snapshot_json`) <= 65535 and `snapshot_hash` = unhex(sha2(`snapshot_json`,256))),
  CONSTRAINT `chk_medicine_appraisal_binding` CHECK (ifnull(cast(json_unquote(json_extract(`snapshot_json`,'$.target')) as char charset binary) = cast(concat('provisional:S:',`substance_id`) as char charset binary) and convert(json_unquote(json_extract(`snapshot_json`,'$.provisional_revision')) using utf8mb4) = cast(`provisional_revision` as char charset utf8mb4) and convert(json_unquote(json_extract(`snapshot_json`,'$.reviewer_id')) using utf8mb4) = cast(`reviewer_id` as char charset utf8mb4) and convert(json_unquote(json_extract(`snapshot_json`,'$.reviewer_qualification.qualification_event_id')) using utf8mb4) = cast(`qualification_event_id` as char charset utf8mb4) and cast(json_unquote(json_extract(`snapshot_json`,'$.state')) as char charset binary) = cast(`state` as char charset binary) and cast(json_unquote(json_extract(`snapshot_json`,'$.purpose')) as char charset binary) = cast('identity' as char charset binary) and convert(json_unquote(json_extract(`snapshot_json`,'$.canonical_approval')) using utf8mb4) = '',0))
