) ENGINE=InnoDB AUTO_INCREMENT=2291 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci";s:7:"columns";a:7:{i:0;a:9:{s:5:"Field";s:2:"id";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:3:"PRI";s:7:"Default";N;s:5:"Extra";s:14:"auto_increment";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:1;a:9:{s:5:"Field";s:10:"disease_id";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:3:"MUL";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:2;a:9:{s:5:"Field";s:19:"treatment_system_id";s:4:"Type";s:7:"int(11)";s:9:"Collation";N;s:4:"Null";s:2:"NO";s:3:"Key";s:3:"MUL";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:3;a:9:{s:5:"Field";s:8:"title_en";s:4:"Type";s:12:"varchar(255)";s:9:"Collation";s:18:"utf8mb4_general_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:4;a:9:{s:5:"Field";s:8:"title_hi";s:4:"Type";s:12:"varchar(255)";s:9:"Collation";s:18:"utf8mb4_general_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:5;a:9:{s:5:"Field";s:11:"overview_en";s:4:"Type";s:4:"text";s:9:"Collation";s:18:"utf8mb4_general_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}i:6;a:9:{s:5:"Field";s:11:"overview_hi";s:4:"Type";s:4:"text";s:9:"Collation";s:18:"utf8mb4_general_ci";s:4:"Null";s:3:"YES";s:3:"Key";s:0:"";s:7:"Default";N;s:5:"Extra";s:0:"";s:10:"Privileges";s:31:"select,insert,update,references";s:7:"Comment";s:0:"";}}s:4:"rows";a:2150:{i:0;a:7:{s:2:"id";i:1;s:10:"disease_id";i:362;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:294:"Modern treatment includes lifestyle modification, weight reduction, regular exercise, Metformin, Sulfonylureas, DPP-4 inhibitors, SGLT2 inhibitors, GLP-1 receptor agonists, and insulin therapy when necessary. Patients should follow physician guidance and regularly monitor blood glucose levels.";s:11:"overview_hi";N;}i:1;a:7:{s:2:"id";i:2;s:10:"disease_id";i:81;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:275:"Modern treatment focuses on lifestyle modification and medications when necessary. Common medicines include ACE inhibitors, ARBs, calcium channel blockers, beta blockers, and diuretics. Regular monitoring and adherence to treatment are essential for preventing complications.";s:11:"overview_hi";N;}i:2;a:7:{s:2:"id";i:3;s:10:"disease_id";i:181;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:292:"Modern treatment depends on symptoms and patient goals. Options include lifestyle modification, weight loss, oral contraceptive pills for cycle regulation, Metformin for insulin resistance, fertility treatments when pregnancy is desired, and medications to reduce excess hair growth and acne.";s:11:"overview_hi";N;}i:3;a:7:{s:2:"id";i:4;s:10:"disease_id";i:106;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:287:"There is no single medicine that cures fatty liver. Treatment focuses on weight reduction, management of diabetes and cholesterol, regular exercise, and lifestyle modification. Doctors may prescribe medications to manage associated conditions such as diabetes, obesity, and dyslipidemia.";s:11:"overview_hi";N;}i:4;a:7:{s:2:"id";i:5;s:10:"disease_id";i:142;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:284:"Treatment depends on the size and location of the stone. Small stones may pass naturally with increased fluid intake and pain medications. Larger stones may require medications such as alpha blockers, extracorporeal shock wave lithotripsy (ESWL), ureteroscopy, or surgical procedures.";s:11:"overview_hi";N;}i:5;a:7:{s:2:"id";i:6;s:10:"disease_id";i:1;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:387:"Treatment includes acute and preventive therapies. Acute treatments may include NSAIDs, paracetamol, triptans, anti-nausea medications, and in some cases newer migraine-specific therapies. Preventive treatments may include beta blockers, anticonvulsants, antidepressants, CGRP-targeted therapies, and lifestyle modifications. Treatment selection depends on attack frequency and severity.";s:11:"overview_hi";N;}i:6;a:7:{s:2:"id";i:8;s:10:"disease_id";i:101;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:219:"Modern treatment includes lifestyle modification, antacids, H2 receptor blockers, proton pump inhibitors (PPIs), and treatment of underlying causes. Severe cases may require surgical intervention such as fundoplication.";s:11:"overview_hi";N;}i:7;a:7:{s:2:"id";i:9;s:10:"disease_id";i:236;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:277:"Modern treatment focuses on pain relief, improving joint function, and slowing progression. Treatment may include physical therapy, exercise programs, weight reduction, acetaminophen, NSAIDs, topical medications, joint injections, and in severe cases joint replacement surgery.";s:11:"overview_hi";N;}i:8;a:7:{s:2:"id";i:10;s:10:"disease_id";i:301;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:280:"Modern treatment may include psychotherapy such as Cognitive Behavioral Therapy (CBT), counseling, antidepressant medications including SSRIs and SNRIs, lifestyle modifications, and treatment of underlying medical conditions. Severe cases may require specialized psychiatric care.";s:11:"overview_hi";N;}i:9;a:7:{s:2:"id";i:16;s:10:"disease_id";i:362;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:305:"Traditional Ayurvedic management may include herbs such as Gudmar (Gymnema Sylvestre), Karela, Jamun, Vijaysar, Turmeric, and Amla. Ayurveda emphasizes dietary discipline, digestion improvement, weight management, and balancing doshas. Treatment should be supervised by a qualified Ayurvedic practitioner.";s:11:"overview_hi";N;}i:10;a:7:{s:2:"id";i:17;s:10:"disease_id";i:81;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:223:"Ayurvedic management may include Arjuna, Sarpagandha, Ashwagandha, Brahmi, and Jatamansi under professional supervision. Ayurveda also emphasizes stress reduction, balanced diet, proper sleep, and routine physical activity.";s:11:"overview_hi";N;}i:11;a:7:{s:2:"id";i:18;s:10:"disease_id";i:181;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:260:"Ayurvedic management may include herbs such as Shatavari, Ashoka, Lodhra, Guduchi, and Triphala under professional supervision. Ayurveda focuses on balancing hormones, improving digestion, supporting weight management, and maintaining regular menstrual cycles.";s:11:"overview_hi";N;}i:12;a:7:{s:2:"id";i:19;s:10:"disease_id";i:106;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:242:"Ayurvedic management may include herbs such as Bhumyamalaki, Kutki, Kalmegh, Guduchi, Triphala, and Amla under professional supervision. Ayurveda emphasizes improving digestion, reducing excess fat accumulation, and supporting liver function.";s:11:"overview_hi";N;}i:13;a:7:{s:2:"id";i:20;s:10:"disease_id";i:142;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:229:"Ayurvedic management may include herbs such as Gokshura, Punarnava, Varuna, Pashanbheda, and Kulthi under professional supervision. Traditional Ayurvedic approaches focus on supporting urinary health and reducing stone formation.";s:11:"overview_hi";N;}i:14;a:7:{s:2:"id";i:21;s:10:"disease_id";i:1;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:229:"Ayurvedic management may include Brahmi, Ashwagandha, Shankhpushpi, Jatamansi, and Nasya therapy under qualified supervision. Ayurveda emphasizes stress reduction, proper sleep, balanced digestion, and avoidance of trigger foods.";s:11:"overview_hi";N;}i:15;a:7:{s:2:"id";i:23;s:10:"disease_id";i:101;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:208:"Ayurvedic management may include Yashtimadhu, Amla, Shatavari, Guduchi, and dietary regulation under professional supervision. Ayurveda focuses on balancing digestion and reducing aggravating dietary factors.";s:11:"overview_hi";N;}i:16;a:7:{s:2:"id";i:24;s:10:"disease_id";i:236;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:237:"Ayurvedic management may include Shallaki, Guggulu preparations, Ashwagandha, Nirgundi, and Panchakarma therapies under professional supervision. Ayurveda focuses on reducing inflammation, improving mobility, and supporting joint health.";s:11:"overview_hi";N;}i:17;a:7:{s:2:"id";i:25;s:10:"disease_id";i:301;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:235:"Ayurvedic management may include Brahmi, Ashwagandha, Jatamansi, Shankhpushpi, and lifestyle balancing practices under qualified supervision. Ayurveda emphasizes mental calmness, proper sleep, stress management, and overall well-being.";s:11:"overview_hi";N;}i:18;a:7:{s:2:"id";i:31;s:10:"disease_id";i:362;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:310:"Homeopathic practitioners may use remedies such as Syzygium Jambolanum, Uranium Nitricum, Phosphoric Acid, Lycopodium, and Cephalandra Indica depending on the patient’s overall symptom profile. Scientific evidence for effectiveness is limited and patients should not discontinue prescribed medical treatment.";s:11:"overview_hi";N;}i:19;a:7:{s:2:"id";i:32;s:10:"disease_id";i:81;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:254:"Homeopathic practitioners may use remedies such as Rauwolfia Serpentina, Baryta Muriatica, Glonoinum, and Natrum Muriaticum depending on the patient profile. Scientific evidence remains limited and prescribed medical treatment should not be discontinued.";s:11:"overview_hi";N;}i:20;a:7:{s:2:"id";i:33;s:10:"disease_id";i:181;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:274:"Homeopathic practitioners may use remedies such as Pulsatilla, Sepia, Lachesis, Natrum Muriaticum, and Calcarea Carbonica depending on individual symptoms. Evidence for effectiveness is limited and conventional medical treatment should not be stopped without medical advice.";s:11:"overview_hi";N;}i:21;a:7:{s:2:"id";i:34;s:10:"disease_id";i:106;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:287:"Homeopathic practitioners may use remedies such as Chelidonium Majus, Lycopodium, Carduus Marianus, Nux Vomica, and Phosphorus depending on individual symptoms. Scientific evidence remains limited and conventional medical treatment should continue as advised by healthcare professionals.";s:11:"overview_hi";N;}i:22;a:7:{s:2:"id";i:35;s:10:"disease_id";i:142;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:244:"Homeopathic practitioners may use remedies such as Berberis Vulgaris, Lycopodium, Sarsaparilla, Cantharis, and Ocimum Canum depending on symptom patterns. Scientific evidence remains limited and standard medical care should continue as advised.";s:11:"overview_hi";N;}i:23;a:7:{s:2:"id";i:36;s:10:"disease_id";i:1;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:294:"Homeopathic practitioners may prescribe remedies such as Belladonna, Iris Versicolor, Nux Vomica, Sanguinaria, and Gelsemium based on individual symptom patterns. Scientific evidence for effectiveness remains limited and conventional treatment should not be discontinued without medical advice.";s:11:"overview_hi";N;}i:24;a:7:{s:2:"id";i:38;s:10:"disease_id";i:101;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:189:"Homeopathic practitioners may use remedies such as Robinia, Nux Vomica, Carbo Vegetabilis, Lycopodium, and Pulsatilla depending on symptom presentation. Scientific evidence remains limited.";s:11:"overview_hi";N;}i:25;a:7:{s:2:"id";i:39;s:10:"disease_id";i:236;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:200:"Homeopathic practitioners may prescribe remedies such as Rhus Toxicodendron, Bryonia, Calcarea Fluorica, Ruta Graveolens, and Arnica depending on symptom patterns. Scientific evidence remains limited.";s:11:"overview_hi";N;}i:26;a:7:{s:2:"id";i:40;s:10:"disease_id";i:301;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:283:"Homeopathic practitioners may use remedies such as Ignatia, Aurum Metallicum, Natrum Muriaticum, Pulsatilla, and Sepia depending on individual symptoms. Scientific evidence remains limited and prescribed mental health treatment should not be discontinued without professional advice.";s:11:"overview_hi";N;}i:27;a:7:{s:2:"id";i:46;s:10:"disease_id";i:362;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:257:"Commonly used acupressure points include SP6, ST36, LV3, CV12 and KI3. Practitioners believe these points may support metabolism, digestion and overall wellness. Acupressure should be considered complementary rather than a replacement for medical treatment.";s:11:"overview_hi";N;}i:28;a:7:{s:2:"id";i:47;s:10:"disease_id";i:81;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:198:"Commonly recommended acupressure points include LI11, PC6, LV3, KI1, and GV20. These points are believed to support relaxation, circulation, and stress management when used as complementary therapy.";s:11:"overview_hi";N;}i:29;a:7:{s:2:"id";i:48;s:10:"disease_id";i:181;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:194:"Common acupressure points used by practitioners include SP6, CV4, CV6, ST36, and LV3. These points are traditionally used to support hormonal balance, reproductive health, and stress management.";s:11:"overview_hi";N;}i:30;a:7:{s:2:"id";i:49;s:10:"disease_id";i:106;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:202:"Acupressure practitioners commonly use LV3, LV14, ST36, SP6, and CV12 points to support digestion, circulation, and liver health. Acupressure should be considered complementary to standard medical care.";s:11:"overview_hi";N;}i:31;a:7:{s:2:"id";i:50;s:10:"disease_id";i:142;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:218:"Acupressure practitioners may use K3, SP6, BL23, CV3, and ST36 points. These points are traditionally used to support urinary tract function and overall wellness. Acupressure should be considered complementary therapy.";s:11:"overview_hi";N;}i:32;a:7:{s:2:"id";i:51;s:10:"disease_id";i:1;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:240:"Commonly used acupressure points include LI4 (Hegu), GB20 (Fengchi), Taiyang, GV20, and LV3. These points are traditionally used to support relaxation and headache relief. Acupressure should be considered complementary to medical treatment.";s:11:"overview_hi";N;}i:33;a:7:{s:2:"id";i:53;s:10:"disease_id";i:101;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:121:"Acupressure practitioners commonly use CV12, ST36, PC6, SP4, and LV3 points to support digestive function and relaxation.";s:11:"overview_hi";N;}i:34;a:7:{s:2:"id";i:54;s:10:"disease_id";i:236;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:195:"Commonly used acupressure points include ST36, SP9, GB34, LI4, and local points around affected joints. Acupressure may help support relaxation and symptom management as a complementary approach.";s:11:"overview_hi";N;}i:35;a:7:{s:2:"id";i:55;s:10:"disease_id";i:301;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:241:"Acupressure practitioners commonly use GV20, HT7, PC6, LV3, and Yintang points to support relaxation and emotional well-being. Acupressure should be viewed as a complementary approach and not a substitute for professional mental health care.";s:11:"overview_hi";N;}i:36;a:7:{s:2:"id";i:61;s:10:"disease_id";i:362;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:232:"Yoga practices commonly recommended include Surya Namaskar, Mandukasana, Ardha Matsyendrasana, Bhujangasana, Kapalbhati, Anulom Vilom, and meditation. Regular practice may help improve fitness, weight control, and stress management.";s:11:"overview_hi";N;}i:37;a:7:{s:2:"id";i:62;s:10:"disease_id";i:81;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:190:"Yoga practices such as Shavasana, Makarasana, Sukhasana meditation, Nadi Shodhana, Anulom Vilom, Bhramari, and gentle stretching may help improve stress management and cardiovascular health.";s:11:"overview_hi";N;}i:38;a:7:{s:2:"id";i:63;s:10:"disease_id";i:181;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:239:"Yoga practices often recommended include Baddha Konasana, Bhujangasana, Malasana, Setu Bandhasana, Surya Namaskar, Anulom Vilom, and meditation. Regular practice may support weight management, stress reduction, and overall hormonal health.";s:11:"overview_hi";N;}i:39;a:7:{s:2:"id";i:64;s:10:"disease_id";i:106;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:214:"Recommended yoga practices include Bhujangasana, Dhanurasana, Ardha Matsyendrasana, Surya Namaskar, Pawanmuktasana, Kapalbhati, and Anulom Vilom. Regular practice may support weight management and metabolic health.";s:11:"overview_hi";N;}i:40;a:7:{s:2:"id";i:65;s:10:"disease_id";i:142;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:220:"Yoga practices commonly recommended include Pawanmuktasana, Bhujangasana, Dhanurasana, Ardha Matsyendrasana, Vajrasana, and gentle stretching exercises. Yoga may support hydration awareness, mobility, and overall health.";s:11:"overview_hi";N;}i:41;a:7:{s:2:"id";i:66;s:10:"disease_id";i:1;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:229:"Yoga practices such as Anulom Vilom, Bhramari Pranayama, Shavasana, Balasana, Yoga Nidra, and meditation may help reduce stress and improve migraine control. Regular practice is generally more beneficial than occasional practice.";s:11:"overview_hi";N;}i:42;a:7:{s:2:"id";i:68;s:10:"disease_id";i:101;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:161:"Yoga practices such as Vajrasana after meals, Pawanmuktasana, Ardha Matsyendrasana, deep breathing, and stress reduction techniques may support digestive health.";s:11:"overview_hi";N;}i:43;a:7:{s:2:"id";i:69;s:10:"disease_id";i:236;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:212:"Yoga practices such as Tadasana, Vrikshasana, Bhujangasana, Setu Bandhasana, gentle stretching, chair yoga, and breathing exercises may help improve flexibility, balance, and joint function when performed safely.";s:11:"overview_hi";N;}i:44;a:7:{s:2:"id";i:70;s:10:"disease_id";i:301;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:231:"Yoga practices such as meditation, Yoga Nidra, Shavasana, Sukhasana, Anulom Vilom, Bhramari, and mindfulness exercises may help reduce stress and improve emotional well-being. Regular practice can complement professional treatment.";s:11:"overview_hi";N;}i:45;a:7:{s:2:"id";i:76;s:10:"disease_id";i:91;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:160:"Management may include iron supplements, vitamin B12 therapy, folic acid supplementation, blood transfusion in severe cases, and treatment of underlying causes.";s:11:"overview_hi";N;}i:46;a:7:{s:2:"id";i:77;s:10:"disease_id";i:91;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:122:"Ayurvedic management may include Punarnava, Mandura preparations, Draksha, Amla, and dietary correction under supervision.";s:11:"overview_hi";N;}i:47;a:7:{s:2:"id";i:78;s:10:"disease_id";i:91;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:83:"Homeopathic remedies may be selected based on individual symptoms and constitution.";s:11:"overview_hi";N;}i:48;a:7:{s:2:"id";i:79;s:10:"disease_id";i:91;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:94:"Acupressure may be used as supportive therapy to improve overall well-being and energy levels.";s:11:"overview_hi";N;}i:49;a:7:{s:2:"id";i:80;s:10:"disease_id";i:91;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:87:"Yoga and breathing exercises may help improve stamina, circulation, and overall health.";s:11:"overview_hi";N;}i:50;a:7:{s:2:"id";i:81;s:10:"disease_id";i:92;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:107:"Iron supplementation, treatment of blood loss, dietary correction, and management of underlying conditions.";s:11:"overview_hi";N;}i:51;a:7:{s:2:"id";i:82;s:10:"disease_id";i:92;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:95:"Ayurvedic treatment may include Mandura preparations, Punarnava, Amla, and nutritional support.";s:11:"overview_hi";N;}i:52;a:7:{s:2:"id";i:83;s:10:"disease_id";i:92;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:84:"Homeopathic treatment may be selected based on individual symptoms and constitution.";s:11:"overview_hi";N;}i:53;a:7:{s:2:"id";i:84;s:10:"disease_id";i:92;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:75:"Supportive acupressure may be used to promote well-being and energy levels.";s:11:"overview_hi";N;}i:54;a:7:{s:2:"id";i:85;s:10:"disease_id";i:92;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:70:"Yoga and breathing exercises may improve stamina and overall wellness.";s:11:"overview_hi";N;}i:55;a:7:{s:2:"id";i:86;s:10:"disease_id";i:117;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:104:"Dietary management, antispasmodics, fiber supplementation, probiotics, and symptom-specific medications.";s:11:"overview_hi";N;}i:56;a:7:{s:2:"id";i:87;s:10:"disease_id";i:117;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:86:"Ayurvedic management may include Bilva, Kutaj, Musta, and digestive support therapies.";s:11:"overview_hi";N;}i:57;a:7:{s:2:"id";i:88;s:10:"disease_id";i:117;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:84:"Homeopathic remedies may be selected based on bowel pattern and associated symptoms.";s:11:"overview_hi";N;}i:58;a:7:{s:2:"id";i:89;s:10:"disease_id";i:117;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:63:"Acupressure may support digestive comfort and stress reduction.";s:11:"overview_hi";N;}i:59;a:7:{s:2:"id";i:90;s:10:"disease_id";i:117;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:78:"Yoga, breathing exercises, and relaxation techniques may help manage symptoms.";s:11:"overview_hi";N;}i:60;a:7:{s:2:"id";i:91;s:10:"disease_id";i:143;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:160:"Management may include blood pressure control, diabetes management, medications to protect kidney function, dialysis, and kidney transplantation when necessary.";s:11:"overview_hi";N;}i:61;a:7:{s:2:"id";i:92;s:10:"disease_id";i:143;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:116:"Ayurvedic management may include Punarnava, Gokshura, Varuna, and dietary regulation under professional supervision.";s:11:"overview_hi";N;}i:62;a:7:{s:2:"id";i:93;s:10:"disease_id";i:143;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:100:"Homeopathic remedies may be selected according to individual symptoms and kidney-related complaints.";s:11:"overview_hi";N;}i:63;a:7:{s:2:"id";i:94;s:10:"disease_id";i:143;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:88:"Acupressure may be used as supportive therapy for overall wellness and stress reduction.";s:11:"overview_hi";N;}i:64;a:7:{s:2:"id";i:95;s:10:"disease_id";i:143;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:85:"Gentle yoga and breathing exercises may support overall health and stress management.";s:11:"overview_hi";N;}i:65;a:7:{s:2:"id";i:96;s:10:"disease_id";i:200;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:143:"Treatment may include surgery, chemotherapy, radiation therapy, hormone therapy, targeted therapy, and immunotherapy depending on cancer stage.";s:11:"overview_hi";N;}i:66;a:7:{s:2:"id";i:97;s:10:"disease_id";i:200;s:19:"treatment_system_id";i:2;s:8:"title_en";s:18:"Ayurveda Treatment";s:8:"title_hi";s:46:"आयुर्वेदिक उपचार";s:11:"overview_en";s:116:"Ayurvedic care may be used as supportive therapy under professional supervision alongside standard cancer treatment.";s:11:"overview_hi";N;}i:67;a:7:{s:2:"id";i:98;s:10:"disease_id";i:200;s:19:"treatment_system_id";i:3;s:8:"title_en";s:20:"Homeopathy Treatment";s:8:"title_hi";s:49:"होम्योपैथिक उपचार";s:11:"overview_en";s:91:"Homeopathy may be used as supportive care and should not replace standard cancer treatment.";s:11:"overview_hi";N;}i:68;a:7:{s:2:"id";i:99;s:10:"disease_id";i:200;s:19:"treatment_system_id";i:4;s:8:"title_en";s:21:"Acupressure Treatment";s:8:"title_hi";s:49:"एक्यूप्रेशर उपचार";s:11:"overview_en";s:81:"Acupressure may help with stress management and quality of life during treatment.";s:11:"overview_hi";N;}i:69;a:7:{s:2:"id";i:100;s:10:"disease_id";i:200;s:19:"treatment_system_id";i:5;s:8:"title_en";s:12:"Yoga Therapy";s:8:"title_hi";s:34:"योग चिकित्सा";s:11:"overview_en";s:92:"Yoga may help improve mental well-being, flexibility, and treatment-related quality of life.";s:11:"overview_hi";N;}i:70;a:7:{s:2:"id";i:101;s:10:"disease_id";i:304;s:19:"treatment_system_id";i:1;s:8:"title_en";s:19:"Allopathy Treatment";s:8:"title_hi";s:40:"एलोपैथिक उपचार";s:11:"overview_en";s:137:"Treatment may include cognitive behavioral therapy (CBT), cou