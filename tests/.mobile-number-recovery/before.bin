  CONSTRAINT `fk_medicine_event_authority` FOREIGN KEY (`authority_grant_id`) REFERENCES `medicine_authority_grants` (`id`),
  CONSTRAINT `fk_medicine_event_grant` FOREIGN KEY (`grant_subject_id`) REFERENCES `medicine_authority_grants` (`id`),
  CONSTRAINT `fk_medicine_event_identity` FOREIGN KEY (`medicine_identity_id`) REFERENCES `kobi_medicine_identities` (`medicine_identity_id`),
  CONSTRAINT `fk_medicine_event_presentation` FOREIGN KEY (`medicine_presentation_id`) REFERENCES `kobi_medicine_presentations` (`medicine_presentation_id`),
  CONSTRAINT `fk_medicine_event_ref` FOREIGN KEY (`chemical_ref_id`) REFERENCES `kobi_medicine_chemical_refs` (`chemical_ref_id`),
  CONSTRAINT `chk_medicine_event_subject` CHECK ((`grant_subject_id` is not null) + (`chemical_ref_id` is not null) + (`medicine_identity_id` is not null) + (`medicine_presentation_id` is not null) = 1),
  CONSTRAINT `chk_medicine_event_action` CHECK (cast(`action` as char charset binary) in (cast('grant' as char charset binary),cast('revoke' as char charset binary),cast('assess' as char charset binary),cast('edit' as char charset binary),cast('verify' as char charset binary),cast('invalidate' as char charset binary),cast('retire' as char charset binary),cast('create' as char charset binary),cast('submit' as char charset binary),cast('reject' as char charset binary),cast('pilot_enroll' as char charset binary),cast('pilot_disable' as char charset binary))),
  CONSTRAINT `chk_medicine_event_state` CHECK (cast(`new_state` as char charset binary) in (cast('active' as char charset binary),cast('revoked' as char charset binary),cast('candidate' as char charset binary),cast('unresolved' as char charset binary),cast('verified' as char charset binary),cast('invalidated' as char charset binary),cast('withdrawn' as char charset binary),cast('superseded' as char charset binary),cast('retired' as char charset binary)) and (`previous_state` is null or cast(`previous_state` as char charset binary) in (cast('active' as char charset binary),cast('revoked' as char charset binary),cast('candidate' as char charset binary),cast('unresolved' as char charset binary),cast('verified' as char charset binary),cast('invalidated' as char charset binary),cast('withdrawn' as char charset binary),cast('superseded' as char charset binary),cast('retired' as char charset binary)))),
